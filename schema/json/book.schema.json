{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "book.schema.json",
  "title": "book-index Book 记录",
  "description": "说明见 schema/book.md。正式库另要求 revision、revised_at（check_schema.py 按库口径加）。",
  "type": "object",
  "required": [
    "id",
    "type",
    "schema_version",
    "title",
    "work_id"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "type": {
      "const": "book"
    },
    "schema_version": {
      "$ref": "common.schema.json#/$defs/SchemaVersion"
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/Revision"
    },
    "revised_at": {
      "$ref": "common.schema.json#/$defs/Date"
    },
    "ai_note": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "edition": {
      "type": "string",
      "minLength": 1
    },
    "edition_type": {
      "enum": [
        "刻本",
        "抄本",
        "稿本",
        "活字本",
        "石印本",
        "油印本",
        "曬印本",
        "鉛印本",
        "影印本",
        "套印本",
        "拓本",
        "印刷本",
        "其他"
      ]
    },
    "dating": {
      "$ref": "common.schema.json#/$defs/Dating"
    },
    "publication_info": {
      "type": "object",
      "properties": {
        "details": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contained_in": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "volume_index": {
            "type": [
              "integer",
              "string",
              "array"
            ],
            "items": {
              "type": "integer"
            }
          },
          "section": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "sub_items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "authors": {
      "$ref": "common.schema.json#/$defs/Authors"
    },
    "measures": {
      "$ref": "common.schema.json#/$defs/Measures"
    },
    "measure_info": {
      "type": "string",
      "not": {
        "anyOf": [
          {
            "pattern": "^[0-9０-９]+(（[^）]*）)?[卷篇冊册回種部集章]$"
          },
          {
            "pattern": "[一二三四五六七八九十百千萬][0０][一二三四五六七八九十]"
          }
        ]
      },
      "x-not-message": "卷数用汉字数字写（如「十卷」「一百零五卷」），不写阿拉伯数字，也不夹「０」"
    },
    "page_count": {
      "$ref": "common.schema.json#/$defs/PageCount"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "institution",
          "source"
        ],
        "properties": {
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "call_number": {
            "type": "string",
            "minLength": 1
          },
          "seals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "seal_marks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "seal_id"
              ],
              "properties": {
                "seal_id": {
                  "$ref": "common.schema.json#/$defs/Id"
                },
                "position": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "not": {
              "const": "src_manual"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "physical_description": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "leaf_style": {
          "type": "string"
        },
        "binding": {
          "type": "string"
        },
        "dimensions": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "leaf_style": {
              "minLength": 1
            }
          },
          "required": [
            "leaf_style"
          ]
        },
        {
          "properties": {
            "binding": {
              "minLength": 1
            }
          },
          "required": [
            "binding"
          ]
        },
        {
          "properties": {
            "dimensions": {
              "minLength": 1
            }
          },
          "required": [
            "dimensions"
          ]
        },
        {
          "properties": {
            "condition": {
              "minLength": 1
            }
          },
          "required": [
            "condition"
          ]
        }
      ]
    },
    "base_edition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "source"
        ],
        "properties": {
          "role": {
            "enum": [
              "底本",
              "配補",
              "參校"
            ]
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "book_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "work_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "hypothetical_id": {
            "type": "string",
            "pattern": "^h_"
          },
          "confidence": {
            "enum": [
              "certain",
              "consensus",
              "probable",
              "disputed"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "book_id"
            ]
          },
          {
            "required": [
              "work_id"
            ]
          },
          {
            "required": [
              "hypothetical_id"
            ]
          }
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "book_id",
                "work_id"
              ]
            },
            {
              "required": [
                "book_id",
                "hypothetical_id"
              ]
            },
            {
              "required": [
                "work_id",
                "hypothetical_id"
              ]
            }
          ]
        },
        "x-not-message": "book_id、work_id、hypothetical_id 至多填一项；三者都没有时 name 必填"
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "extant",
            "fragment",
            "lost"
          ]
        },
        "extant_juan": {
          "type": "string"
        },
        "alias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "location_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "acckey": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "attached_texts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "book_title"
        ],
        "properties": {
          "book_title": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "description": {
      "$ref": "common.schema.json#/$defs/Description"
    },
    "additional_titles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "indexed_by": {
      "$ref": "common.schema.json#/$defs/IndexEntries"
    },
    "resources": {
      "$ref": "common.schema.json#/$defs/Resources"
    },
    "resource_groups": {
      "$ref": "common.schema.json#/$defs/ResourceGroups"
    },
    "related_books": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "book_id"
        ],
        "properties": {
          "book_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": [
              "certain",
              "consensus",
              "probable",
              "disputed"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "zhsy_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Source"
      }
    },
    "merged_into": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "merged_basis": {
      "$ref": "common.schema.json#/$defs/MergedBasis"
    },
    "_has_text": {
      "type": "boolean",
      "x-legacy": true
    },
    "_has_collated": {
      "type": "boolean",
      "x-legacy": true
    }
  },
  "patternProperties": {
    "^_(?!has_text$|has_collated$)": {
      "not": {},
      "x-not-message": "源档不写 `_` 起首字段（派生字段只在 _build/ 里）"
    }
  },
  "additionalProperties": false
}
