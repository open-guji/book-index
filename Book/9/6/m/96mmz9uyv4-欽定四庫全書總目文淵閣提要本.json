  "publication_info": {
    "year": "清乾隆四十六年至五十二年（1781-1787）",
    "year_iso": "1782",
    "place": "武英殿",
    "publisher": "（內府繕寫）",
    "details": "文淵閣本《四庫全書》各書冠以提要，文字早於後來定本《總目》。1986 年臺灣商務印書館景印文淵閣四庫全書 1500 冊精裝本中，每書提要保留原貌，是研究《總目》提要早期形態的核心一手材料。"
  },
  "current_location": {
    "name": "臺灣國立故宮博物院（隨文淵閣本一同遷臺）"
  },
