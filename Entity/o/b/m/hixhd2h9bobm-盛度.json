          "source_bid": "d59f2gonq7sy",
          "details": "試學士院，為直史館、三司戶部判官，累遷尚書屯田員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfr",
      "text": "尚書屯田員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "試學士院，為直史館、三司戶部判官，累遷尚書屯田員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpub",
      "text": "開封府判官",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改開封府判官，坐決獄失實，降監洪州稅。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起知建昌軍、三司鹽鐵判官，改起居舍人、知制誥。"
        }
      ]
    },
    {
      "office_id": "hixia8newkcg",
      "text": "史館修撰",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以疾不拜，改會靈觀判官，入翰林為學士，加史館修撰。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfn",
      "text": "兵部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁謂貶，起為祠部郎中，復兵部郎中，遷太常少卿、知筠州，更虔、滁、蘇三州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁謂貶，起為祠部郎中，復兵部郎中，遷太常少卿、知筠州，更虔、滁、蘇三州。"
        }
      ]
    },
    {
      "office_id": "hixia8mzx69t",
      "text": "集賢院學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還知審刑院，以右諫議大夫知揚州，加集賢院學士。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·盛度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為翰林學士、史館修撰，遷給事中。"
        }
      ]
    },
    {
