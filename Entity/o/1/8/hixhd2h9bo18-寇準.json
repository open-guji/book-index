  "offices": [
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "start": 995,
      "end": 995,
      "date_text": "至道元年",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至道元年，加給事中。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "尚書工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，遷尚書工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8osjaps",
      "text": "知開封府",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝幸大名，詔赴行在所，遷刑部，權知開封府。"
        }
      ]
    },
    {
      "office_id": "hixia8m9p8n6",
      "text": "三司使",
      "start": 1003,
      "end": 1003,
      "date_text": "六年",
      "basis": "承上文年號咸平",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "六年，遷兵部，為三司使。"
        }
      ]
    },
    {
      "office_id": "hixia8m69mo3",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，加中書侍郎兼工部尚書。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpud",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從封泰山，遷戶部尚書、知天雄軍。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "祀汾陰，命提舉貝、德、博、洺、濱、棣巡檢捉賊公事，遷兵部尚書，入判都省。"
        }
      ]
    },
    {
      "office_id": "hixia8m69mo3",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂拜中書侍郎兼吏部尚書、同平章事、景靈宮使。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "尚書右僕射",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，祀南郊，進尚書右僕射、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixia8nk7lkz",
      "text": "太子太傅",
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "準歿後十一年，復太子太傅，贈中書令、萊國公，後又賜諡曰忠愍。"
        }
      ]
    },
    {
      "office_id": "hixia8ojheyp",
      "text": "中書令",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十一·寇準傳",
