  "description": {
    "text": "宋城人。第進士。富弼使遼，誓書有所更易，遣挺還白；范仲淹奏通判涇州；知慶州、渭州，治邊有方，置涇原勇敢、教閱陣法；神宗時拜樞密副使。",
    "sources": [
      {
        "name": "《宋史·蔡挺傳》",
        "details": "卷328"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o5qz2b",
      "text": "知博州",
      "place_id": "hixicl84waxs",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·蔡挺傳",
          "source_bid": "d59f2gonq7sy",
          "details": "河北多盜，精擇諸郡守，以挺知博州。"
        }
      ]
    },
    {
      "office_id": "hixia8mcidj4",
      "text": "直龍圖閣",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·蔡挺傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改陝西轉運副使，進直龍圖閣、知慶州，因上書論攻守大計。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
