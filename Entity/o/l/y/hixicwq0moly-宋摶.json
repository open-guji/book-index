  "description": {
    "text": "萊州掖人。治《毛詩》，開寶八年及第。為河東轉運使凡十一年，請權罷大通監採鐵、科丁壯為兵，經制漕運以幹治稱；景德四年為戶部副使；大中祥符初使契丹，會疾，契丹主以車迎之。",
    "sources": [
      {
        "name": "《宋史·宋摶傳》",
        "details": "卷307"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximxfukl59",
      "text": "右贊善大夫",
      "sources": [
        {
          "title": "《宋史》卷三百〇七·宋摶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "膳部員外郎鞠礪薦其能，遷右贊善大夫、知利豐監，徙知藤州。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷三百〇七·宋摶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改殿中丞、通判洪州。"
        }
      ]
    },
    {
      "office_id": "hixia8omx0xs",
      "text": "國子博士",
      "sources": [
        {
          "title": "《宋史》卷三百〇七·宋摶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷國子博士、通判西京留守司，得對便坐，賜錢三十萬。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "江南轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百〇七·宋摶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，徙江南轉運使，就遷度支員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg6",
      "text": "司封員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百〇七·宋摶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗嗣位，遷司封員外郎、河東轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyx",
      "text": "戶部副使",
      "start": 1007,
      "end": 1007,
      "date_text": "景德四年",
      "sources": [
        {
          "title": "《宋史》卷三百〇七·宋摶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德四年，入判三司勾院，逾月，為戶部副使。"
        }
      ]
    }
  ],
