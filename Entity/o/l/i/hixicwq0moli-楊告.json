  "period_basis": "據 dynasty「北宋」歸併",
  "title_or_office": "右諫議大夫",
  "description": {
    "text": "其先漢州綿竹人，父允恭西京左藏庫使。為趙元昊旌節官告使，元昊專席自尊，告徙坐賓位不屈；京西歲饑發廩並募富室出粟；歷制置發運使、三司副使，拜右諫議大夫，知鄭州、江寧府、壽州。",
    "sources": [
      {
        "name": "《宋史·楊告傳》",
        "details": "卷304"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5uk9r9cf",
      "text": "大理寺丞",
      "sources": [
        {
          "title": "《宋史》卷三百零四·楊告傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再調南劍州判官，知南安、六合、錢塘、寧國縣，改大理寺丞、通判江寧州。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "京西轉運副使",
      "sources": [
        {
          "title": "《宋史》卷三百零四·楊告傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除京西轉運副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "淮南轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百零四·楊告傳",
          "source_bid": "d59f2gonq7sy",
          "details": "頃之，判三司憑由、理欠司，為淮南轉運使，徙製置發運使，除三司戶部副使，更度支，安撫河東，改鹽鐵副使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百零四·楊告傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜右諫議大夫、知鄭州，徙江寧府、壽州。"
        }
      ]
    }
  ],
