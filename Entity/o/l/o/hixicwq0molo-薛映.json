  "description": {
    "text": "唐中書令薛元超八世孫，家於蜀，父允中事孟氏。進士及第，以右諫議大夫知杭州，奏徒流罪對辨無異聽長吏遣決，與轉運使姚鉉不協而發其私；累官工部尚書兼御史中丞，仁宗即位遷禮部，分司南京卒，贈右僕射。",
    "sources": [
      {
        "name": "《宋史·薛映傳》",
        "details": "卷305"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "映進士及第，授大理評事，歷通判綿、宋、昇州，累遷太常丞。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "映進士及第，授大理評事，歷通判綿、宋、昇州，累遷太常丞。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "左正言",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太宗召對，為江南轉運使，改左正言、直昭文館，為江、淮、兩浙茶鹽制置副使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知相州",
      "place_id": "hixicl84waz2",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "求便親，知相州。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再領漕京東，積遷尚書禮部郎中，擢知制誥，權判吏部流內銓兼制置群牧使。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "封泰山，為東京留守判官，遷給事中、勾當三班院，出知河南府。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷尚書工部侍郎、集賢院學士、判尚書都省，進樞密直學士、知昇州。"
        }
      ]
    },
    {
      "office_id": "hixia8mzx69t",
      "text": "集賢院學士",
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷禮部，再為集賢院學士、判院事、知曹州，分司南京。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百零五·薛映傳",
          "source_bid": "d59f2gonq7sy",
          "details": "卒，贈右僕射，諡文恭。"
        }
      ]
    }
  ],
