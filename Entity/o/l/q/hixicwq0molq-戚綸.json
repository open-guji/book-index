    }
  ],
  "dynasty": "北宋",
  "dynasty_basis": "據正史本傳",
  "native_place": "楚丘",
  "native_place_basis": "據《宋史·戚綸傳》卷306傳首「應天楚丘人」",
  "period": "song",
  "period_basis": "據 dynasty「北宋」歸併",
  "title_or_office": "樞密直學士",
  "dates": {
    "birth": 954,
    "death": 1021,
    "basis": "據本傳：天禧五年卒，年六十八"
  },
  "description": {
    "text": "戚同文之子。太平興國八年進士，知太和縣作《諭民詩》五十篇；著《理道評》；真宗時為秘閣校理、龍圖閣待制，大中祥符中參修禮文，擢樞密直學士；忤胡則、李溥，又以戲謔語及寇準被奏，左遷岳州團練副使。有集二十卷、《論思集》十卷。",
    "sources": [
      {
        "name": "《宋史·戚綸傳》",
        "details": "卷306"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaw4ktfm",
      "text": "光祿丞",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷光祿丞，坐鞫獄陳州失實，免官。"
        }
      ]
    },
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，復授大理評事、知永嘉縣，境有陂塘之利，浚治以備水旱。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfm",
      "text": "光祿寺丞",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為光祿寺丞，轉運使又上其政績，連詔褒之。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyy",
      "text": "鹽鐵判官",
      "start": 1004,
      "end": 1004,
      "date_text": "景德元年",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德元年，判三司開拆，賜緋魚，改鹽鐵判官。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "十月，拜右正言、龍圖閣待制，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfo",
      "text": "戶部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "禮成，遷戶部郎中、直昭文館，待制如故。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32n",
      "text": "集賢殿修撰",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會峻待制之秩，又兼集賢殿修撰。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，擢樞密直學士，上作詩寵之。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年，與劉綜並罷學士，授左諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知青州",
      "place_id": "hixicl84l2e5",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "代還，復知青州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷三百〇六·戚綸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "是冬，以疾求歸故里，改太常少卿，分司南京。"
        }
      ]
    }
  ],
