  "native_place": "徐州彭城",
  "native_place_basis": "《宋史》卷304本傳著錄「徐州彭城人」",
  "title_or_office": "龍圖閣直學士",
  "description": {
    "text": "徐州彭城人。舉進士，審閬州獄活死囚七人；詣渭州劾尹洙私用公使錢，頗傅致重法；鑿河陰新渠通漕；知廣州於儂智高平後練兵設鐵鎖斷江；遷龍圖閣直學士、知慶州，改知密州卒。少賤，母更嫁營卒，既登第具袍笏迎母。",
    "sources": [
      {
        "name": "《宋史·劉湜傳》",
        "details": "卷304"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpu5",
      "text": "秘書省著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士，為澶州觀察推官，再調湖南節度推官，改秘書省著作佐郎、知益都縣，徙陰平。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷太常博士、通判劍州。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜監察御史，王德用自隨州詔還，近臣言其有反相，湜保右之。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "曆開封府推官、三司鹽鐵判官，遷殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyv",
      "text": "鹽鐵副使",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，為尚書禮部員外郎兼侍御史知雜事，同判吏部流內銓，除鹽鐵副使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuf",
      "text": "戶部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起為河東轉運使，遷戶部員外郎，復為鹽鐵副使兼領河渠事。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyv",
      "text": "鹽鐵副使",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起為河東轉運使，遷戶部員外郎，復為鹽鐵副使兼領河渠事。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會江南饑，擢天章閣待制、知江寧府，奏運蘇州米五十萬斛，以貸饑民。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfo",
      "text": "戶部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除戶部郎中、知廣州。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百零四·劉湜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又以左司郎中知鄆州，遷龍圖閣直學士、知慶州。"
        }
      ]
    }
  ],
