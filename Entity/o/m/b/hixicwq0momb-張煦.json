  "description": {
    "text": "開封人。雍熙二年為殿前承旨。咸平中王均亂蜀，與雷有終攻成都主東砦；副曹利用為廣東西路安撫使，平宜州盧均之亂；歷知懷、曹、滄、鄜州，天禧三年拜西上閤門使。明術數，善相宅。",
    "sources": [
      {
        "name": "《宋史·張煦傳》",
        "details": "卷308"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3lf",
      "text": "供備庫副使",
      "sources": [
        {
          "title": "《宋史》卷三百零八·張煦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "代還，拜供備庫副使，權知環州。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知環州",
      "place_id": "hixicl857jg2",
      "start": 1004,
      "end": 1004,
      "date_text": "景德元年",
      "sources": [
        {
          "title": "《宋史》卷三百零八·張煦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德元年，加領賀州刺史，復為涇原儀渭鎮戎軍鈐轄，再知環州。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l0",
      "text": "如京使",
      "sources": [
        {
          "title": "《宋史》卷三百零八·張煦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賊平，改如京使，知懷州。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知懷州",
      "place_id": "hixicl84wazs",
