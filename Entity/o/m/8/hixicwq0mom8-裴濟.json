  "description": {
    "text": "絳州聞喜人，唐相裴耀卿八世孫。少事晉邸。知定州逆擊契丹於徐河，又與李繼隆擊賊於唐河；在鎮、定凡十五年；咸平初以順州團練使知靈州兼都部署，夏人斷餉道，刺指血染奏求救，兵不至，城陷死之，贈鎮江軍節度。",
    "sources": [
      {
        "name": "《宋史·裴濟傳》",
        "details": "卷308"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3l3",
      "text": "崇儀副使",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國末，江表盜起，命為巡檢，遷崇儀副使。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l2",
      "text": "崇儀使",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，遷崇儀使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl5u",
      "text": "西上閤門使",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太宗嘉之，遷西上閤門使、定州都監，就加行營鈐轄，尋知定州。"
        }
      ]
    },
    {
      "office_id": "hixigfk59xc0",
      "text": "四方館使",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改四方館使，復知定州，徙天雄軍鈐轄。"
        }
      ]
    },
    {
      "office_id": "hixigfk4ng8w",
      "text": "客省使",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷客省使，復知定州。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl61",
      "text": "內客省使",
      "start": 996,
      "end": 996,
      "date_text": "至道二年",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至道二年，改內客省使、知鎮州。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷三百〇八·裴濟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "麗正子德輿，為殿中丞。"
        }
      ]
    }
  ],
