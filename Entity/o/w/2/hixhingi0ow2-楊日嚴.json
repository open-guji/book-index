      "sources": [
        {
          "title": "《宋史》卷三百零一·楊日嚴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "使契丹還，為兩浙轉運副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "京東轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百零一·楊日嚴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未行，會青、徐饑，改京東轉運使。"
        }
