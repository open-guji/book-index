      "sources": [
        {
          "title": "《宋史》卷三百零一·楊日嚴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進士及第，試秘書省校書郎、知安丘縣。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cf",
      "text": "大理寺丞",
      "sources": [
        {
          "title": "《宋史》卷三百零一·楊日嚴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三司辟為檢法官，遷大理寺丞，又為本寺檢法官，監都進奏院，通判亳、陳二州，判吏部南曹兼登聞鼓院。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpub",
      "text": "開封府判官",
      "sources": [
        {
          "title": "《宋史》卷三百零一·楊日嚴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "出知襄州，徙廬、鄲二州，入為開封府判官。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "兩浙轉運副使",
