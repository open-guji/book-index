  "title_or_office": "治書侍御史",
  "description": {
    "text": "蒙古人。英宗時由速古兒赤擢監察御史，錄囚辨冤；泰定中劾參知政事楊庭玉贓罪、平章政事禿滿迭兒預弒英宗之謀；後為治書侍御史，鞫寧夏誣告伯顏案，忤伯顏，左遷同知徽政院事。歷事四朝，剛介弗回。",
    "sources": [
      {
        "name": "《元史·自當傳》",
        "details": "卷143"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximde33x8n",
      "text": "工部員外郎",
      "sources": [
        {
          "title": "《元史》卷一百四十三·自當傳",
          "source_bid": "d59f2njivtog",
          "details": "改工部員外郎，中書省委開混河，自當往視之，以為水性不常，民力亦瘁，難以成功，言于朝，河役乃罷。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknya",
      "text": "吏部員外郎",
      "sources": [
        {
          "title": "《元史》卷一百四十三·自當傳",
          "source_bid": "d59f2njivtog",
          "details": "特賜上尊、金幣，遷吏部員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknyq",
      "text": "中書左司郎中",
      "sources": [
        {
          "title": "《元史》卷一百四十三·自當傳",
          "source_bid": "d59f2njivtog",
          "details": "文宗即位，除中書左司郎中。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknys",
      "text": "治書侍御史",
      "sources": [
        {
          "title": "《元史》卷一百四十三·自當傳",
          "source_bid": "d59f2njivtog",
          "details": "拜治書侍御史。"
        }
      ]
    }
  ],
