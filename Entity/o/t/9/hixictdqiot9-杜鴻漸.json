        "name": "《新唐書·列傳第五十一》",
        "details": "卷126"
      },
      {
        "name": "《舊唐書·列傳第五十八》",
        "details": "卷108"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfedch23",
      "text": "大理司直",
      "sources": [
        {
          "title": "《舊唐書》卷一百零八·杜鴻漸傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "天寶末，累遷大理司直，朔方留後、支度副使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3er",
      "text": "御史大夫",
      "kind": "兼",
      "start": 757,
      "end": 757,
      "date_text": "至德二年",
      "sources": [
        {
          "title": "《舊唐書》卷一百零八·杜鴻漸傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "至德二年，兼御史大夫，為河西節度使、涼州都督。"
        }
      ]
    },
    {
      "office_id": "hixikfedcgzl",
      "text": "光祿大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百零八·杜鴻漸傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "二聖晏駕，鴻漸監護儀制，山陵畢，加光祿大夫，封衛國公。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqiq",
      "text": "太尉",
      "posthumous": true,
      "sources": [
