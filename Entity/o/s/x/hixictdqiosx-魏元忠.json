  "description": {
    "text": "宋州宋城人。從江融習兵術，高宗、武后時以論兵事進，歷御史中丞、鳳閣侍郎同平章事；中宗朝為中書令、侍中，封齊國公；坐節愍太子之難貶務川尉，至涪陵卒，開元六年諡貞。",
    "sources": [
      {
        "name": "《新唐書·列傳第四十七》",
        "details": "卷122"
      },
      {
        "name": "《舊唐書·列傳第四十二》",
        "details": "卷92"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nkiu4h",
      "text": "秘書省正字",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "帝甚歎異之，授秘書省正字，令直中書省，仗内供奉。"
        }
      ]
    },
    {
      "office_id": "hixi5v2mknb6",
      "text": "監察御史",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋除監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8pgvt35",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "文明年，遷殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "復還，授御史中丞。"
        }
      ]
    },
    {
      "office_id": "hiximxcec54y",
      "text": "檢校太子左庶子",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "中宗在春宮時，元忠檢校太子左庶子。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g9",
      "text": "兵部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "旬日，又遷兵部尚書，知政事如故。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiq",
      "text": "中書令",
      "sources": [
        {
          "title": "《舊唐書》卷九十二·魏元忠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "未幾，遷中書令，加授光祿大夫，累封齊國公，監修國史。"
        }
      ]
    },
    {
      "office_id": "hixia8nkiu4h",
      "text": "祕書省正字",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "高宗善之，授祕書省正字，直中書省，仗內供奉。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "歲餘，為御史中丞，復為來俊臣所構。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "鳳閣侍郎",
      "start": 699,
      "end": 699,
      "date_text": "聖曆二年",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "苟須臣肉為之羹耳，彼將殺臣以求進，臣顧何辜？」\n\n聖曆二年，為鳳閣侍郎、同鳳閣鸞臺平章事，俄檢校并州長史、天兵軍大總管，以備突厥。"
        }
      ]
    },
    {
      "office_id": "hiximxcec54y",
      "text": "檢校左庶子",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "中宗在東宮，為檢校左庶子。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g9",
      "text": "兵部尚書",
      "start": 706,
      "end": 706,
      "date_text": "神龍二年",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "神龍二年，為尚書右僕射，知兵部尚書，當朝用事，羣臣莫敢望。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiz",
      "text": "侍中",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "不閱旬，遷兵部尚書，進侍中。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiq",
      "text": "中書令",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "武后崩，帝居喪，軍國事委元忠裁可，拜中書令，封齊國公。"
        }
      ]
    },
    {
      "office_id": "hixikfedch26",
      "text": "尚書右僕射",
      "start": 706,
      "end": 706,
      "date_text": "神龍二年",
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "神龍二年，為尚書右僕射，知兵部尚書，當朝用事，羣臣莫敢望。"
        }
      ]
    },
    {
      "office_id": "hixia8oehm9t",
      "text": "尚書左僕射",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百二十二·魏元忠傳",
          "source_bid": "d59f2htqolj5",
          "details": "景龍四年，贈尚書左僕射、齊國公、本州刺史。"
        }
      ]
    }
  ],
