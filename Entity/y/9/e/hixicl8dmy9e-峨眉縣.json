  "description": {
    "sources": [
      {
        "name": "《明史》卷四十三〈地理志四〉",
        "details": "嘉定州「峨眉州西。西南有峨眉山，有大峨、中峨、小峨，羅目江出焉。陽江在縣南，自黎州所夷界流入，與羅目江合。又西南有中鎮巡檢司，後徙治大圍山。又有土地關，接蠻界。」"
      },
      {
        "name": "《隋書》卷二十九〈地理志上〉",
        "details": "眉山郡「峨眉。開皇十三年置。有峨眉山、綏山。」起年據「開皇十三年置」"
      },
      {
        "name": "《新唐書》卷四十二〈地理志六〉",
        "details": "嘉州「峨眉，上。有金，有鐵。」"
      },
      {
        "name": "《宋史》卷八十九〈地理志五〉",
        "details": "嘉定府「峨眉，中。」"
      },
      {
        "name": "《元史》卷六十〈地理志三〉",
        "details": "嘉定府路「峨眉，（下。）。」"
      }
    ]
  },
