        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "鄂州刺史",
      "place_id": "hixicl83ncsp",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十五·穆寧傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "選鎮夏口者，詔以寧為鄂州刺史、鄂嶽沔都團練使，及淮西鄂嶽租庸鹽鐵沿江轉運使，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "和州刺史",
      "kind": "兼",
      "place_id": "hixicl8d0h1e",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十五·穆寧傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "明年，拜檢校秘書少監，兼和州刺史，理有善政。"
        }
      ]
    },
    {
      "office_id": "hixia8pv8q2o",
