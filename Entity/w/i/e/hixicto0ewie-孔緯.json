  },
  "description": {
    "text": "孔遵孺之子，孔戣之孫。進士及第，歷翰林學士、御史中丞；僖宗幸興元時為相，昭宗時加司空，主討李克用，兵敗貶均州刺史；後復相，不肯服藥卒，贈太尉。",
    "sources": [
      {
        "name": "《新唐書·列傳第八十八》",
        "details": "卷163"
      },
      {
        "name": "《舊唐書·列傳第一百二十九》",
        "details": "卷179"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximx0vszcz",
      "text": "考功員外郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "宰相徐商奏兼集賢直學士，改考功員外郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g6",
      "text": "戸部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "正拜中書舍人，累遷戸部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "乾符中，罷學士，出爲御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixia8ml90qo",
      "text": "太常卿",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "執政怒之，改太常卿。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gb",
      "text": "刑部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "黃巢之亂，從僖宗幸蜀，改刑部尚書，判戸部事。"
        }
      ]
    },
    {
      "office_id": "hixia8pa0l4x",
      "text": "太子少保",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "至是，因戸部取給不充，移之散秩，改太子少保。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ga",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "微緯之言幾危矣！\n\n至褒中，改兵部侍郎、同中書門下平章事，尋改中書侍郎、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "微緯之言幾危矣！\n\n至褒中，改兵部侍郎、同中書門下平章事，尋改中書侍郎、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g0",
      "text": "吏部尚書",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十九·孔緯傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "從駕還京，駐蹕岐陽，進階特進，兼吏部尚書，領諸道鹽鐵轉運使。"
        }
      ]
    }
  ],
