  "native_place_basis": "《宋史》卷350本傳著錄「麟州新秦人」",
  "title_or_office": "冀州觀察使",
  "description": {
    "text": "麟州新秦人。為府州巡檢，韓琦薦其材；熙寧討夏敗之吐渾河；勸神宗招納生羌；李憲討靈武得羌戶萬餘；夏人圍蘭州，募死士夜縋擊退，知蘭州守城九日；築安西城、金城關，進秦州防禦、冀州觀察使，卒年六十六。",
    "sources": [
      {
        "name": "《宋史·王文郁傳》",
        "details": "卷350"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximxfukl5x",
      "text": "通事舍人",
      "sources": [
        {
          "title": "《宋史》卷三百五十·王文郁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷通事舍人。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3kg",
      "text": "左騏驥副使",
      "sources": [
        {
          "title": "《宋史》卷三百五十·王文郁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知鎮戎、德順軍，預定洮、河，遷左騏驥副使、知麟州。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl5t",
      "text": "東上閣門使",
      "sources": [
        {
          "title": "《宋史》卷三百五十·王文郁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢東上閣門使、知蘭州。"
        }
      ]
    },
    {
      "office_id": "hixia8of43d0",
      "text": "榮州團練使",
      "place_id": "hixicl85u0ob",
      "sources": [
        {
          "title": "《宋史》卷三百五十·王文郁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "諜知夏人將大入，清野以俟，果舉國趨皋蘭，文鬱乘城禦之，殺傷如積，圍九日而解，收其屍為京觀，加榮州團練使，以捧日、天武都指揮使為副都總管，以殿前都虞候知河州。"
        }
      ]
    }
  ],
