  "primary_name": "也罕的斤",
  "dynasty": "元",
  "dynasty_basis": "據正史本傳",
  "period": "liao-jin-yuan",
  "period_basis": "據 dynasty「元」歸併",
  "title_or_office": "四川行樞密副使",
  "description": {
    "text": "匣剌魯人，祖匣答兒密立率哈剌魯軍來歸。中統二年為千戶，戍眉州，從圍嘉定、重慶、瀘州；後從諸王相吾答兒征緬，拔江頭城；改四川行樞密副使，卒。",
    "sources": [
      {
        "name": "《元史·也罕的斤傳》",
        "details": "卷133"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximwvsknxn",
      "text": "昭勇大將軍",
      "sources": [
        {
          "title": "《元史》卷一百三十三·也罕的斤傳",
          "source_bid": "d59f2njivtog",
          "details": "十二年，入朝，賜對衣、玉束帶、白金百兩，加昭勇大將軍、上萬戶，益兵萬人。"
        }
      ]
    },
    {
      "office_id": "hiximde33x9h",
      "text": "昭毅大將軍",
      "sources": [
        {
          "title": "《元史》卷一百三十三·也罕的斤傳",
          "source_bid": "d59f2njivtog",
          "details": "重慶既平，復將其眾，略地思州，得降將百餘人，加昭毅大將軍。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknxk",
      "text": "奉國上將軍",
      "sources": [
        {
          "title": "《元史》卷一百三十三·也罕的斤傳",
          "source_bid": "d59f2njivtog",
          "details": "進奉國上將軍、四川宣慰使、都元帥。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9erl",
      "text": "雲南行省參知政事",
      "sources": [
        {
          "title": "《元史》卷一百三十三·也罕的斤傳",
          "source_bid": "d59f2njivtog",
          "details": "十七年，征斡端，拜雲南行省參知政事。"
        }
      ]
    }
  ],
