  "title_or_office": "寧夏總兵官",
  "description": {
    "text": "延綏人，讀書能文辭，中武會試。嘉靖中為延綏副總兵，十一年代周尚文為寧夏總兵官，與梁震屢敗吉囊；後鎮陝西、宣府，卒，謚武襄。",
    "sources": [
      {
        "name": "《明史·王效傳》",
        "details": "卷211"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixic9fkl8aq",
      "text": "都指揮僉事",
      "sources": [
        {
          "title": "《明史》卷二百一十一·王效傳",
          "source_bid": "d59f2mc8bta8",
          "details": "嘉靖中，累官都指揮僉事，充延綏右參將。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8az",
      "text": "總兵官",
      "kind": "充",
      "sources": [
        {
          "title": "《明史》卷二百一十一·王效傳",
          "source_bid": "d59f2mc8bta8",
          "details": "十一年冬，進署都督僉事，充總兵官，代周尚文鎮寧夏。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8am",
      "text": "都督同知",
      "sources": [
        {
          "title": "《明史》卷二百一十一·王效傳",
          "source_bid": "d59f2mc8bta8",
          "details": "御史周鈇以為言，龍、效、震各加一級，效進都督同知。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8al",
      "text": "右都督",
      "sources": [
        {
          "title": "《明史》卷二百一十一·王效傳",
          "source_bid": "d59f2mc8bta8",
          "details": "尋以清水營功，進右都督。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8ak",
      "text": "左都督",
      "sources": [
        {
          "title": "《明史》卷二百一十一·王效傳",
          "source_bid": "d59f2mc8bta8",
          "details": "捷聞，進左都督。"
        }
      ]
    }
  ],
