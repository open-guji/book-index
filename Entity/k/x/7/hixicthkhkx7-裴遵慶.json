        "name": "《新唐書·列傳第六十五》",
        "details": "卷140"
      },
      {
        "name": "《舊唐書·列傳第六十三》",
        "details": "卷113"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8prhvk1",
      "text": "大理寺丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十三·裴遵慶傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "隨調吏部，授大理寺丞，剖斷刑獄，舉正綱條，理行始著。"
        }
      ]
    },
    {
      "office_id": "hixia8pg9c01",
      "text": "太子少傅",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十三·裴遵慶傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "及乘輿還京，以遵慶為太子少傅。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g0",
      "text": "吏部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十三·裴遵慶傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋改吏部尚書、右僕射，復知選事。"
        }
      ]
    }
  ],
