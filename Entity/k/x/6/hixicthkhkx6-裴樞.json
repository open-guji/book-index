  "description": {
    "text": "裴遵慶之曾孫。咸通中進士，與朱全忠結納；昭宗天復中拜相，後為朱全忠所忌，天祐二年白馬驛之禍，與獨孤損、崔遠等被殺，投屍於河。",
    "sources": [
      {
        "name": "《新唐書·列傳第六十五》",
        "details": "卷140"
      },
      {
        "title": "《山西通志》卷133·人物",
        "source_bid": "d59f2mdb18n5",
        "details": "裴樞字紀聖寅子咸通中第進士杜審權鎭河中奏署幕府再遷藍田尉宰相王鐸知之遂直□文館入蜀擢殿中侍御史中和初鐸為都統表署鄭滑掌書記龍紀初進給事中改京兆尹雅善孔緯改右庶子……"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8pgvt35",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·裴樞傳",
          "source_bid": "d59f2htqolj5",
          "details": "從僖宗入蜀，擢殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9es3",
      "text": "給事中",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·裴樞傳",
          "source_bid": "d59f2htqolj5",
          "details": "龍紀初，進給事中，改京兆尹。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "歙州刺史",
      "place_id": "hixicl83ncry",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·裴樞傳",
          "source_bid": "d59f2htqolj5",
          "details": "與孔緯厚善，緯以罪貶，故樞改右庶子，出為歙州刺史。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ga",
      "text": "兵部侍郎",
      "sources": [
