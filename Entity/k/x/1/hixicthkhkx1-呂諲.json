  "title_or_office": "黃門侍郎、同中書門下平章事",
  "dates": {
    "birth": 712,
    "death": 762,
    "basis": "據《新唐書》本傳"
  },
  "description": {
    "text": "河中河東人。進士及第，為哥舒翰支度判官；肅宗即位後為御史中丞，乾元二年同平章事；後為荊南節度使，治有聲；卒，有司議諡，以前代宰相諡多一字為例。",
    "sources": [
      {
        "name": "《新唐書·列傳第六十五》",
        "details": "卷140"
      },
      {
        "name": "《舊唐書·列傳第一百三十五下》",
        "details": "卷185下"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximd4offvw",
      "text": "虞部員外郎",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "諲性謹守，勤於吏職，雖同僚追賞，而塊然視事，不離案簿，翰益親之，累兼虞部員外郎、侍御史。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gf",
      "text": "黃門侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十月，起復授本官，兼充度支使，遷黃門侍郎。"
        }
      ]
    },
    {
      "office_id": "hixigfkcgdts",
      "text": "同中書門下三品",
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "上元元年正月，加同中書門下三品，賜門戟。"
        }
      ]
    },
    {
      "office_id": "hixikfedcgzn",
      "text": "銀青光祿大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "累加銀青光祿大夫，東平男。"
        }
      ]
    },
    {
      "office_id": "hixia8olo2rk",
      "text": "侍御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "及諲至，奏追希昂赴上都，除侍御史，出為常州刺史、本州防禦使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "常州刺史",
      "place_id": "hixicl8d0h33",
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "及諲至，奏追希昂赴上都，除侍御史，出為常州刺史、本州防禦使。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g0",
      "text": "吏部尚書",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百八十五·呂諲傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "諲素羸疾，元年建卯月卒，贈吏部尚書，有司謚曰肅。"
        }
      ]
    },
    {
      "office_id": "hixia8pgvt35",
      "text": "殿中侍御史",
      "kind": "兼",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·呂諲傳",
          "source_bid": "d59f2htqolj5",
          "details": "累兼殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·呂諲傳",
          "source_bid": "d59f2htqolj5",
          "details": "翰敗潼關，諲西趨靈武，由中人尉薦，肅宗才之，拜御史中丞，所陳事無不順納。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gf",
      "text": "黃門侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·呂諲傳",
          "source_bid": "d59f2htqolj5",
          "details": "累封須昌縣伯，遷黃門侍郎。"
        }
      ]
    },
    {
      "office_id": "hixigfkcgdts",
      "text": "同中書門下三品",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·呂諲傳",
          "source_bid": "d59f2htqolj5",
          "details": "上元初，加同中書門下三品，當賜門戟，或勸諲以兇服受吉賜不宜，諲釋缞拜賜，人譏其失禮。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "常州刺史",
      "place_id": "hixicl8d0h33",
      "sources": [
        {
          "title": "《新唐書》卷一百四十·呂諲傳",
          "source_bid": "d59f2htqolj5",
          "details": "，斬其首以謝，悉以遂金兵屬之，乃退，自是政一出希昂，後入朝，遷常州刺史，過江陵入謁，諲伏甲擊殺之，誅黨偶數十人，積屍府門，內外震服"
        }
      ]
    },
    {
      "office_id": "hixikfed18g0",
      "text": "吏部尚書",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百四十·呂諲傳",
          "source_bid": "d59f2htqolj5",
          "details": "諲苦羸疾，卒，年五十一，贈吏部尚書。"
        }
      ]
    }
  ],
