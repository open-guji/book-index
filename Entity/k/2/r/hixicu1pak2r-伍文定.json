      "text": "河南知府",
      "sources": [
        {
          "title": "《明史》卷二百·伍文定傳",
          "source_bid": "d59f2mc8bta8",
          "details": "擢河南知府，計擒劇賊張勇、李文簡。"
        }
      ]
    },
    {
      "office_id": "hixia8p7txc2",
      "text": "江西按察使",
      "sources": [
        {
          "title": "《明史》卷二百·伍文定傳",
          "source_bid": "d59f2mc8bta8",
          "details": "賊平，功最，擢江西按察使。"
        }
      ]
    },
    {
      "office_id": "hixi5v60b75u",
      "text": "右副都御史",
      "sources": [
        {
          "title": "《明史》卷二百·伍文定傳",
          "source_bid": "d59f2mc8bta8",
          "details": "論功，進右副都御史，提督操江。"
        }
      ]
