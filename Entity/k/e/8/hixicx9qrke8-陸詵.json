  "description": {
    "text": "餘杭人，進士起家。通判秦州，言范祥城古渭生事；提點陝西刑獄，議大錢以一當二；知桂州，鎮撫交阯；知延州，折諒祚之嫚，諒祚謝罪；戒种諤勿妄納嵬名山，徙秦鳳、晉州；改龍圖閣學士、知成都，言蜀不宜行青苗法。",
    "sources": [
      {
        "name": "《宋史·陸詵傳》",
        "details": "卷332"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o8k3y8",
      "text": "集賢校理",
      "sources": [
        {
          "title": "《宋史》卷三百三十二·陸詵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加集賢校理、通判秦州。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32n",
      "text": "集賢殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百三十二·陸詵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙湖南、北轉運使，直集英院，進集賢殿修撰、知桂州。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百三十二·陸詵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為天章閣待制、知諫院，命張田代之，英宗戒以毋得改詵法。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr6",
      "text": "龍圖閣學士",
      "sources": [
        {
          "title": "《宋史》卷三百三十二·陸詵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既諤抵罪，向、穆之皆坐貶，以詵知真定，改龍圖閣學士、知成都。"
        }
      ]
    }
  ],
