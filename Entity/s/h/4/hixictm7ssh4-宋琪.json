  "description": {
    "text": "幽州薊人。契丹開貢舉時中進士，後隨趙延壽、趙贊南歸，周時為記室；宋初歷官，太宗太平興國八年拜相，雍熙中上平燕之策，罷為右僕射；卒贈司空，諡惠安。",
    "sources": [
      {
        "name": "《宋史·宋琪傳》",
        "details": "卷264"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ppxoua",
      "text": "太子洗馬",
      "start": 978,
      "end": 978,
      "date_text": "太平興國三年",
      "sources": [
        {
          "title": "《宋史》卷二百六十四·宋琪傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國三年，授太子洗馬，召見詰責，琪拜謝，請悔過自新。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷二百六十四·宋琪傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷太常丞，出知大通監。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "sources": [
        {
          "title": "《宋史》卷二百六十四·宋琪傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年春，拜右僕射，特令月給實奉一百千，又以其衰老，詔許五日一朝。"
        }
      ]
    }
  ],
