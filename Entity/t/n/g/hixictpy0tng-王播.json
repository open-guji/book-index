  "description": {
    "text": "太原人，家揚州。與弟王炎、王起並擢進士；為監察御史、京兆尹，以吏治稱；穆宗時拜相，後為淮南節度使兼鹽鐵轉運使，聚斂進奉；文宗時再相，卒。",
    "sources": [
      {
        "name": "《新唐書·列傳第九十二》",
        "details": "卷167"
      },
      {
        "name": "《舊唐書·列傳第一百十四》",
        "details": "卷164"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5v2mknb6",
      "text": "監察御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "播擢進士第，登賢良方正制科，授集賢校理，再遷監察御史，轉殿中，歷侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdh",
      "text": "駕部郎中",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "順宗即位，除駕部郎中，改長安令。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdp",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "歲中，遷工部郎中，知臺雜，刺舉綱憲，為人所稱。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "虢州刺史",
      "place_id": "hixicl84l2hy",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "轉考功郎中，出為虢州刺史。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g7",
      "text": "禮部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十年四月，改禮部尚書，領使如故。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gb",
      "text": "刑部尚書",
      "start": 821,
      "end": 821,
      "date_text": "長慶元年",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "長慶元年七月，征還，拜刑部尚書，復領鹽鐵轉運等使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十月，兼中書侍郎、平章事，領使如故。"
        }
      ]
    },
    {
      "office_id": "hixia8oehm9t",
      "text": "尚書左僕射",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "六月，拜尚書左僕射、同平章事，領使如故。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqiq",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百六十四·王播傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "廢朝三日，贈太尉。"
        }
      ]
    },
    {
      "office_id": "hiximd4offus",
      "text": "駕部員外郎",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "還，除駕部員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdp",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷工部郎中，知御史雜事。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "擢御史中丞，歲終，改京兆尹。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gc",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "憲宗以為能，進刑部侍郎，領諸道鹽鐵轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8pjdpfl",
      "text": "劍南西川節度使",
      "place_id": "hiximxkt4c9b",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "久之，檢校戶部尚書，為劍南西川節度使。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gb",
      "text": "刑部尚書",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "長慶初，召為刑部尚書，復領鹽鐵，進中書侍郎、同中書門下平章事。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "長慶初，召為刑部尚書，復領鹽鐵，進中書侍郎、同中書門下平章事。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqiq",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百六十七·王播傳",
          "source_bid": "d59f2htqolj5",
          "details": "居位四年，卒，年七十二，贈太尉，謚曰敬。"
        }
      ]
    }
  ],
