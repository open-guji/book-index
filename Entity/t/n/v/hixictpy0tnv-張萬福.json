        "details": "卷152"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8pq8xdv",
      "text": "鴻臚卿",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十二·張萬福傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "為節度使崔圓所忌，失刺史，改鴻臚卿；以節度副使將千人鎮壽州，萬福不以為恨。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "舒州刺史",
      "place_id": "hixicl8d0h1v",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十二·張萬福傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "賊陷舒州，圓又以萬福為舒州刺史，督淮南岸盜賊，連破其黨。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "濠州刺史",
      "place_id": "hixicl85is55",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十二·張萬福傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "德宗以萬福為濠州刺史，召見謂曰：「先帝改卿名『正』者，所以褒卿也。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "泗州刺史",
      "place_id": "hixicl85is3l",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十二·張萬福傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "改泗州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8pq8xdv",
      "text": "鴻臚卿",
      "sources": [
        {
          "title": "《新唐書》卷一百七十·張萬福傳",
          "source_bid": "d59f2htqolj5",
          "details": "而節度崔圓忌之，失刺史，改鴻臚卿，使將千人鎮壽州，不以為恨。"
