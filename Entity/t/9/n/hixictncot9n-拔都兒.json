  "offices": [
    {
      "office_id": "hiximwvsknxq",
      "text": "廣威將軍",
      "start": 1286,
      "end": 1286,
      "date_text": "至元二十三年",
      "sources": [
        {
          "title": "《元史》卷一百三十二·拔都兒傳",
          "source_bid": "d59f2njivtog",
          "details": "至元二十三年，授廣威將軍、後衞親軍副都指揮使，賜虎符。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknxp",
      "text": "定遠大將軍",
      "start": 1287,
      "end": 1287,
      "date_text": "明年",
      "basis": "承上文年號至元",
      "sources": [
        {
          "title": "《元史》卷一百三十二·拔都兒傳",
          "source_bid": "d59f2njivtog",
          "details": "明年夏，從征乃顏于亦迷河，擒僉家奴、塔不台以歸，賞鈔及衣段，加定遠大將軍。"
        }
      ]
    }
