  },
  "offices": [
    {
      "office_id": "hixi5v2m9erl",
      "text": "參知政事",
      "sources": [
        {
          "title": "《元史》卷一百二十八·阿里海牙傳",
          "source_bid": "d59f2njivtog",
          "details": "五年，命與元帥阿朮、劉整取襄陽，又加參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8muawhv",
      "text": "行省右丞",
      "sources": [
        {
          "title": "《元史》卷一百二十八·阿里海牙傳",
          "source_bid": "d59f2njivtog",
          "details": "阿里海牙進行省右丞，賞鈔二百錠。"
        }
      ]
    },
    {
      "office_id": "hixia8n08ete",
      "text": "平章政事",
      "sources": [
        {
          "title": "《元史》卷一百二十八·阿里海牙傳",
          "source_bid": "d59f2njivtog",
          "details": "因入朝賀平宋，拜平章政事，使持詔如靜江諭之。"
        }
      ]
