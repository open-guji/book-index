    },
    {
      "office_id": "hixia8opexaa",
      "text": "秘書少監",
      "sources": [
        {
          "title": "《宋史》卷三百七十·鄭剛中傳",
          "source_bid": "d59f2gonq7sy",
          "details": "移宗正少卿，請去，不許，改秘書少監。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十·鄭剛中傳",
          "source_bid": "d59f2gonq7sy",
          "details": "金歸侵疆，檜遣剛中為宣諭司參謀官；及還，除禮部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixibw2tkiyo",
      "text": "濠州團練副使",
      "sources": [
        {
          "title": "《欽定四庫全書總目》卷三·《周易窺餘》提要",
          "source_bid": "d59dh3vo9af4",
          "details": "剛中字亨仲，金華人，紹興二年進士及第，官至禮部侍郞，出爲川陜宣撫副使，謫居桂陽軍，又責授濠州團練副使，復州安置，再徙封州，卒。"
        }
      ]
    }
