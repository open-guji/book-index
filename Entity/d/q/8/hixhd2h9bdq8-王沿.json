          "details": "中進士第，試秘書省校書郎，歷知彭城、新昌二縣，改相州觀察推官，知宗城縣。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu7",
      "text": "開封府推官",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，為開封府推官。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "被詔鞫曹汭獄於真定府，遷殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu8",
      "text": "尚書工部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "母喪服除，改尚書工部員外郎、知邢州，復起為河北轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8nggr2b",
      "text": "直昭文館",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授直昭文館，為三司戶部副使，徙鹽鐵，遷兵部員外郎、天章閣待制、陝西都轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授直昭文館，為三司戶部副使，徙鹽鐵，遷兵部員外郎、天章閣待制、陝西都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷刑部郎中、河東都轉運使，加龍圖閣直學士、知并州。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進樞密直學士、右司郎中，為涇原路經略、安撫、招討使兼知渭州。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "涇州觀察使",
      "place_id": "hixicl857jhf",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改涇州觀察使。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "坐懷敏敗，復為龍圖閣直學士、刑部郎中、知虢州，尋降天章閣待制，而為權御史中丞賈昌朝所奏，落待制。"
        }
      ]
    },
    {
      "office_id": "hixi4udstrlv",
      "text": "待制",
      "sources": [
        {
          "title": "《宋史》卷三百·王沿傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，徙知成德軍，復待制，又徙河中府，卒。"
        }
      ]
