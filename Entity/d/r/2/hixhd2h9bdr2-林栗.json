    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷三百九十四·林栗傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除右司員外郎，遷太常少卿。"
        }
      ]
    },
    {
      "office_id": "hixia8nxmsxx",
      "text": "直敷文閣",
      "sources": [
        {
          "title": "《宋史》卷三百九十四·林栗傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知興化軍，又移南劍，除夔路提點刑獄，改知夔州，加直敷文閣。"
        }
      ]
    },
    {
      "office_id": "hixia8o1ow01",
      "text": "直寶文閣",
      "sources": [
        {
          "title": "《宋史》卷三百九十四·林栗傳",
          "source_bid": "d59f2gonq7sy",
          "details": "居頃之，詔栗累更事任，清介有聞，復直寶文閣、廣南西路轉運判官，就改提點刑獄，又改知潭州。"
        }
      ]
    },
    {
      "office_id": "hixi4udt505i",
      "text": "秘閣修撰",
