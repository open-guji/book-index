  "primary_name": "張萬家奴",
  "dynasty": "元",
  "dynasty_basis": "據正史本傳",
  "period": "liao-jin-yuan",
  "period_basis": "據 dynasty「元」歸併",
  "title_or_office": "副都元帥",
  "description": {
    "text": "父札古帶事睿宗，歿于軍。中統二年襲父官，屢從紐璘、也速答兒等攻瀘州、重慶、嘉定，拔瀘州神臂門；後討亦奚不薛蠻，進副都元帥，征哈剌章，戰死。子孝忠。",
    "sources": [
      {
        "name": "《元史·張萬家奴傳》",
        "details": "卷165"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximwvsknxn",
      "text": "昭勇大將軍",
      "sources": [
        {
          "title": "《元史》卷一百六十五·張萬家奴傳",
          "source_bid": "d59f2njivtog",
          "details": "先據神臂門，為梯衝登城，殺二百餘人，斬關而入，遂拔之，加昭勇大將軍。"
        }
      ]
    },
    {
      "office_id": "hiximde33x9h",
      "text": "昭毅大將軍",
      "sources": [
        {
          "title": "《元史》卷一百六十五·張萬家奴傳",
          "source_bid": "d59f2njivtog",
          "details": "會圍重慶，將其眾斷馬湖江，分兵水陸往來為游徼，加昭毅大將軍。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknzb",
      "text": "招討使",
      "sources": [
        {
          "title": "《元史》卷一百六十五·張萬家奴傳",
          "source_bid": "d59f2njivtog",
          "details": "以所部轉餉成都及下流諸屯，尋遷招討使。"
        }
      ]
    },
    {
      "office_id": "hiximde33x9f",
      "text": "明威將軍",
      "sources": [
        {
          "title": "《元史》卷一百六十五·張萬家奴傳",
          "source_bid": "d59f2njivtog",
          "details": "復擊降大垻都掌、蟻子諸蠻，加明威將軍。"
        }
      ]
    }
  ],
