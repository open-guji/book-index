  "description": {
    "text": "宿州符離人，徙東平。嚴實學校試登上選，擢國史院編脩官、應奉翰林文字；至元七年使高麗；十二年為伯顏行省諮議，謀定臨安，取宋國璽；授嘉興路總管，以疾歸東平，卒年五十一，追封魯郡公，諡文襄。",
    "sources": [
      {
        "name": "《元史·孟祺傳》",
        "details": "卷160"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximwvsknxc",
      "text": "承事郎",
      "start": 1270,
      "end": 1270,
      "date_text": "至元七年",
      "sources": [
        {
          "title": "《元史》卷一百六十·孟祺傳",
          "source_bid": "d59f2njivtog",
          "details": "至元七年，持節使高麗，還，稱旨，授承事郎、山東東西道勸農副使。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9erk",
      "text": "郎中",
      "sources": [
        {
          "title": "《元史》卷一百六十·孟祺傳",
          "source_bid": "d59f2njivtog",
          "details": "久之，遷郎中，伯顏雅信任之。"
        }
      ]
    },
    {
      "office_id": "hiximwwsgydc",
      "text": "少中大夫",
      "sources": [
        {
          "title": "《元史》卷一百六十·孟祺傳",
          "source_bid": "d59f2njivtog",
          "details": "有旨褒陞，授少中大夫、嘉興路總管，佩虎符。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknww",
      "text": "太中大夫",
      "start": 1281,
      "end": 1281,
      "date_text": "至元十八年",
      "sources": [
        {
          "title": "《元史》卷一百六十·孟祺傳",
          "source_bid": "d59f2njivtog",
          "details": "至元十八年，擢太中大夫、浙東海右道提刑按察使，疾不赴。"
        }
