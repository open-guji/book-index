        "details": "卷171"
      },
      {
        "name": "《舊唐書·列傳第一百十一》",
        "details": "卷161"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5vx2iuj0",
      "text": "滑州刺史",
      "place_id": "hixicl84wawj",
      "sources": [
        {
