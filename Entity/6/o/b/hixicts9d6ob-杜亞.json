  "description": {
    "text": "自云京兆人。肅宗在靈武上書擢校書郎，為杜鴻漸判官；歷江西觀察使、陝虢觀察兼轉運使、淮南節度使；為東都留守，好事不稱職；卒年七十四，贈太子少傅，諡肅。",
    "sources": [
      {
        "name": "《新唐書·列傳第九十七》",
        "details": "卷172"
      },
      {
        "name": "《舊唐書·列傳第九十六》",
        "details": "卷146"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5v2mknba",
      "text": "校書郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十六·杜亞傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "至德初，於靈武獻封章，言政事，授校書郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g2",
      "text": "吏部郎中",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十六·杜亞傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "使還，授吏部郎中、諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9es3",
      "text": "給事中",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十六·杜亞傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "載死之翌日，亞遷給事中、河北宣慰使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "洪州刺史",
      "place_id": "hixicl83ncsb",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十六·杜亞傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "宰相常袞亦不悅亞，歲餘，出為洪州刺史、兼御史中丞、江西都團練觀察使。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegow",
      "text": "陝州觀察使",
      "place_id": "hixicabu3dvl",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十六·杜亞傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "既至，帝微知之，不悅；又奏對辭旨疏闊，出為陝州觀察使兼轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8pg9c01",
      "text": "太子少傅",
      "posthumous": true,
      "sources": [
