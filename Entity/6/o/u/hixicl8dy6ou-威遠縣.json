      {
        "name": "《明史》卷四十三〈地理志四〉",
        "details": "嘉定州「威遠州東。洪武六年十二月置，屬嘉定府。十年五月省入榮縣。十三年十一月復置。」"
      },
      {
        "name": "《隋書》卷二十九〈地理志上〉",
        "details": "資陽郡「威遠。開皇初置。」"
      },
      {
        "name": "《新唐書》卷四十二〈地理志六〉",
        "details": "榮州「威遠，中下。貞觀元年析置婆日、至如二縣。二年以瀘州之隆越來屬。八年省婆日、至如、隆越入焉。有鹽。」"
      },
      {
        "name": "《宋史》卷八十九〈地理志五〉",
        "details": "榮州「威遠，中。」"
      }
    ]
  },
