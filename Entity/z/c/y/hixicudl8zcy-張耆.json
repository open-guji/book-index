  "description": {
    "text": "開封人。十一歲給事真宗藩邸；咸平中禦契丹，援望都力戰；累遷宣徽南院使兼樞密副使，後拜同中書門下平章事，歷鎮安軍、淮南節度使，以太子太師致仕，卒贈太師兼侍中。",
    "sources": [
      {
        "name": "《宋史·張耆傳》",
        "details": "卷290"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8of43d0",
      "text": "昭州團練使",
      "place_id": "hixicl865977",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷昭州團練使、幷代州鈐轄。"
        }
      ]
    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "英州防禦使",
      "place_id": "hixiclqm30mc",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷英州防禦使、侍衛親軍馬軍都虞候。"
        }
      ]
    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "絳州防禦使",
      "place_id": "hixicabu3dwg",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從帝東封，遷絳州防禦使、殿前都虞候。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "相州觀察使",
      "place_id": "hixicl84waz2",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷相州觀察使、馬軍副都指揮使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "威塞軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從祀汾陰，授威塞軍節度使，進宣徽南院使兼樞密副使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl5z",
      "text": "宣徽南院使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從祀汾陰，授威塞軍節度使，進宣徽南院使兼樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "武寧軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁父母憂，起復，徙武寧軍節度使，拜同中書門下平章事、判陳州。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁父母憂，起復，徙武寧軍節度使，拜同中書門下平章事、判陳州。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋召為樞密使兼群牧制置使、會靈觀使。"
        }
      ]
    },
    {
      "office_id": "hixia8nf7sw3",
      "text": "尚書左僕射",
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加尚書左僕射，歷河陽、泰寧、山南東道、昭德軍節度使，進兼侍中，封鄧國公。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十·張耆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以太子太師致仕，卒，贈太師兼侍中，諡榮僖。"
        }
      ]
    }
  ],
