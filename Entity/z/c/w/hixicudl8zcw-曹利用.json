        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "尚書右僕射",
      "sources": [
        {
          "title": "《宋史》卷二百九十·曹利用傳",
          "source_bid": "d59f2gonq7sy",
          "details": "迪坐是免，而利用以檢校太師兼太子少保為會靈觀使，進尚書右僕射。"
        }
      ]
    },
    {
      "office_id": "hixia8nf7sw3",
      "text": "左僕射",
      "sources": [
        {
          "title": "《宋史》卷二百九十·曹利用傳",
          "source_bid": "d59f2gonq7sy",
          "details": "乾興初，加左僕射兼侍中、武寧軍節度使、景靈宮使，詔如曹彬給公使錢歲萬緡。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·曹利用傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋召張旻於河陽，為樞密使，利用疑代己，始悔懼焉。"
        }
      ]
    },
    {
      "office_id": "hixi5wrbltsg",
      "text": "太傅",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十·曹利用傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明道二年，追復節度兼侍中，後贈太傅，還諸子官，賜諡襄悼，命學士趙概作神道碑，帝為篆其額曰「旌功之碑」，詔歸所沒舊產。"
        }
      ]
    }
