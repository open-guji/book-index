    "basis": "通行生卒"
  },
  "description": {
    "text": "其先邢州人，徙洛。兄郭遵死於敵，錄為三班奉職，隸范仲淹麾下；嘗預言葛懷敏必敗；治平二年同簽書樞密院，熙寧中交阯陷邕州，為安南行營經略招討使，後坐無功久廢。",
    "sources": [
      {
        "name": "《宋史·郭逵傳》",
        "details": "卷290"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3lc",
      "text": "禮賓使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷禮賓使，徙南路鈐轄、知邵州。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "容州觀察使",
      "place_id": "hixicl86596r",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累遷容州觀察使。"
        }
      ]
    },
    {
      "office_id": "hixigfk40z5s",
      "text": "殿前都虞候",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿前都虞候，出為涇原路副都部署。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl5z",
      "text": "宣徽南院使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "言者復力爭，乃改宣徽南院使、判鄆州。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "檢校太尉",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加檢校太尉、雄武軍留後。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4i",
      "text": "宣徽使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙太原，復宣徽使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl7p",
      "text": "左屯衛大將軍",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "哲宗立，復左屯衛大將軍致仕。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "廣州觀察使",
      "place_id": "hixicl86594q",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起知潞州，進廣州觀察使、知河中。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl7k",
      "text": "左武衛上將軍",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "辭歸洛，改左武衛上將軍、提舉崇福宮，卒。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "雄武軍節度使",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "輟視朝一日，贈雄武軍節度使。"
        }
      ]
    }
  ],
