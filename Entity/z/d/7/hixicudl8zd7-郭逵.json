          "source_bid": "d59f2gonq7sy",
          "details": "累遷容州觀察使。"
        }
      ]
    },
    {
      "office_id": "hixigfk40z5s",
      "text": "殿前都虞候",
      "sources": [
        {
          "title": "《宋史》卷二百九十·郭逵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿前都虞候，出為涇原路副都部署。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4i",
