  "title_or_office": "樞密副使",
  "description": {
    "text": "許州陽翟人。舉進士甲科，曹利用婿；寶元初安撫忻、代地震；歷陝西都轉運使、知渭州，召拜參知政事，避文彥博親改樞密副使；晚守延州，召還道卒，贈太尉。",
    "sources": [
      {
        "name": "《宋史·程戡傳》",
        "details": "卷292"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nu76yr",
      "text": "秘書丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "少力學，舉進士甲科，補涇州觀察推官，再遷秘書丞、通判許州。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以尚書屯田員外郎知歸州，召為侍御史、三司度支判官。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改起居舍人、知諫院，遷兵部員外郎兼侍御史知雜事、三司戶部副使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改起居舍人、知諫院，遷兵部員外郎兼侍御史知雜事、三司戶部副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢天章閣待制、陜西都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知渭州",
      "place_id": "hixicl857jh9",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，知渭州。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "御史中丞張觀辨之，復為樞密直學士、知永興軍，徙瀛州，四遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗自擇戡再知益州，遷端明殿學士，召見慰遣。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除吏部侍郎、觀文殿學士兼翰林侍讀學士、同群牧制置使，尋拜宣徽南院使、鄜延路經略安撫使、判延州。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十二·程戡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太尉，謚康穆。"
        }
      ]
    }
  ],
