          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國初，舉進士甲科，解褐大理評事、通判興州，累遷右贊善大夫。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿中丞、通判邠州。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲滿，拜監察御史、通判興元府，進秩殿中。"
        }
      ]
    },
    {
      "office_id": "hixia8mpmcch",
      "text": "起居郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾月，徙洪州，改起居郎。"
        }
      ]
    },
    {
      "office_id": "hixia8nggr2b",
      "text": "直昭文館",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗在襄邸，太宗擇朝士謹厚者為官屬，即召入為翊善，賜金紫，加直昭文館。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg6",
      "text": "司封員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗尹京府，命兼推官，加司封員外郎。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十二·夏侯嶠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "東宮建，復兼中舍，遷工部郎中。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
