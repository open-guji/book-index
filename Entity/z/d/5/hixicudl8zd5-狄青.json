  "description": {
    "text": "汾州西河人。寶元初元昊反，以延州指使屢為先鋒，臨敵被髮帶銅面具；皇祐中討儂智高，夜奪崑崙關，大敗之於歸仁鋪；拜樞密使，以人情疑之出判陳州，明年卒。面涅猶存，不肯除字。",
    "sources": [
      {
        "name": "《宋史·狄青傳》",
        "details": "卷290"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8oxj3eo",
      "text": "秦州刺史",
      "place_id": "hixicl857jgj",
      "sources": [
        {
          "title": "《宋史》卷二百九十·狄青傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以功累遷西上閤門副使，擢秦州刺史、涇原路副都總管、經略招討副使，又加捧日天武四廂都指揮使、惠州團練使。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·狄青傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以彰化軍節度使知延州，擢樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "護國軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·狄青傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為樞密副使，遷護國軍節度使、河中尹。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "sources": [
        {
          "title": "《宋史》卷二百九十·狄青傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還至京師，帝嘉其功，拜樞密使，賜第敦教坊，優進諸子官秩。"
        }
      ]
    },
    {
      "office_id": "hixia8ojheyp",
      "text": "中書令",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十·狄青傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝發哀，贈中書令，諡武襄。"
        }
      ]
    }
  ],
