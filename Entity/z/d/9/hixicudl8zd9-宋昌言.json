  "title_or_office": "少府監",
  "description": {
    "text": "宋綬族子。以蔭為澤州司理參軍，平反殺人冤獄；歷河陰發運判官、都水監丞，熙寧初建議於二股河口立約障水東流；後判都水監，河決曹村時護堤，轉少府監，卒。",
    "sources": [
      {
        "name": "《宋史·宋綬傳》",
        "details": "卷291，附傳"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "年十五，召試中書，真宗愛其文，遷大理評事，聽於秘閣讀書。"
        }
      ]
    },
    {
      "office_id": "hixia8o8k3y8",
      "text": "集賢校理",
      "start": 1008,
      "end": 1008,
      "date_text": "大中祥符元年",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "大中祥符元年，復試學士院，為集賢校理，與父皋同職。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cf",
      "text": "大理寺丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "後賜同進士出身，遷大理寺丞。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "左正言",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "將祠亳州太清宮，以簽書亳州判官事，入為左正言、同判太常禮院。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfo",
      "text": "戶部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累遷戶部郎中、權直學士院，同修《真宗實錄》，進左司郎中，遂為翰林學士兼侍讀學士、勾當三班院。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累遷戶部郎中、權直學士院，同修《真宗實錄》，進左司郎中，遂為翰林學士兼侍讀學士、勾當三班院。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "同修國史，遷中書舍人。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，復翰林學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "尚書工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "史成，遷尚書工部侍郎兼侍讀學士。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr6",
      "text": "龍圖閣學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "書上，忤太后意，改龍圖閣學士，出知應天府。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6s",
      "text": "資政殿大學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲餘，加資政殿大學士，以禮部尚書知河南府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復召知樞密院事，遷兵部尚書、參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxf",
      "text": "司徒",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十一·宋綬傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋卒，贈司徒兼侍中，諡「宣獻」。"
        }
      ]
    }
