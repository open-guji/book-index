  "description": {
    "text": "歙州新安人。仕南唐，入宋預修《太平御覽》《太平廣記》《文苑英華》；太宗時充翰林侍讀，與王著更宿；後以疾罷，改刑部侍郎、集賢院學士，卒。",
    "sources": [
      {
        "name": "《宋史·呂文仲傳》",
        "details": "卷296"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷二百九十六·呂文仲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "文仲在江左，舉進士，調補臨川尉，再遷大理評事，掌宗室書奏。"
        }
      ]
    },
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十六·呂文仲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "預修太平《御覽》、《廣記》、《文苑英華》，改著作佐郎。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百九十六·呂文仲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，賜金紫，加左諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8pum8zl",
      "text": "侍讀",
      "sources": [
        {
          "title": "《宋史》卷二百九十六·呂文仲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既而太宗知其由，復令直秘閣；逾月，再為侍讀。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷二百九十六·呂文仲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷起居舍人、兵部員外郎、同判吏部銓，知銀臺通進封駁司、審官院。"
        }
      ]
    },
