  "native_place_basis": "《宋史》卷331本傳著錄「齊州長山人」",
  "title_or_office": "吏部侍郎",
  "description": {
    "text": "齊州長山人，登進士第，為殿中侍御史、知諫院，劾梁適、狄青、王守忠；荊湖安撫奏除湘中計丁輸米之弊；為河北都轉運使，開魏金堤分水；知河南府建永厚陵費省；以吏部侍郎致仕，退休十五年，卒年八十五。",
    "sources": [
      {
        "name": "《宋史·韓贄傳》",
        "details": "卷331"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·韓贄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "道除知睦州，復為侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·韓贄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改知諫院，進天章閣待制。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·韓贄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "出知滄、瀛二州，遷龍圖閣直學士、河北都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知河南府",
      "place_id": "hixicl84l2i0",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·韓贄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知河南府，建永厚陵，費省而不擾，神宗稱之。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知徐州",
      "place_id": "hixicl84l2fx",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·韓贄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還知審刑院、糾察在京刑獄，知徐州，以吏部侍郎致仕。"
        }
      ]
    }
  ],
