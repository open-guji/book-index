  "title_or_office": "權兵部侍郎",
  "description": {
    "text": "濮州鄄城人，以蔭為泉州司法參軍，不私買蕃舶貨。元祐元年范純仁等交薦，除河北轉運判官，司馬光稱其論議詳盡；歷大理少卿、侍御史，知相、徐州，陝西轉運使；權兵部侍郎，以集賢院學士提舉崇福宮，卒年六十四。",
    "sources": [
      {
        "name": "《宋史·杜純傳》",
        "details": "卷330"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixiby3db313",
      "text": "大理正",
      "sources": [
        {
          "title": "《宋史》卷三百三十·杜純傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，為大理正。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百三十·杜純傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為刑部員外郎、大理少卿，擢侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximd4offv5",
      "text": "右司郎中",
      "sources": [
        {
          "title": "《宋史》卷三百三十·杜純傳",
          "source_bid": "d59f2gonq7sy",
          "details": "言者詆其不由科第，改右司郎中，尋知相州，徙徐州，陝西轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知相州",
      "place_id": "hixicl84waz2",
      "sources": [
        {
          "title": "《宋史》卷三百三十·杜純傳",
          "source_bid": "d59f2gonq7sy",
          "details": "言者詆其不由科第，改右司郎中，尋知相州，徙徐州，陝西轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百三十·杜純傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，拜鴻臚、光祿卿，權兵部侍郎，謝病，以集賢院學士提舉崇福宮，改修撰。"
        }
      ]
