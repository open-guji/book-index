  "offices": [
    {
      "office_id": "hixic9fkl8ap",
      "text": "都指揮同知",
      "sources": [
        {
          "title": "《明史》卷二百一十一·馬永傳",
          "source_bid": "d59f2mc8bta8",
          "details": "正德時，從陸完擊賊有功，進都指揮同知。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8az",
      "text": "總兵官",
      "kind": "充",
      "sources": [
        {
          "title": "《明史》卷二百一十一·馬永傳",
          "source_bid": "d59f2mc8bta8",
          "details": "十三年進都督僉事，充總兵官，鎮守薊州。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8al",
      "text": "右都督",
      "sources": [
        {
          "title": "《明史》卷二百一十一·馬永傳",
          "source_bid": "d59f2mc8bta8",
          "details": "永迎擊洪山口，而伏兵斷其後，斬獲過當，進右都督。"
        }
      ]
