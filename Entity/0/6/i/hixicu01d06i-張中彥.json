        }
      ]
    },
    {
      "office_id": "hixi5wud64g6",
      "text": "彰德軍節度使",
      "sources": [
        {
          "title": "《金史》卷七十九·張中彥傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "改彰德軍節度使，均賦調法，奸豪無所蔽匿，人服其明。"
        }
