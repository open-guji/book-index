  "offices": [
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士起家，為贛縣尉，試書判拔萃，改將作監丞、知新建縣，遷秘書丞。"
        }
      ]
    },
    {
      "office_id": "hixia8nu76yr",
      "text": "秘書丞",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士起家，為贛縣尉，試書判拔萃，改將作監丞、知新建縣，遷秘書丞。"
        }
      ]
    },
    {
      "office_id": "hixia8o8k3y8",
      "text": "集賢校理",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "書奏，擢集賢校理。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知英州",
      "place_id": "hixiclqm30mc",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙監泰州稅，知英州，遷太常博士，復為校理、同知禮院。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙監泰州稅，知英州，遷太常博士，復為校理、同知禮院。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "慶曆中，仁宗銳意欲更天下敝事，增諫官員，使論得失，以靖為右正言。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg9",
      "text": "將作少監",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改將作少監，分司南京，居曲江。"
        }
      ]
    },
    {
      "office_id": "hixia8njl4hs",
      "text": "衛尉卿",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷衛尉卿、知虔州，丁父憂去。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "尚書工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "御史梁蒨言賞薄，又遷尚書工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mzx69t",
      "text": "集賢院學士",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加集賢院學士，徙知潭州，又徙青州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptt",
      "text": "工部尚書",
      "sources": [
        {
          "title": "《宋史》卷三百二十·余靖傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知廣州，官至工部尚書，代歸，卒。"
        }
      ]
    }
  ]
