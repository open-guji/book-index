  "offices": [
    {
      "office_id": "hiximdfhd4ox",
      "text": "左拾遺",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷左拾遺。"
        }
      ]
    },
    {
      "office_id": "hixi5v2mknb7",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "或薦璨才高，試文，帝稱善，擢翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "進中書侍郎、判戶部，封河東縣男。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ms",
      "text": "金吾衛將軍",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "廷範者，以優人為全忠所愛，扈東遷為禦營使，進金吾衛將軍、河南尹。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "宿州刺史",
      "place_id": "hixicl85u0it",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "與時溥、朱宣戰，以多累表檢校尚書右仆射，為宿州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8pjdpfl",
      "text": "保大軍節度使",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷檢校司空，再進為保大軍節度使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "汝州刺史",
      "place_id": "hixicl84l2do",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "乾寧中，授汝州刺史，檢校司空。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "潁州刺史",
      "place_id": "hixicl84wb0k",
      "sources": [
        {
          "title": "《新唐書》卷二百二十三·柳璨傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷潁州刺史、感化軍節度留後。"
        }
      ]
    }
