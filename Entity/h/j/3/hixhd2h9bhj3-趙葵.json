  "description": {
    "sources": [
      {
        "name": "《宋史·趙葵傳》",
        "details": "卷417，傳首：趙葵，字南仲，京湖制置使方之子。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixidx4p62ve",
      "text": "大理司直",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "方卒，十五年，起復直祕閣、通判廬州，進大理司直、淮西安撫參議官。"
        }
      ]
    },
    {
      "office_id": "hixia8n73mrl",
      "text": "參議官",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "范刻日約葵，葵帥雄勝、寧淮、武定、強勇步騎萬四千，命王鑒、扈斌、胡顯等將之，以葵兼參議官。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "福州觀察使",
      "place_id": "hixicl85u0j6",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進葵福州觀察使、左驍衛上將軍，葵辭不受。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八月，召封樞密院稟議，受寶章閣待制、樞密副都承旨，依舊職仍落起復，尋進兵部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知應天府",
      "place_id": "hixicl84l2fi",
      "start": 1234,
      "end": 1234,
      "date_text": "端平元年",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "端平元年，朝議收復三京，葵上疏請出戰，乃授權兵部尚書、京河制置使，知應天府、南京留守兼淮東制置使。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "start": 1238,
      "end": 1238,
      "date_text": "二年",
      "basis": "承上文年號嘉熙",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，以應援安豐捷，奏拜刑部尚書，進端明殿學士，特予執政恩例，復兼本路屯田使。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk2",
      "text": "大學士",
      "start": 1242,
      "end": 1242,
      "date_text": "淳祐二年",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳祐二年，進大學士、知潭州、湖南安撫使，改福州。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "start": 1244,
      "end": 1244,
      "date_text": "淳祐四年",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳祐四年，授同知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegoy",
      "text": "知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "十二月，拜知樞密院事兼參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知建康府",
      "place_id": "hixifx69t1qf",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋知建康府、行宮留守、江東安撫使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6r",
      "text": "醴泉觀使",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "四上表力辭，言者以宰相須用讀書人，罷為觀文殿學士，充醴泉觀使兼侍讀，仍奉朝請。"
        }
      ]
    },
    {
      "office_id": "hixia8mode6b",
      "text": "特進",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋判潭州、湖南安撫使，加特進。"
        }
      ]
    },
    {
      "office_id": "hiximd7hkbuo",
      "text": "少保",
      "start": 1257,
      "end": 1257,
      "date_text": "五年",
      "basis": "承上文年號寶祐",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年，進少保、寧遠軍節度使，進封魏國公、醴泉觀使兼侍讀。"
        }
      ]
    },
    {
      "office_id": "hixia8ooh7nn",
      "text": "兩淮宣撫使",
      "start": 1260,
      "end": 1260,
      "date_text": "景定元年",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景定元年，授兩淮宣撫使、判揚州，進封魯國公，尋奉祠。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0x",
      "text": "少傅",
      "start": 1265,
      "end": 1265,
      "date_text": "咸淳元年",
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸淳元年，加少傅。"
        }
      ]
    },
    {
      "office_id": "hixi5wrbltsg",
      "text": "太傅",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百一十七·趙葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太傅，諡「忠靖」。"
        }
      ]
    }
  ],
