    },
    {
      "office_id": "hiximde33x8k",
      "text": "吏部尚書",
      "sources": [
        {
          "title": "《元史》卷一百七十八·梁曾傳",
          "source_bid": "d59f2njivtog",
          "details": "召至京師，入見內殿，有旨令曾再使安南，授吏部尚書，賜三珠金虎符、襲衣、乘馬、弓矢、器幣，以禮部郎中陳孚為副，十二月，改授淮安路總管而行。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxd",
      "text": "杭州路總管",
      "place_id": "hixicl872yuw",
      "start": 1297,
      "end": 1297,
      "date_text": "大德元年",
      "sources": [
        {
          "title": "《元史》卷一百七十八·梁曾傳",
          "source_bid": "d59f2njivtog",
          "details": "大德元年，除杭州路總管，戶口復者五萬二千四百戶，請禁莫夜鞫囚、游街、酷刑，朝廷是之，著為令。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxd",
      "text": "潭州路總管",
      "declined": true,
      "start": 1303,
      "end": 1303,
      "date_text": "七年",
      "basis": "承上文年號大德",
      "sources": [
        {
          "title": "《元史》卷一百七十八·梁曾傳",
          "source_bid": "d59f2njivtog",
          "details": "七年，除潭州路總管，以未終制，不赴。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9erl",
      "text": "雲南行省參知政事",
      "sources": [
        {
          "title": "《元史》卷一百七十八·梁曾傳",
          "source_bid": "d59f2njivtog",
