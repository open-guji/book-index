  "offices": [
    {
      "office_id": "hixia8mhi680",
      "text": "大理評事",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "監察御史韋鎰充使監選黔中，引載為判官，載名稍著，遷大理評事。"
        }
      ]
    },
    {
      "office_id": "hixia8m7ttdt",
      "text": "祠部員外郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "時載避地江左，蘇州刺史、江東采訪使李希言表載為副，拜祠部員外郎，遷洪州刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "洪州刺史",
      "place_id": "hixicl83ncsb",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "時載避地江左，蘇州刺史、江東采訪使李希言表載為副，拜祠部員外郎，遷洪州刺史。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszd2",
      "text": "度支郎中",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "兩京平，入為度支郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "載智性敏悟，善奏對，肅宗嘉之，委以國計，俾充使江、淮，都領漕輓之任，尋加御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g6",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "數月徵入，遷戶部侍郎、度支使並諸道轉運使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "載能伺上意，頗承恩遇，遷中書侍郎、同中書門下平章事，加集賢殿大學士，修國史。"
        }
      ]
    },
    {
      "office_id": "hixikfedcgzn",
      "text": "銀青光祿大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十八·元載傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "又加銀青光祿大夫，封許昌縣子。"
        }
      ]
    },
    {
      "office_id": "hixia8m7ttdt",
      "text": "祠部員外郎",
      "sources": [
        {
          "title": "《新唐書》卷一百四十五·元載傳",
          "source_bid": "d59f2htqolj5",
          "details": "至德初，江都采訪使李希言表載自副，擢祠部員外郎、洪州刺史。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszd2",
      "text": "度支郎中",
      "sources": [
        {
          "title": "《新唐書》卷一百四十五·元載傳",
          "source_bid": "d59f2htqolj5",
          "details": "入為度支郎中，占奏敏給，肅宗異之。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g6",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百四十五·元載傳",
          "source_bid": "d59f2htqolj5",
          "details": "累遷戶部侍郎，充度支、江淮轉運等使。"
        }
      ]
    },
    {
      "office_id": "hixia8nxy1hc",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《新唐書》卷一百四十五·元載傳",
          "source_bid": "d59f2htqolj5",
          "details": "會京兆尹缺，輔國白用載，載意屬國柄，固辭，輔國曉之，翌日，拜同中書門下平章事，領使如故。"
        }
      ]
    }
  ],
