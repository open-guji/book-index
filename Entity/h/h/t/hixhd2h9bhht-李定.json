        {
          "title": "《宋史》卷三百二十九·李定傳",
          "source_bid": "d59f2gonq7sy",
          "details": "命定知諫院，宰相言前無選人除諫官之比，遂拜太子中允、監察御史裏行。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32n",
      "text": "集賢殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百二十九·李定傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年，加集賢殿修撰、知明州。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷三百二十九·李定傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元豐初，召拜寶文閣待制、同知諫院，進知制誥，爲御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷三百二十九·李定傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元豐初，召拜寶文閣待制、同知諫院，進知制誥，爲御史中丞。"
