  "offices": [
    {
      "office_id": "hixia8oxj3eo",
      "text": "高州刺史",
      "place_id": "hixicl86598a",
      "start": 1237,
      "end": 1237,
      "date_text": "嘉熙元年",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·孟珙傳",
          "source_bid": "d59f2gonq7sy",
          "details": "嘉熙元年，封隨縣男，擢高州刺史，忠州團練使兼知江陵府、京西湖北安撫副使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6h",
      "text": "寧遠軍承宣使",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·孟珙傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年春，授寧遠軍承宣使、帶御器械、鄂州江陵府諸軍都統制。"
        }
      ]
    },
    {
      "office_id": "hixigfk2gsg0",
      "text": "樞密都承旨",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·孟珙傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授樞密都承旨、制置使兼知鄂州。"
        }
      ]
    },
    {
      "office_id": "hixia8ots8w3",
      "text": "夔路制置大使",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·孟珙傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼夔路制置大使兼屯田大使。"
        }
      ]
    },
    {
      "office_id": "hiximd7hkbuo",
      "text": "檢校少保",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·孟珙傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜檢校少保，進封漢東郡公。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "檢校少師",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·孟珙傳",
          "source_bid": "d59f2gonq7sy",
          "details": "病遂革，乞休致，授檢校少師、寧武軍節度使致仕，終於江陵府治，時九月戊午也。"
        }
      ]
    }
  ],
