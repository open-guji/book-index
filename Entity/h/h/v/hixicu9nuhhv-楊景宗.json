    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "成州防禦使",
      "place_id": "hixicl857jgz",
      "sources": [
        {
          "title": "《宋史》卷四百六十三·楊景宗傳",
          "source_bid": "d59f2gonq7sy",
          "details": "章惠崩，遷成州防禦使，坐入臨皇儀殿被酒讙譟，出為兗州總管，改天雄軍副都總管。"
        }
