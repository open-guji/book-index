      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歸朝，充閤門祗候。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3kz",
      "text": "洛苑副使",
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，改內殿崇班，提點在京倉場、東西八作司，以舉職聞，遷洛苑副使。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3ky",
      "text": "洛苑使",
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "天禧初，遷洛苑使，領勤州刺史，與周懷政聯職。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6b",
      "text": "龍神衛四廂都指揮使",
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，授龍神衛四廂都指揮使，領昭州防禦使，改侍衛馬軍都虞候。"
        }
      ]
    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "昭州防禦使",
      "place_id": "hixicl865977",
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，授龍神衛四廂都指揮使，領昭州防禦使，改侍衛馬軍都虞候。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "廢朝三日，贈太尉、昭德軍節度，錄其子從德供備庫使，從廣內殿崇班，旁親遷補者數人，追封美亡妻宋氏河內郡夫人。"
        }
      ]
    },
    {
      "office_id": "hixia8njl4ht",
      "text": "侍中",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "母龐氏鄆國太夫人，美亦贈侍中。"
        }
      ]
    },
    {
      "office_id": "hixia8njl4hs",
      "text": "衛尉卿",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百六十三·劉美傳",
          "source_bid": "d59f2gonq7sy",
          "details": "有龔知進者，即通之友婿也，亦贈衛尉卿，其妻追封南安郡君。"
        }
      ]
    }
