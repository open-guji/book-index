  "offices": [
    {
      "office_id": "hiximda1c3ld",
      "text": "禮賓副使",
      "sources": [
        {
          "title": "《宋史》卷四百六十四·李用和傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既葬，遷禮賓副使，領八作司。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3lc",
      "text": "禮賓使",
      "sources": [
        {
          "title": "《宋史》卷四百六十四·李用和傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷禮賓使，同領皇城司。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l2",
      "text": "崇儀使",
      "sources": [
        {
          "title": "《宋史》卷四百六十四·李用和傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷崇儀使、賀州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eo",
      "text": "寧州刺史",
      "place_id": "hixicl857jgb",
      "sources": [
        {
          "title": "《宋史》卷四百六十四·李用和傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，授寧州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "建武軍節度使",
      "sources": [
        {
          "title": "《宋史》卷四百六十四·李用和傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歷侍衛親軍步軍馬軍副都指揮使，拜建武軍節度使、殿前副都指揮使。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百六十四·李用和傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既卒，帝哭之慟，贈太師、中書令、隴西郡王，輟朝五日，制服禁中，諡「恭僖」，帝撰神道碑，書曰「親賢之碑」。"
        }
      ]
    }
  ],
