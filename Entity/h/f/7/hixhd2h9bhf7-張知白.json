  "description": {
    "sources": [
      {
        "name": "《宋史·張知白傳》",
        "details": "卷310，傳首：張知白，字用晦，滄州清池人。"
      },
      {
        "title": "《隆平集》卷5",
        "source_bid": "d59f2hpsyuwx",
        "details": "張知白，字用晦，滄州人。端拱二年，登進士第，累遷龍圖閣待制、御史中丞。大中祥符九年，參知政事。天禧二年，罷為侍讀學士、知大名府，真宗賦詩餞之。仁宗即位，召為樞密……"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸平中疏言當今要務，真宗異之，召試舍人院，權右正言。"
        }
      ]
    },
    {
      "office_id": "hixia8pmi2v6",
      "text": "直史館",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，召試中書，加直史館，面賜五品服，判三司開拆司。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0z",
      "text": "右司諫",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "東封，進右司諫。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知鄧州",
      "place_id": "hixicl84l2h4",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋知鄧州。"
        }
      ]
    },
    {
      "office_id": "hixia8p7iosg",
      "text": "龍圖閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢龍圖閣待制、知審官院，再遷尚書工部郎中，使契丹。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "尚書工部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢龍圖閣待制、知審官院，再遷尚書工部郎中，使契丹。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知青州",
      "place_id": "hixicl84l2e5",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知白以朝廷制官，重內輕外，為引唐李嶠議遷臺閣典藩郡，乃自請補外，不許，遂命糾察在京刑獄，固請，知青州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "尚書工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "郊禮成，遷尚書工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "曾亦固請列知白下，乃加知白金紫光祿大夫，復為給事中、判禮儀院。"
        }
      ]
    },
    {
      "office_id": "hixia8nxmsxu",
      "text": "尚書右丞",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，進尚書右丞，為樞密副使，以工部尚書同中書門下平章事、會靈觀使、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，進尚書右丞，為樞密副使，以工部尚書同中書門下平章事、會靈觀使、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixi5wrbltsg",
      "text": "太傅",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十·張知白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為罷上巳宴，贈太傅、中書令。"
        }
      ]
    }
  ],
  "revision": "1.0.5",
