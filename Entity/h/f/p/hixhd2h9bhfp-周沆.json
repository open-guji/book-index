  "description": {
    "sources": [
      {
        "name": "《宋史·周沆傳》",
        "details": "卷331，傳首：周沆，字子真，青州益都人。"
      },
      {
        "title": "《陝西通志》卷54·名宦",
        "source_bid": "d59f2n7golxd",
        "details": "周沆益都人皇祐中趙元昊擾西陲詔舉近臣可通判陜西者丞相富弼以沆名聞通判鳯翔府去二十餘年民猶思之"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mnfojl",
      "text": "轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·周沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "湖南蠻唐、盤二族寇暴，殺居民，官軍數不利，以沆為轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8pmi2v6",
      "text": "直史館",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·周沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加直史館、知潭州。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyw",
      "text": "度支副使",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·周沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入為度支副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·周沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢天章閣待制、陝西都轉運使，改河北。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百三十一·周沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又徙河東轉運使，遷龍圖閣直學士、知慶州，召知通進銀臺司、判太常寺。"
        }
      ]
    }
  ],
