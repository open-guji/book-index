      {
        "name": "《宋史·杜衍傳》",
        "details": "卷310，傳首：杜衍，字世昌，越州山陰人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpu5",
      "text": "秘書省著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢進士甲科，補揚州觀察推官，改秘書省著作佐郎、知平遙縣。"
        }
      ]
    },
    {
      "office_id": "hixia8nm30ub",
      "text": "尚書祠部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "及罷歸，二州民邀留境上，曰：「何奪我賢太守也？」以太常博士提點河東路刑獄，遷尚書祠部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為三司戶部副使，擢天章閣待制、知江陵府。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未行，會河北乏軍費，選為都轉運使，遷工部郎中，不增賦於民而用足。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "尚書工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷尚書工部侍郎、知永興軍。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr6",
      "text": "龍圖閣學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元昊反，以太原要衝，加龍圖閣學士。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "start": 1039,
      "end": 1039,
      "date_text": "寶元二年",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "寶元二年，遷刑部侍郎、復知永興軍。"
        }
      ]
    },
    {
      "office_id": "hixia8osjaps",
      "text": "知開封府",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，權知開封府，權近聞衍名，莫敢干以私。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜同知樞密院事，改樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜同知樞密院事，改樞密副使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為河東宣撫使，拜吏部侍郎、樞密使。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同平章事",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜同平章事、集賢殿大學士兼樞密使。"
        }
      ]
    },
    {
      "office_id": "hixia8nk7lkz",
      "text": "太子太傅",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進太子太傅，賜其子同進士出身，又進太子太師。"
        }
      ]
    },
    {
      "office_id": "hixia8ma0h6q",
      "text": "太子太師",
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進太子太傅，賜其子同進士出身，又進太子太師。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxf",
      "text": "司徒",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十·杜衍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈司徒兼侍中，諡「正獻」。"
        }
      ]
    }
  ]
}
