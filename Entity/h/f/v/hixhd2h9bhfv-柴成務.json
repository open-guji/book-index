          "source_bid": "d59f2gonq7sy",
          "details": "改曹、單觀察推官，遷大理寺丞。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "陝西轉運副使",
      "kind": "充",
      "start": 980,
      "end": 980,
      "date_text": "太平興國五年",
      "sources": [
        {
