          "source_bid": "d59f2gonq7sy",
          "details": "太平興國五年，轉太常丞，充陝西轉運副使，賜緋，再遷殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "start": 980,
      "end": 980,
      "date_text": "太平興國五年",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國五年，轉太常丞，充陝西轉運副使，賜緋，再遷殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuf",
      "text": "戶部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "曆知果、蘇二州，就為兩浙轉運使，改戶部員外郎、直史館，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpue",
      "text": "光祿少卿",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太宗選郎官為少卿監，以成務為光祿少卿。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "京東轉運使",
      "start": 991,
      "end": 991,
      "date_text": "淳化二年",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳化二年，為京東轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "蜀寇平，使峽路安撫，改左諫議大夫、知河中府。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，遷給事中、知梓州。"
        }
      ]
    },
    {
      "office_id": "hixia8ndnm68",
      "text": "奉禮郎",
      "sources": [
        {
          "title": "《宋史》卷三百零六·柴成務傳",
          "source_bid": "d59f2gonq7sy",
          "details": "成務年六十六始有子，比卒，才六歲，授奉禮郎，名貽範，後為國子博士。"
        }
      ]
    },
    {
      "office_id": "hixia8omx0xs",
      "text": "國子博士",
      "sources": [
        {
