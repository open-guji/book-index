      "office_id": "hiximaw4ktg2",
      "text": "太僕寺丞",
      "start": 979,
      "end": 979,
      "date_text": "太平興國四年",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國四年，轉運使和峴薦其能，遷太僕寺丞，充度支巡官。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9c1",
      "text": "推官",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改太子右贊善大夫，轉殿中丞，充推官，拜監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改太子右贊善大夫，轉殿中丞，充推官，拜監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "河北轉運副使",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會詔下東封，與劉蟠同知泰山路轉運事，又爲河北轉運副使，湘經度供饋，以能幹聞。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfr",
      "text": "屯田員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "事集，加屯田員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgg",
      "text": "駕部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "雍熙中，召爲鹽鐵判官，改駕部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河北轉運使",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會議罷，復爲河北轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "眞宗即位，入爲右諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河北轉運使",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復充河北轉運使，屬郡民有斡釀，嵗輸課甚微，而不逞輩因之爲姦盜，湘奏廢之。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "start": 1000,
      "end": 1000,
      "date_text": "三年",
      "basis": "承上文年號咸平",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·索湘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，出知許州，徙荊南，復爲右諫議大夫、知廣州。"
        }
      ]
    }
  ],
