  "offices": [
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "時新建祕閣，命中書試作頌一首，擢著作佐郎。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳化中，吏部侍郎李至薦之，遷殿中丞，出知忠州。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981u",
      "text": "太子中允",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸平初，復為太子中允。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德初，內出遵度名，引對崇政殿，詔索所著文，召試舍人院，改太常丞、直史館。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuf",
      "text": "戶部員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改戶部員外郎，賜服金紫，又賚襲衣、犀帶、緡錢。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu4",
      "text": "吏部員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
          "details": "國史成，拜吏部員外郎，昇邸進封，改禮部郎中，充諮議參軍。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktft",
      "text": "禮部郎中",
      "sources": [
        {
          "title": "《宋史》卷四百四十一·崔遵度傳",
          "source_bid": "d59f2gonq7sy",
