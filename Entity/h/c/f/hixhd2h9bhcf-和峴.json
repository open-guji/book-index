      ]
    },
    {
      "office_id": "hiximaqdxpug",
      "text": "刑部員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·和峴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄拜刑部員外郎兼博士，仍判太常寺。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgq",
      "text": "司勳員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·和峴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "開寶初，遷司勳員外郎、權知泗州，判吏部南曹，歷夔、晉二州通判。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfv",
      "text": "主客郎中",
      "sources": [
