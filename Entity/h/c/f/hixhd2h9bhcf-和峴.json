      ]
    },
    {
      "office_id": "hiximaw4ktfv",
      "text": "主客郎中",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·和峴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "端拱初，上躬耕籍田，峴奉留司賀表至闕下，因以其所著《奉常集》五卷、《祕閣集》二十卷、《注釋武成王廟贊》五卷奏御，上甚嘉之，復授主客郎中，判太常寺兼禮儀院事。"
        }
      ]
    }
