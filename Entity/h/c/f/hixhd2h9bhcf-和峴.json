  "offices": [
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·和峴傳",
          "source_bid": "d59f2gonq7sy",
          "details": "建隆初，授太常博士，從祀南郊，贊導乘輿，進退閑雅。"
