          "source_bid": "d59f2ofs2u4h",
          "details": "再授長安尉，遷鴻臚丞。"
        }
      ]
    },
    {
      "office_id": "hiximd4offvh",
      "text": "司門員外郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "開元中，入為司門員外郎卒。"
        }
      ]
    },
    {
      "office_id": "hixi5v2mknb5",
      "text": "太常博士",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "時初克復，簿籍多失，禮文錯亂，乃以薦為太常博士，參典禮儀。"
        }
      ]
    },
    {
      "office_id": "hixi5wrblts4",
      "text": "判官",
      "start": 788,
      "end": 788,
      "date_text": "四年",
      "basis": "承上文年號貞元",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "四年，回紇和親，以檢校右僕射、刑部尚書關播充使，送鹹安公主入蕃，以薦為判官，轉殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32i",
      "text": "諫議大夫",
      "start": 795,
      "end": 795,
      "date_text": "十一年",
      "basis": "承上文年號貞元",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十一年，拜諫議大夫，仍充中館修撰。"
        }
      ]
    },
    {
      "office_id": "hixia8pv8q2o",
      "text": "秘書少監",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "薦為諫議月餘，改秘書少監。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "延齡排擯不已，會差使冊回紇毗伽懷信可汗及吊祭，乃命薦兼御史中丞，入回紇。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ge",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "二十年，吐蕃贊普死，以薦為工部侍郎、兼御史大夫，充入吐蕃吊祭使。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdz",
      "text": "史館修撰",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十九·張薦傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "薦自拾遺至侍郎，僅二十年，皆兼史館修撰。"
        }
      ]
    },
    {
      "office_id": "hixikfed18j7",
      "text": "鴻臚丞",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "八以制舉皆甲科，再調長安尉，遷鴻臚丞。"
        }
      ]
    },
    {
      "office_id": "hiximdfhd4ox",
      "text": "左拾遺",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "京師平，擢左拾遺。"
        }
      ]
    },
    {
      "office_id": "hixi5v2mknb5",
      "text": "太常博士",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "時更兵亂，禮物殘替，用薦為太常博士，參綴典儀，略如舊章。"
        }
      ]
    },
    {
      "office_id": "hixi5wrblts4",
      "text": "判官",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "刑部尚書關播持節送鹹安公主於回紇，以薦為判官。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdq",
      "text": "工部員外郎",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "還，遷工部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32i",
      "text": "諫議大夫",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "久之，擢諫議大夫，復為史館修撰。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdz",
      "text": "史館修撰",
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
          "details": "久之，擢諫議大夫，復為史館修撰。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g7",
      "text": "禮部尚書",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百六十一·張薦傳",
          "source_bid": "d59f2htqolj5",
