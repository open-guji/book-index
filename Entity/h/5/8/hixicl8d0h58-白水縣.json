        "details": "廣漢郡「白水。」"
      },
      {
        "name": "《新唐書》卷三十七〈地理志一〉",
        "details": "同州「白水，望。」"
      },
      {
        "name": "《晉書》卷十四〈地理志上〉",
        "details": "梓潼郡「白水。」"
      },
      {
        "name": "《清史稿》卷六十三〈地理志十〉",
        "details": "同州府「白水簡。府西北百三十里。明隸西安府。雍正三年改屬耀州，十三年來屬。東北：黃龍山。西北：秦山。」"
      },
      {
        "name": "《隋書》卷二十九〈地理志上〉",
        "details": "馮翊郡「白水。有五龍山、馬蘭山。」"
      },
      {
        "name": "《後漢書》志第二十三〈郡國五〉",
        "details": "廣漢郡「白水。」"
      }
