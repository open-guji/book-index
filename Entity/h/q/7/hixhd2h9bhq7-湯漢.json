  "offices": [
    {
      "office_id": "hiximaqdxpuk",
      "text": "祕書省校書郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "雖有鄭、衛之音，燕、趙之色，建章之麗，瓊林之積，亦獨何樂哉！」\n\n召試館職，遷祕書省校書郎。"
        }
      ]
    },
    {
      "office_id": "hixia8opexaa",
      "text": "祕書少監",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷太府少卿，升兼太子諭德，改祕書少監。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "乞休致，擢太常少卿，太子以書勉留。"
        }
      ]
    },
    {
      "office_id": "hixia8mpmcch",
      "text": "起居郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷起居郎兼侍讀，入奏，言：「願陛下持一敬心以正百度，則追養繼孝，所以報先帝者，必益致其隆，先意承志，所以事太母者，必益致其謹。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼權中書舍人，權兵部侍郎，升兼同修國史、實錄院同修撰兼直學士。"
        }
      ]
    },
    {
      "office_id": "hixia8oafj7l",
      "text": "華文閣待制",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累請致仕，授華文閣待制、知寧國府，賜金帶。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，又召為刑部侍郎兼侍讀，以龍圖閣待制知福州，福建安撫使。"
        }
      ]
    },
    {
      "office_id": "hixia8m69mo5",
      "text": "華文閣學士",
      "sources": [
        {
          "title": "《宋史》卷四百三十八·湯漢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進華文閣學士，以端明殿學士致仕。"
        }
      ]
    }
  ]
