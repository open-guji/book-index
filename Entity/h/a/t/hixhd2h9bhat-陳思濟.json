    },
    {
      "office_id": "hixi5v2m9erm",
      "text": "監察御史",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "遷承務郎、同知高唐州事，以績最聞，拜監察御史。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknx8",
      "text": "奉訓大夫",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "授奉訓大夫、知沁州，為政簡要，不務苛察。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknx1",
      "text": "中順大夫",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "遷中順大夫、同知紹興路總管府事，承檄讞獄。"
        }
      ]
    },
    {
      "office_id": "hiximwwsgydc",
      "text": "少中大夫",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "二十三年，加少中大夫、同知浙東道宣慰司事。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknwv",
      "text": "嘉議大夫",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "兩淮鹽課不敷，授嘉議大夫、兩淮都轉運使，奸弊盡革，商賈通行，歲課以足。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxd",
      "text": "池州路總管",
      "place_id": "hixicl87e7ae",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "擢嶺北湖南道肅政廉訪使，改池州路總管。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknwu",
      "text": "通議大夫",
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "累遷通議大夫、僉河南江北等處行中書省事。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknwt",
      "text": "正議大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《元史》卷一百六十八·陳思濟傳",
          "source_bid": "d59f2njivtog",
          "details": "贈正議大夫、吏部尚書、上輕車都尉，追封潁川郡侯，諡文肅。"
        }
      ]
    }
  ]
