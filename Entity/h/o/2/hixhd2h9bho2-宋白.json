  "offices": [
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋拜中書舍人，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hixia8newkcg",
      "text": "史館修撰",
      "kind": "充",
      "start": 980,
      "end": 980,
      "date_text": "太平興國五年",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國五年，與程羽同知貢舉，俄充史館修撰、判館事。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "端拱初，加禮部侍郎，又知貢舉。"
        }
      ]
    },
    {
      "office_id": "hixia8njl4hs",
      "text": "衛尉卿",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，抗疏自陳，有「來日苦少，去日苦多」之語，太宗覽而憫之，召還，為衛尉卿，俄復拜為禮部侍郎，修國史。"
        }
      ]
    },
    {
      "office_id": "hixia8orll36",
      "text": "翰林學士承旨",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至道初，為翰林學士承旨。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "start": 996,
      "end": 996,
      "date_text": "二年",
      "basis": "承上文年號至道",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，遷戶部侍郎，俄兼祕書監。"
        }
      ]
    },
    {
      "office_id": "hixia8oa4ao1",
      "text": "祕書監",
      "kind": "兼",
      "start": 996,
      "end": 996,
      "date_text": "二年",
      "basis": "承上文年號至道",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，遷戶部侍郎，俄兼祕書監。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，改吏部侍郎、判昭文館。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptu",
      "text": "吏部尚書",
      "sources": [
        {
          "title": "《宋史》卷四百三十九·宋白傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再上表辭，乃以兵部尚書致仕，因就宰臣訪問其資產，虞其匱乏，時白繼母尚無恙，上東封，白肩輿辭於北苑，召對久之，進吏部尚書，賜帛五十匹。"
        }
      ]
    }
  ]
