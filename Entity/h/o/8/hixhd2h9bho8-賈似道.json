          "source_bid": "d59f2gonq7sy",
          "details": "三年，加戶部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8omx0xu",
      "text": "京湖制置使",
      "sources": [
        {
          "title": "《宋史》卷四百七十四·賈似道傳",
          "source_bid": "d59f2gonq7sy",
          "details": "一歲中，再遷京湖制置使兼知江陵府，調度賞罰，得以便宜施行。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0w",
      "text": "寶文閣學士",
