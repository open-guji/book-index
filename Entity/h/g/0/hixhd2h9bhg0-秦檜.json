        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6u",
      "text": "左司諫",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "御史中丞李回、翰林承旨吳幵共薦檜，拜殿中侍御史，遷左司諫。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，除御史中丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptw",
      "text": "禮部尚書",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁未，拜禮部尚書，賜以銀帛。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹興元年二月，除參知政事。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八月，拜右僕射、同中書門下平章事兼知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixia8mpmcch",
      "text": "起居郎",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七月，一止出臺，除起居郎，蓋自叛其說，識者笑之。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八月，檜罷，乃為觀文殿學士、提舉江州太平觀。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二月，復資政殿學士，仍舊宮祠。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "六月，除觀文殿學士、知溫州。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年三月，拜右僕射、同中書門下平章事兼樞密使。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "sources": [
        {
          "title": "《宋史》卷四百七十三·秦檜傳",
          "source_bid": "d59f2gonq7sy",
