  "description": {
    "sources": [
      {
        "name": "《宋史·趙槩傳》",
        "details": "卷318，傳首：趙槩，字叔平，南京虞城人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o8k3y8",
      "text": "集賢校理",
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "中進士第，通判海州，為集賢校理、開封府推官。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知滁州",
      "place_id": "hixicl857jlp",
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知滁州，山東有寇李二過境上，告人曰：「我東人也，公嘗為青州，民愛之如父母，我不忍犯。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "槩聞，請郡，除天章閣待制、糾察在京刑獄，修遂知制誥。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "求知蘇州，終母喪，入為翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢樞密使、參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "熙寧初，拜觀文殿學士、知徐州。"
        }
      ]
    },
    {
      "office_id": "hixia8ma0h6q",
      "text": "太子太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十八·趙槩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太子太師，諡曰康靖。"
        }
      ]
    }
  ],
  "revision": "1.0.2",
