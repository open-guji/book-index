          "source_bid": "d59f2ofs2u4h",
          "details": "五年，遷諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8m8gagz",
      "text": "司農卿",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十七·王彥威傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "未幾，改司農卿。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "青州刺史",
      "place_id": "hixicl86595e",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十七·王彥威傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "既秉政，授青州刺史、兼御史大夫，充平盧軍節度、淄青等觀察使。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ga",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百五十七·王彥威傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "會昌中，入為兵部侍郎，歷方鎮，檢校兵部尚書。"
        }
      ]
    },
    {
      "office_id": "hixia8oehm9t",
      "text": "僕射",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百五十七·王彥威傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "卒，贈僕射，謚曰靖。"
        }
      ]
    }
