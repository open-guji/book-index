  "offices": [
    {
      "office_id": "hixia8mum51d",
      "text": "知會稽縣",
      "place_id": "hixicl857jic",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·曾公亮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士甲科，知會稽縣。"
        }
      ]
    },
    {
      "office_id": "hixia8m92rk2",
      "text": "國子監直講",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·曾公亮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，為國子監直講，改諸王府侍講。"
        }
      ]
    },
    {
      "office_id": "hixia8o8k3y8",
      "text": "集賢校理",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·曾公亮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲滿，當用故事試館職，獨獻所為文，授集賢校理、天章閣侍講、修起居注。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·曾公亮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢天章閣待制，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·曾公亮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂知制誥兼史館修撰，為翰林學士、判三班院。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·曾公亮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，擢給事中、參知政事。"
