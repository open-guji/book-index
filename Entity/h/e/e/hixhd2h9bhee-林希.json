  "offices": [
    {
      "office_id": "hixia8obohdu",
      "text": "館閣校勘",
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士，調涇縣主簿，為館閣校勘、集賢校理。"
        }
      ]
    },
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲餘，通判秀州，復知太常禮院，遷著作佐郎、禮部郎中。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元祐初，歷秘書少監、起居舍人、起居郎，進中書舍人。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以集賢殿修撰知蘇州，更宣、湖、潤、杭、亳五州，加天章閣待制。"
        }
      ]
    },
    {
      "office_id": "hixia8owwmbk",
      "text": "寶文閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹聖初，進寶文閣直學士、知成都府。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為中書舍人，修《神宗實錄》兼侍讀。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百四十三·林希傳",
          "source_bid": "d59f2gonq7sy",
          "details": "追贈資政殿學士，諡曰「文節」。"
        }
      ]
    }
  ],
