      "office_id": "hixia8mep1c2",
      "text": "陝西轉運判官",
      "sources": [
        {
          "title": "《宋史》卷三百三十二·遊師雄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "將厚嘗師雄，言者猶以為邀功生事，止遷一官，為陝西轉運判官、提點秦鳳路刑獄。"
        }
      ]
    },
    {
      "office_id": "hixia8o8k3y8",
      "text": "集賢校理",
      "sources": [
        {
          "title": "《宋史》卷三百三十二·遊師雄傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入拜祠部員外郎，加集賢校理，為陝西轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "陝西轉運使",
      "sources": [
        {
