        "name": "《宋史·丁謂傳》",
        "details": "卷283，傳首：丁謂，字謂之，後更字公言，蘇州長洲人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "start": 992,
      "end": 992,
      "date_text": "淳化三年",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳化三年，登進士甲科，為大理評事、通判饒州。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "轉運使",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，上茶鹽利害，遂為轉運使，除三司戶部判官。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmz0",
      "text": "三司戶部判官",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，上茶鹽利害，遂為轉運使，除三司戶部判官。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu8",
      "text": "尚書工部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還奏稱旨，領峽路轉運使，累遷尚書工部員外郎，會分川峽為四路，改夔州路。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，擢知制誥，判吏部流內銓。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知鄆州",
      "place_id": "hixifx69t1qb",
      "start": 1007,
      "end": 1007,
      "date_text": "景德四年",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德四年，契丹犯河北，真宗幸澶淵，以謂知鄆州兼齊、濮等州安撫使，提舉轉運兵馬巡檢事。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "start": 1008,
      "end": 1008,
      "date_text": "明年",
      "basis": "承上文年號景德",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明年，召為右諫議大夫、權三司使。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋加樞密直學士。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "乃以謂為修玉清昭應宮使，復為天書扶侍使，遷給事中，真拜三司使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "尚書禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷尚書禮部侍郎，進戶部，參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "平江軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歷工、刑、兵三部尚書，再為天書儀衛副使，拜平江軍節度使、知昇州。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知河南府",
      "place_id": "hixicl84l2i0",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝因格前制不下，乃罷謂為戶部尚書，迪為戶部侍郎；尋以謂知河南府，迪知鄆州。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxf",
      "text": "司徒",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，進司徒兼侍中，為山陵使。"
        }
      ]
    },
    {
      "office_id": "hixia8oa4ao1",
      "text": "秘書監",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·丁謂傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明道中，授秘書監致仕，居光州，卒。"
        }
      ]
    }
  ],
  "revision": "1.0.4",
  "revised_at": "2026-11-12"
}
