  "dynasty": "北宋",
  "dynasty_basis": "據正史本傳",
  "period": "song",
  "period_basis": "據 dynasty「北宋」歸併",
  "title_or_office": "開封尉",
  "description": {
    "text": "范純仁之子。父卒推遺澤於幼弟；紹聖中為開封尉，按向氏慈雲寺拓地皆民業，蔡京坐罰金；京當國，誣其矯撰父遺表，與李之儀等下獄，身任其事。工詩，著《荀裏退居編》。",
    "sources": [
      {
        "name": "《宋史·范純仁傳》",
        "details": "卷314，附父傳"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "治平中，擢江東轉運判官，召為殿中侍御史，遷侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "治平中，擢江東轉運判官，召為殿中侍御史，遷侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜兵部員外郎，兼起居舍人、同知諫院。"
        }
      ]
    },
    {
      "office_id": "hixia8p4pjwh",
      "text": "判國子監",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂求罷諫職，改判國子監，去意愈確。"
        }
      ]
    },
    {
      "office_id": "hixia8mcidj4",
      "text": "直龍圖閣",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未至，加直龍圖閣、知慶州。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為右諫議大夫，以親嫌辭，改天章閣待制兼侍講，除給事中。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為右諫議大夫，以親嫌辭，改天章閣待制兼侍講，除給事中。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "尚書右僕射",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，拜尚書右僕射兼中書侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk2",
      "text": "大學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，加大學士、知太原府。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，復拜右僕射。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr5",
      "text": "開府儀同三司",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范純仁傳",
          "source_bid": "d59f2gonq7sy",
          "details": "詔賻白金三十兩，敕許、洛官給其葬，贈開府儀同三司，諡曰「忠宣」，御書碑額曰「世濟忠直之碑」。"
        }
      ]
    }
  ],
