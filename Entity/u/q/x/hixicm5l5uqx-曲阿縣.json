  "description": {
    "sources": [
      {
        "name": "《後漢書》志第二十二〈郡國四〉",
        "details": "吳郡「曲阿。」"
      },
      {
        "name": "《宋書》卷三十五〈州郡志一〉",
        "details": "吳郡「曲阿令，本名雲陽，秦始皇改曰曲阿。吳嘉禾三年，復曰雲陽。」"
      },
      {
        "name": "《漢書》卷二十八上〈地理志上〉",
        "details": "會稽郡「曲阿，故云陽，莽曰風美。」"
      },
      {
        "name": "《隋書》卷三十一〈地理志下〉",
        "details": "江都郡「曲阿。有武進縣，梁改爲蘭陵，開皇九年併入。」"
      },
      {
        "name": "《晉書》卷十五〈地理志下〉",
        "details": "毗陵郡「曲阿。故云陽。」"
      }
    ]
  },
