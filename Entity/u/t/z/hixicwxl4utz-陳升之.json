        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "治平二年，復拜樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "神宗立，以母老請郡，為觀文殿學士、知越州。"
        }
