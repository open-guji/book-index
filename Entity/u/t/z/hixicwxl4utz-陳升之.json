  "description": {
    "text": "建州建陽人。初名旭，避神宗嫌名改。為知諫院五年，上數十百事；歷樞密副使；熙寧元年知樞密院，同制置三司條例司，引為王安石之助，拜相後即求解條例司，世譏為「筌相」；以鎮江軍節度使、同平章事判揚州，封秀國公。",
    "sources": [
      {
        "name": "《宋史·陳升之傳》",
        "details": "卷312"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士，歷知封州、漢陽軍，入為監察御史、右司諫，改起居舍人、知諫院。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士，歷知封州、漢陽軍，入為監察御史、右司諫，改起居舍人、知諫院。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢天章閣待制、河北都轉運使，知瀛州、真定府，加龍圖閣直學士，復知諫院。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷樞密直學士、知開封府。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲餘，拜樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·陳升之傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以升之為資政殿學士、知定州，徙太原府。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "start": 1065,
      "end": 1065,
      "date_text": "治平二年",
