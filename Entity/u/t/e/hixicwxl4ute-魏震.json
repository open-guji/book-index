  "title_or_office": "東上閤門使",
  "dates": {
    "death": 998,
    "basis": "據本傳：咸平元年卒"
  },
  "description": {
    "text": "祖浩，父鉞蒲臺令。姚恕薦於太宗藩邸。雍熙初獻溫州瑞木詩賦，拜崇儀副使；北伐為幽州西北路鈐轄，下飛狐、蔚州；端拱以後歷知廬、澶、鳳、洪州，進東上閤門使，知定、代二州兼行營鈐轄。",
    "sources": [
      {
        "name": "《宋史·魏震傳》",
        "details": "卷309"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3l3",
      "text": "崇儀副使",
      "sources": [
        {
          "title": "《宋史》卷三百零九·魏震傳",
          "source_bid": "d59f2gonq7sy",
          "details": "雍熙初，溫州進瑞木成文，震作詩賦以獻，拜崇儀副使，賜白金二千兩，掌內弓箭庫。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知保州",
      "place_id": "hixicl84wb0x",
      "sources": [
        {
          "title": "《宋史》卷三百零九·魏震傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復知保州，移秦州鈐轄。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知廬州",
      "place_id": "hixicl85iryx",
      "sources": [
        {
          "title": "《宋史》卷三百零九·魏震傳",
          "source_bid": "d59f2gonq7sy",
          "details": "端拱中，召拜西上閤門使，俄知廬州，徙澶州。"
        }
      ]
    }
  ],
