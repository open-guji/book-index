  "description": {
    "text": "王介之子，從真德秀學。以父蔭補官，嘉定十二年進士；歷知鎮江府、沿江制置使，寶祐二年以端明殿學士簽書樞密院事，封吳郡侯，卒。",
    "sources": [
      {
        "name": "《宋史·王埜傳》",
        "details": "卷420"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxptw",
      "text": "禮部尚書",
      "sources": [
        {
          "title": "《宋史》卷四百二十·王埜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜禮部尚書，奏十事，終之曰：「陛下一心，十事之綱領也。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "江西轉運副使",
      "sources": [
        {
          "title": "《宋史》卷四百二十·王埜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為江西轉運副使、知隆興府，繼有它命，時以米綱不便，就湖口造轉般倉，請事畢受代。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "start": 1254,
      "end": 1254,
      "date_text": "寶祐二年",
      "sources": [
        {
          "title": "《宋史》卷四百二十·王埜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "寶祐二年，拜端明殿學士、簽書樞密院事，封吳郡侯。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知建寧府",
      "place_id": "hixicl85u0jk",
      "sources": [
        {
          "title": "《宋史》卷四百二十·王埜傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知建寧府，創建安書院，祠熹，以德秀配。"
        }
      ]
    }
