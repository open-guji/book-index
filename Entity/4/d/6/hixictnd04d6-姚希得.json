      "text": "太府寺丞",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·姚希得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為國子監丞，遷太府寺丞，時暫書擬金部文字兼沂靖王府教授。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cc",
      "text": "著作郎",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·姚希得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進祕書丞，尋遷著作郎，授江西提舉常平。"
        }
      ]
    },
    {
      "office_id": "hixia8p1wf0g",
      "text": "直祕閣",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·姚希得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂提點刑獄，加直祕閣。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg8",
      "text": "度支員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·姚希得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，加度支員外郎，尋直寶章閣，移治贛州。"
        }
      ]
    },
    {
      "office_id": "hixia8nc3fgg",
      "text": "直徽猷閣",
      "sources": [
