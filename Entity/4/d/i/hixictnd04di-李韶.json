          "source_bid": "d59f2gonq7sy",
          "details": "以廉勤薦，遷主管三省架閣文字，遷太學正，改太學博士。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56r",
      "text": "國子監丞",
      "sources": [
        {
          "title": "《宋史》卷四百二十三·李韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入為國子監丞，改知泉州兼市舶。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷四百二十三·李韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，拜右正言。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷四百二十三·李韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "乞解言職，拜殿中侍御史，辭，不允。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "工部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷四百二十三·李韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會祀明堂，雷電，免二相，韶權工部侍郎、正言，遷起居舍人。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷四百二十三·李韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會祀明堂，雷電，免二相，韶權工部侍郎、正言，遷起居舍人。"
        }
      ]
    },
    {
