      "text": "太府寺丞",
      "sources": [
        {
          "title": "《宋史》卷四百一十九·陳韡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷將作監丞，又遷太府寺丞，差知真州、淮東提點刑獄。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgl",
      "text": "倉部員外郎",
