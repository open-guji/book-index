        {
          "title": "《宋史》卷四百一十九·陳韡傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷宗正寺丞、權工部郎中，改倉部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知南劍州",
