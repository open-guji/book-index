  "description": {
    "text": "鄭州管城人，石介期以公輔。擢進士第，從平貝州言脅從罔治；神宗在潁邸為侍講、侍讀；諫种諤取綏州，論王安石狷狹不可為相，極陳青苗不便；元豐中同知樞密院，諫西征；元祐二年拜門下侍郎，復知樞密院事，贈開府儀同三司。",
    "sources": [
      {
        "name": "《宋史·孫固傳》",
        "details": "卷341"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nu76yr",
      "text": "秘書丞",
      "sources": [
        {
          "title": "《宋史》卷三百四十一·孫固傳",
          "source_bid": "d59f2gonq7sy",
          "details": "轉霍邑令，遷秘書丞，為審刑詳議官。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百四十一·孫固傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至即位，擢工部郎中、天章閣待制、知通進銀臺司。"
        }
      ]
    },
    {
      "office_id": "hixigfk9n8xs",
      "text": "少府監",
      "kind": "判",
      "sources": [
        {
          "title": "《宋史》卷三百四十一·孫固傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還知審刑院，復領銀臺封駁兼侍讀，判少府監。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百四十一·孫固傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改太中大夫、樞密副使，進知院事，以疾避位，拜觀文殿學士、知河陽，尋提舉嵩山崇福宮。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu9",
      "text": "門下侍郎",
      "start": 1087,
      "end": 1087,
      "date_text": "元祐二年",
      "sources": [
        {
          "title": "《宋史》卷三百四十一·孫固傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元祐二年，召除侍讀、提舉中太一宮，遂拜門下侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegoy",
      "text": "知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百四十一·孫固傳",
          "source_bid": "d59f2gonq7sy",
          "details": "固感激，強起視事，復知樞密院事，累官右光祿大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8mfmqyq",
      "text": "右光祿大夫",
      "sources": [
