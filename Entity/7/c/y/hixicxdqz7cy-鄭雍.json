  "description": {
    "text": "襄邑人，進士甲科。韓琦上其文，召試秘閣校理、知太常禮院；熙豐間靜默自守；宣仁臨政擢起居郎、中書舍人；為御史中丞，劾劉摯威福自恣及其黨三十人；拜尚書右丞、左丞；紹聖中以白帖事附章惇，終坐元祐黨奪職。",
    "sources": [
      {
        "name": "《宋史·鄭雍傳》",
        "details": "卷342"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o5qz2b",
      "text": "知池州",
      "place_id": "hixicl85is0k",
      "sources": [
        {
          "title": "《宋史》卷三百四十二·鄭雍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "英宗之喪，論宗室不當嫁娶，與時相忤，通判峽州，知池州，復還太常禮院，歷開封府判官。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷三百四十二·鄭雍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "宣仁后知其賢，及臨政，擢為起居郎，進中書舍人。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百四十二·鄭雍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "使契丹還，徙右諫議大夫，言：「朝廷重內輕外，選用牧伯，罕輟從班，以閥閱輕淺者充員，不復為來日慮。"
        }
      ]
    },
    {
      "office_id": "hixia8os826b",
      "text": "左丞",
      "sources": [
        {
          "title": "《宋史》卷三百四十二·鄭雍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜尚書右丞，改左丞。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百四十二·鄭雍傳",
          "source_bid": "d59f2gonq7sy",
          "details": "政和中，復資政殿學士。"
        }
      ]
    }
  ],
