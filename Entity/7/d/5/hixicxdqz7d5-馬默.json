  "native_place_basis": "《宋史》卷344本傳著錄「單州成武人」",
  "title_or_office": "寶文閣待制",
  "description": {
    "text": "單州成武人，從石介學。登進士第，知須城縣；治平中為監察御史裏行，論濮議；知徐州革利國監之虐；元祐初為河東轉運使，奏不棄葭蘆、吳堡二砦；歷戶部侍郎、河北都轉運使，主北流；紹聖時坐附司馬光落職，卒年八十。",
    "sources": [
      {
        "name": "《宋史·馬默傳》",
        "details": "卷344"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mum51d",
      "text": "知須城縣",
      "place_id": "hixicl84l2g8",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "登進士第，調臨濮尉，知須城縣。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyy",
      "text": "三司鹽鐵判官",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "其後蘇軾知登州，父老迎於路曰：「公為政愛民，得如馬使君乎？」\n\n徙知曹州，召為三司鹽鐵判官。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "廣西轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改廣西轉運使，會安化等蠻歲饑內寇，默上平蠻方略，以為「勝負不在兵而在將。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知徐州",
      "place_id": "hixicl84l2fx",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以疾求歸，知徐州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpua",
      "text": "司農少卿",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為司農少卿。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河東轉運使",
      "place_id": "hixiclu1dr0x",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除河東轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "工部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入拜衛尉卿，權工部侍郎，轉戶部。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3k",
      "text": "河北都轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "告老，以寶文閣待制復知徐州，改河北都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr5",
      "text": "開府儀同三司",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百四十四·馬默傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹興中，以其子純請，贈開府儀同三司，加贈太保。"
        }
      ]
    }
  ],
