  "description": {
    "text": "元和初進士、宏辭，為李逢吉所厚，驟拜御史中丞，道遇左僕射李絳不避；太和中漏宋申錫謀於王守澄；李訓以為河東節度使，令募兵，甘露之變敗，族誅。",
    "sources": [
      {
        "name": "《新唐書·列傳第一百零四》",
        "details": "卷179"
      },
      {
        "name": "《舊唐書·列傳第一百十九》",
        "details": "卷169"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o6zx8i",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "元和中，入朝為監察御史，再遷起居舍人，副鄭覃宣慰於鎮州。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ge",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "逢吉素惡絳之直，天子雖許行舊儀，中書竟無處分，乃罷璠中丞，遷工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g1",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "三年，改吏部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g5",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "九年五月，遷戶部尚書、判度支。"
        }
      ]
    }
  ],
