  "title_or_office": "河東節度使",
  "dates": {
    "death": 835,
    "basis": "據《新唐書》本傳"
  },
  "description": {
    "text": "元和初進士、宏辭，為李逢吉所厚，驟拜御史中丞，道遇左僕射李絳不避；太和中漏宋申錫謀於王守澄；李訓以為河東節度使，令募兵，甘露之變敗，族誅。",
    "sources": [
      {
        "name": "《新唐書·列傳第一百零四》",
        "details": "卷179"
      },
      {
        "name": "《舊唐書·列傳第一百十九》",
        "details": "卷169"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o6zx8i",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "元和中，入朝為監察御史，再遷起居舍人，副鄭覃宣慰於鎮州。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ge",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "逢吉素惡絳之直，天子雖許行舊儀，中書竟無處分，乃罷璠中丞，遷工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g1",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "三年，改吏部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g5",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十九·王璠傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "九年五月，遷戶部尚書、判度支。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszdf",
      "text": "職方郎中",
      "sources": [
        {
          "title": "《新唐書》卷一百七十九·王璠傳",
          "source_bid": "d59f2htqolj5",
          "details": "長慶末，擢職方郎中，知制誥。"
        }
      ]
    },
    {
      "office_id": "hixikfedch22",
      "text": "尚書右丞",
      "sources": [
        {
          "title": "《新唐書》卷一百七十九·王璠傳",
          "source_bid": "d59f2htqolj5",
          "details": "入為尚書右丞，再遷京兆尹。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegow",
      "text": "浙西觀察使",
      "place_id": "hiximxkt4c91",
      "sources": [
        {
          "title": "《新唐書》卷一百七十九·王璠傳",
          "source_bid": "d59f2htqolj5",
          "details": "出為浙西觀察使。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g5",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《新唐書》卷一百七十九·王璠傳",
          "source_bid": "d59f2htqolj5",
          "details": "李訓得幸，璠於逢吉舊故，故薦之，復召為左丞，拜戶部尚書，判度支，封祁縣男。"
        }
      ]
    },
    {
      "office_id": "hixia8pjdpfl",
      "text": "河東節度使",
      "place_id": "hiximxkt4c9g",
      "sources": [
        {
          "title": "《新唐書》卷一百七十九·王璠傳",
          "source_bid": "d59f2htqolj5",
          "details": "訓將誅宦人，乃授河東節度使，已而敗。"
        }
      ]
    }
  ],
