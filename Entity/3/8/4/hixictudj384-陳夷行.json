  "title_or_office": "門下侍郎、同中書門下平章事",
  "description": {
    "text": "其先江左諸陳，世客潁川。進士及第，為翰林學士、莊恪太子侍讀；開成二年同平章事，與楊嗣復、李玨不合；武宗時再相，以足疾罷為太子太保，終河中節度使。",
    "sources": [
      {
        "name": "《新唐書·列傳第一百零六》",
        "details": "卷181"
      },
      {
        "name": "《舊唐書·列傳第一百二十三》",
        "details": "卷173"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nm30u8",
      "text": "起居郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "太和三年，入為起居郎、史館修撰，預修《憲宗實錄》。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g2",
      "text": "吏部郎中",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "五年，遷吏部郎中。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32i",
      "text": "諫議大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "上召對，面賜緋衣牙笏，遷諫議大夫、知制誥，余職如故。"
        }
      ]
    },
    {
      "office_id": "hixikfed18he",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "九年八月，改太常少卿，知制誥、學士侍講如故。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g0",
      "text": "吏部尚書",
      "kind": "守",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋罷知政事，守吏部尚書。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "華州刺史",
      "place_id": "hixicl84waxh",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "四年九月，檢校禮部尚書，出為華州刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "七月自華召入，復為中書侍郎、平章事。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr7",
      "text": "司徒",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百七十三·陳夷行傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "卒，贈司徒。"
        }
      ]
    },
    {
      "office_id": "hixia8ooh7nk",
      "text": "侍讀",
      "kind": "兼",
      "sources": [
        {
          "title": "《新唐書》卷一百八十一·陳夷行傳",
          "source_bid": "d59f2htqolj5",
          "details": "莊恪太子在東宮，夷行兼侍讀，五日一謁，為太子講說。"
        }
      ]
    },
    {
      "office_id": "hixia8nxy1hc",
      "text": "同中書門下平章事",
      "start": 837,
      "end": 837,
      "date_text": "開成二年",
      "sources": [
        {
          "title": "《新唐書》卷一百八十一·陳夷行傳",
          "source_bid": "d59f2htqolj5",
          "details": "開成二年，進同中書門下平章事。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gf",
      "text": "門下侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百八十一·陳夷行傳",
          "source_bid": "d59f2htqolj5",
          "details": "進門下侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "華州刺史",
      "place_id": "hixicl84waxh",
      "sources": [
        {
          "title": "《新唐書》卷一百八十一·陳夷行傳",
          "source_bid": "d59f2htqolj5",
          "details": "是時，雖天子亦惡其太過，恩禮遂衰，罷為吏部尚書，尋拜華州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3er",
      "text": "御史大夫",
      "sources": [
        {
          "title": "《新唐書》卷一百八十一·陳夷行傳",
          "source_bid": "d59f2htqolj5",
          "details": "武宗即位，召為御史大夫，俄還門下侍郎平章事，進位尚書左仆射。"
        }
      ]
    }
  ],
