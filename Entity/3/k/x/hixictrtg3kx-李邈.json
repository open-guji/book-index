      "sources": [
        {
          "title": "《宋史》卷四百四十七·李邈傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改主管馬軍公事、權樞密副都承旨，出爲河北西路制置使。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "青州觀察使",
      "place_id": "hixicl84l2e5",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·李邈傳",
          "source_bid": "d59f2gonq7sy",
          "details": "後二日，落階，拜青州觀察使，仍知府事。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知滄州",
