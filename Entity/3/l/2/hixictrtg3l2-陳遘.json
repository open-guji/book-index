        "details": "陳遘：宋史本傳字亨伯永州人登進士第宣和二年方臘亂加龍圖閣直學士經制七路治于杭劾"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mum51d",
      "text": "知莘縣",
      "place_id": "hixicl84wawo",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·陳遘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知莘縣，爲治有績，魏尹蔣之奇、馮京、許將交薦之。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "廣西轉運判官",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·陳遘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "畢喪，爲廣西轉運判官。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·陳遘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄擢給事中，會商英免相。"
        }
      ]
    },
    {
      "office_id": "hixia8mcidj4",
      "text": "直龍圖閣",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·陳遘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以直秘閣爲河北轉運使，加直龍圖閣，徙陝西。"
        }
      ]
    },
    {
      "office_id": "hixia8podi4h",
      "text": "延康殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·陳遘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙河北都轉運使，進延康殿學士，歷知中山、真定、河間府。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百四十七·陳遘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "欽宗立，加資政殿學士，積官至光祿大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8mode6b",
