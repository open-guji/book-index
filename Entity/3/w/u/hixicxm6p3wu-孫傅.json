    },
    {
      "office_id": "hixia8nxmsxu",
      "text": "尚書右丞",
      "sources": [
        {
          "title": "《宋史》卷三百五十三·孫傅傳",
          "source_bid": "d59f2gonq7sy",
          "details": "十一月，拜尚書右丞，俄改同知樞密院。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr5",
      "text": "開府儀同三司",
