  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·燕肅傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為監察御史，準方知河南，奏留之。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·燕肅傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿中侍御史、提點廣南西路刑獄，遷侍御史，徙廣南東路。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·燕肅傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢龍圖閣待制、權知審刑院、知梓州，還，同糾察在京刑獄，再判刑部，累遷左諫議大夫、知亳州，徙青州。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·燕肅傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進龍圖閣直學士、知潁州，徙鄧州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·燕肅傳",
          "source_bid": "d59f2gonq7sy",
          "details": "官至禮部侍郎致仕，卒。"
        }
      ]
    }
  ],
