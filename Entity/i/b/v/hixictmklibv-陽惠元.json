  "offices": [
    {
      "office_id": "hixigfkaw740",
      "text": "殿中監",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百四十四·陽惠元傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "惠元男尚食奉禦晟，贈殿中監，左衛兵曹參軍皓贈邠州刺史，褒死難也。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "易州刺史",
      "place_id": "hixicl89w3m1",
      "sources": [
        {
          "title": "《新唐書》卷一百五十六·陽惠元傳",
          "source_bid": "d59f2htqolj5",
          "details": "憲宗嘉之，遷易州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3er",
      "text": "御史大夫",
      "sources": [
        {
          "title": "《新唐書》卷一百五十六·陽惠元傳",
          "source_bid": "d59f2htqolj5",
          "details": "進御史大夫，合邕、容兩管為一道。"
        }
      ]
    }
