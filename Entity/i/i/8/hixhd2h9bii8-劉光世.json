  "description": {
    "sources": [
      {
        "name": "《宋史·劉光世傳》",
        "details": "卷369，傳首：劉光世，字平叔，保安軍人，延慶次子。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mv8m4h",
      "text": "耀州觀察使",
      "place_id": "hixicl857jfe",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賊平，授耀州觀察使，升鄜延路兵馬鈐轄。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6h",
      "text": "奉國軍承宣使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "時有事燕薊，光世從延慶取易州，授奉國軍承宣使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "奉國軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "斬山東賊李昱，遷奉國軍節度使。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0x",
      "text": "檢校少傅",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加檢校少傅。"
        }
      ]
    },
    {
      "office_id": "hixia8p0ngu8",
      "text": "檢校太保",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋加檢校太保、殿前都指揮使。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至行在，遷太尉、御營副使。"
        }
      ]
    },
    {
      "office_id": "hixia8ooh7nn",
      "text": "江東宣撫使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "命光世為江東宣撫使，守太平及池州，受杜充節制。"
        }
      ]
    },
    {
      "office_id": "hixia8oygt1e",
      "text": "浙西安撫大使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召赴行在，授浙西安撫大使、知鎮江府。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "寧武軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "右諫議大夫黎確疏其擇便求佚，中外所憤，帝釋不問，加寧武軍節度使、開府儀同三司以遣之。"
        }
      ]
    },
    {
      "office_id": "hiximd7hkbuo",
      "text": "少保",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "金兵退，光世入覲，遷少保。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "保靜軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "劉豫築劉龍城以窺淮西，光世遣王師晟破之，加保靜軍節度使，遂領三鎮。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "少師",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜少師，充萬壽觀使，奉朝請，封榮國公，賜甲第一區，以兵歸都督府。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6s",
      "text": "萬壽觀使",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜少師，充萬壽觀使，奉朝請，封榮國公，賜甲第一區，以兵歸都督府。"
        }
      ]
    },
    {
      "office_id": "hixia8p0ngu8",
      "text": "太保",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "十年，金人圍順昌，拜太保，為三京招撫處置使，以援劉錡。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6s",
      "text": "萬壽觀使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "光世入見，為萬壽觀使，改封楊國公。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百六十九·劉光世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太師，官其子孫、甥侄十四人，諡「武僖」。"
        }
      ]
    }
  ],
  "revision": "1.0.5",
