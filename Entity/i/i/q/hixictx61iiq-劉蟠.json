      "office_id": "hixia8mnfojl",
      "text": "轉運使",
      "sources": [
        {
          "title": "《宋史》卷二百七十六·劉蟠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國初，就遷倉部員外郎，改轉運使，歲漕江東米四百萬斛以給京師，頗為稱職。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgg",
      "text": "駕部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百七十六·劉蟠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "秩滿，部內僧道乞留，詔許再任，賜金紫，改駕部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
