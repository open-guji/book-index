      "office_id": "hixi4ui6glxk",
      "text": "右僉都御史",
      "sources": [
        {
          "title": "《明史》卷二百零四·曾銑傳",
          "source_bid": "d59f2mc8bta8",
          "details": "擢銑大理寺丞，遷右僉都御史，巡撫山東。"
        }
      ]
    },
    {
      "office_id": "hixi5v60b75u",
      "text": "副都御史",
      "sources": [
        {
          "title": "《明史》卷二百零四·曾銑傳",
          "source_bid": "d59f2mc8bta8",
          "details": "工畢，進副都御史。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl89h",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《明史》卷二百零四·曾銑傳",
          "source_bid": "d59f2mc8bta8",
          "details": "經歲寇不犯邊，朝廷以為功，進兵部侍郎，巡撫如故。"
        }
