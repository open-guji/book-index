  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷三百零一·鄭向傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士中甲科，為大理評事、通判蔡州，累遷尚書屯田員外郎、知濠州，徙蔡州。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg8",
      "text": "度支員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百零一·鄭向傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷度支員外郎，為鹽鐵判官。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "兩浙轉運副使",
      "place_id": "hixiclu1dr0m",
      "sources": [
        {
          "title": "《宋史》卷三百零一·鄭向傳",
          "source_bid": "d59f2gonq7sy",
          "details": "出為兩浙轉運副使，疏潤州蒜山漕河抵於江，人以為便。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷三百零一·鄭向傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為鹽鐵判官，擢知制誥、同勾當三班院。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfn",
      "text": "兵部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百零一·鄭向傳",
          "source_bid": "d59f2gonq7sy",
          "details": "使契丹，再遷兵部郎中、提點諸司庫務，以龍圖閣直學士知杭州，卒。"
        }
      ]
    }
