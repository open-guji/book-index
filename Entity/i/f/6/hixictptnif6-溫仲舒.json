      "text": "大理評事",
      "start": 977,
      "end": 977,
      "date_text": "太平興國二年",
      "sources": [
        {
          "title": "《宋史》卷二百六十六·溫仲舒傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國二年，舉進士，為大理評事，通判吉州。"
        }
      ]
    },
    {
      "office_id": "hixia8nu76yr",
      "text": "秘書丞",
      "sources": [
        {
          "title": "《宋史》卷二百六十六·溫仲舒傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷秘書丞、知汾州，坐事除名。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷二百六十六·溫仲舒傳",
          "source_bid": "d59f2gonq7sy",
          "details": "端拱初，拜右正言、直史館、判戶部憑由司。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百六十六·溫仲舒傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，拜工部郎中、樞密直學士，知三班院。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "start": 991,
      "end": 991,
      "date_text": "淳化二年",
      "sources": [
        {
          "title": "《宋史》卷二百六十六·溫仲舒傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳化二年，拜右諫議大夫、樞密副使，改同知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "start": 991,
      "end": 991,
      "date_text": "淳化二年",
      "sources": [
        {
          "title": "《宋史》卷二百六十六·溫仲舒傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳化二年，拜右諫議大夫、樞密副使，改同知樞密院事。"
        }
