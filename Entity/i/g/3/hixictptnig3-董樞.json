      "office_id": "hiximaw4ktfu",
      "text": "主客員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百七十·董樞傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太祖乾德初，遷主客員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgi",
      "text": "比部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百七十·董樞傳",
          "source_bid": "d59f2gonq7sy",
          "details": "下御史臺鞫之，黜宋州教練使，以樞嘗貢西伐計，遷比部郎中。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfn",
      "text": "兵部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百七十·董樞傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改兵部郎中，權知連州兼行營招撫使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河北轉運使",
      "start": 971,
      "end": 971,
      "date_text": "四年",
      "basis": "承上文年號開寶",
      "sources": [
        {
          "title": "《宋史》卷二百七十·董樞傳",
          "source_bid": "d59f2gonq7sy",
          "details": "四年，移知襄州，又為河北轉運使，改判西京留司御史臺。"
        }
      ]
