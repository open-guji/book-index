    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "懷讓徙同州，又為掌書記，歷邠州、鳳翔判官，拜殿中侍御史、知舒州。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "start": 980,
      "end": 980,
      "date_text": "太平興國五年",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國五年，舉進士甲科，為將作監丞、通判潭州，遷右贊善大夫，轉著作郎。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfq",
      "text": "職方員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷職方員外郎，召入翰林為學士。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，拜給事中、參知政事。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗升儲，遷禮部侍郎兼太子賓客，詔東宮待以師傅禮。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，遷戶部侍郎、參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8m69mo3",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸平初，以本官平章事，監修國史，改中書侍郎。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu9",
      "text": "門下侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累加門下侍郎、尚書右僕射。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十二·李沆傳",
          "source_bid": "d59f2gonq7sy",
          "details": "廢朝五日，贈太尉、中書令，諡文靖。"
        }
      ]
    }
