  "description": {
    "text": "王超之子。至道二年年十七從父擊李繼遷為先鋒；仁宗時歷殿前都指揮使、樞密使，貌黑，人稱「黑王相公」，以忠武軍節度使、景靈宮使終，贈太尉、中書令，諡武恭。",
    "sources": [
      {
        "name": "《宋史·王超傳》",
        "details": "卷278，附父傳"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8oxj3eq",
      "text": "河西軍節度使",
      "start": 991,
      "end": 991,
      "date_text": "淳化二年",
      "sources": [
        {
          "title": "《宋史》卷二百七十八·王超傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳化二年，累遷至河西軍節度使、殿前都虞候。"
        }
      ]
    },
    {
      "office_id": "hixia8pgkkjn",
      "text": "檢校太傅",
      "sources": [
        {
          "title": "《宋史》卷二百七十八·王超傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗嗣位，以翊戴功，加檢校太傅、領天平軍節度。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr5",
      "text": "開府儀同三司",
      "sources": [
        {
          "title": "《宋史》卷二百七十八·王超傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加開府儀同三司、檢校太尉。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "崇信軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百七十八·王超傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會南北通好，故薄其責，止罷超三路帥，爲崇信軍節度使，徙知河陽。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知青州",
      "place_id": "hixicl84l2e5",
      "sources": [
        {
          "title": "《宋史》卷二百七十八·王超傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又移鎮建雄，知青州，卒。"
        }
      ]
    },
    {
      "office_id": "hixia8njl4ht",
      "text": "侍中",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百七十八·王超傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈侍中，再贈尚書令，追封魯國公，諡武康。"
        }
      ]
    }
  ],
