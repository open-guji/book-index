  "description": {
    "text": "徐州彭城人。太平興國三年進士，端拱元年召試直史館；咸平三年知益州，王均之亂棄城走，貶儋州司戶，後起知漣水軍，卒年六十四。",
    "sources": [
      {
        "name": "《宋史·牛冕傳》",
        "details": "卷277"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·牛冕傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加左讚善大夫，遷太常丞、知滁州，以勤政聞。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "左正言",
      "start": 988,
      "end": 988,
      "date_text": "端拱元年",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·牛冕傳",
          "source_bid": "d59f2gonq7sy",
          "details": "端拱元年，召試文章，遷左正言、直史館。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6u",
      "text": "左司諫",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·牛冕傳",
          "source_bid": "d59f2gonq7sy",
          "details": "出知潤州，徙泉州，未至，就命為福建轉運使，加左司諫。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知潭州",
      "place_id": "hixicl85u0ht",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·牛冕傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至道初，召入，進秩兵部員外郎，知潭州。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·牛冕傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗在東宮，冕嘗奉使賜生辰禮幣，即位尚記其名，改工部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8nm30ub",
