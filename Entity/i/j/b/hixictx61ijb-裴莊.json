  "description": {
    "text": "閬州閬中人。在蜀登第，入宋歷州縣官；歷知諸州，入判刑部，以疾分司西京，郊祀改光祿卿，卒，年八十一；有吏幹，慷慨敢言，頗無清操。",
    "sources": [
      {
        "name": "《宋史·裴莊傳》",
        "details": "卷277"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mg981u",
      "text": "太子中允",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未逾年，咸信表其能，遷太子中允。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "翌日，拜監察御史、荊湖南路轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyy",
      "text": "三司鹽鐵判官",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未行，改三司鹽鐵判官。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "荊湖北路轉運使",
      "place_id": "hixiclu1dr13",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "出為荊湖北路轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgc",
      "text": "祠部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄遷祠部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河東轉運使",
      "kind": "充",
      "place_id": "hixiclu1dr0x",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，遷度支，充河東轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfx",
      "text": "司封郎中",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改司封郎中。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg1",
      "text": "鴻臚少卿",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "大中祥符初東封，改鴻臚少卿，入判登聞鼓院。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpui",
      "text": "太僕少卿",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "祀汾陰，遷太僕少卿，為北嶽加號冊禮副使，撰《北行記》三卷以獻。"
        }
      ]
    },
    {
      "office_id": "hixia8mlvhts",
      "text": "太府卿",
      "start": 1014,
      "end": 1014,
      "date_text": "明年",
      "basis": "承上文年號大中祥符",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明年，車駕幸南京，莊以逮事太宗恩例，授太府卿，權判西京留司御史臺。"
        }
      ]
    },
    {
      "office_id": "hixia8n4wyyq",
      "text": "光祿卿",
      "sources": [
        {
          "title": "《宋史》卷二百七十七·裴莊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "郊祀，改光祿卿，求歸上都，以便醫藥。"
        }
      ]
    }
