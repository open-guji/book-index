          "source_bid": "d59f2ofs2u4h",
          "details": "尋遷司封郎中。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "常州刺史",
      "place_id": "hixicl8d0h33",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十三·孟簡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "簡抗疏論之，坐語訐，出為常州刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "越州刺史",
