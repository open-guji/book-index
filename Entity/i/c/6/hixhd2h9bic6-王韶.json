  "description": {
    "sources": [
      {
        "name": "《宋史·王韶傳》",
        "details": "卷328，傳首：王韶，字子純，江州德安人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝從其言，改著作佐郎，仍命韶提舉。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進右正言、集賢殿修撰。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "六年三月，取河州，遷樞密直學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進左諫議大夫、端明殿學士。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七年，入朝，又加資政殿學士，賜第崇仁坊。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，召為樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mjdlhc",
      "text": "金紫光祿大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百二十八·王韶傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈金紫光祿大夫，諡曰襄敏。"
        }
      ]
    }
  ],
