          "source_bid": "d59f2ofs2u4h",
          "details": "元和十年，改職方郎中，充太子諸王侍讀，再遷諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "虔州刺史",
      "place_id": "hixicl83nct8",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十二·韋綬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "憲宗不悅，謂侍臣曰：「凡侍讀者，當以經義輔導太子，納之輒物，而綬語及此，予何望耶？」乃罷侍讀，出為虔州刺史。"
        }
      ]
    },
    {
      "office_id": "hixikfedch22",
      "text": "尚書右丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十二·韋綬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "穆宗即位，以師友之恩，召為尚書右丞，兼集賢院學士，甚承恩顧，出入禁中。"
        }
      ]
    },
    {
      "office_id": "hixikfedch26",
      "text": "尚書右僕射",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百六十二·韋綬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "二年八月卒，贈尚書右僕射。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32i",
      "text": "諫議大夫",
      "sources": [
        {
          "title": "《新唐書》卷一百六十·韋綬傳",
          "source_bid": "d59f2htqolj5",
          "details": "穆宗為太子，綬入侍讀，遷諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixikfedch22",
      "text": "尚書右丞",
      "sources": [
        {
          "title": "《新唐書》卷一百六十·韋綬傳",
          "source_bid": "d59f2htqolj5",
          "details": "穆宗立，召為尚書右丞、集賢院學士，出入禁中，怙寵甚。"
        }
      ]
    },
    {
      "office_id": "hixikfedch26",
      "text": "尚書右僕射",
      "posthumous": true,
      "sources": [
        {
