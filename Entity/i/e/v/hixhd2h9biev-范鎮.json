  "offices": [
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢起居舍人、知諫院。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6n",
      "text": "園陵使",
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "葬溫成后，太常議禮，前謂之園，後謂之陵，宰相劉沆前為監護使，後為園陵使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32n",
      "text": "集賢殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "朝廷知不能奪，乃罷知諫院，改集賢殿修撰，糾察在京刑獄，同修起居注，遂知制誥。"
        }
      ]
    },
    {
      "office_id": "hixia8m5bx1c",
      "text": "侍讀學士",
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "奈何更以為罪乎？」會草制，誤遷宰相官，改侍讀學士。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "神宗即位，復為翰林學士兼侍讀、知通進銀臺司。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜端明殿學士，起提舉中太一宮兼侍讀，且欲以為門下侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mjdlhc",
      "text": "金紫光祿大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百三十七·范鎮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈金紫光祿大夫，諡曰「忠文」。"
        }
      ]
    }
  ]
