    },
    {
      "office_id": "hiximwy63ora",
      "text": "朝列大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《金史》卷九十六·王賁傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "賁敦厚尚義，篤於親朋，不營產業，比歿，家甚窶，上聞憫惜之，贈朝列大夫，仍厚恤共家。"
        }
