      "sources": [
        {
          "title": "《元史》卷一百八十五·呂思誠傳",
          "source_bid": "d59f2njivtog",
          "details": "未幾，召為集賢侍講學士，兼國子祭酒，出為湖廣行省參知政事，諸生抗疏留之，不可。"
        }
