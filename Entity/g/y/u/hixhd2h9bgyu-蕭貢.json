      ]
    },
    {
      "office_id": "hixia8n8ckxw",
      "text": "治書侍御史",
      "sources": [
        {
          "title": "《金史》卷一百零五·蕭貢傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "貢論時政五弊，言路四難，詞意切至，改治書侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximde33x93",
      "text": "刑部侍郎",
      "sources": [
