  "offices": [
    {
      "office_id": "hixia8mep1c2",
      "text": "淮南轉運判官",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召對，除淮南轉運判官。"
        }
      ]
    },
    {
      "office_id": "hixia8offbwi",
      "text": "發運副使",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七年，入為右司員外郎，不就，以直秘閣為京畿轉運副使，尋兼發運副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知襲慶府",
      "place_id": "hixicl84l2fq",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明年，知襲慶府，道梗不能赴。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "江東轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋起知江州，改江東轉運使，進秘閣修撰。"
        }
      ]
    },
    {
      "office_id": "hixi4udt505i",
      "text": "秘閣修撰",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋起知江州，改江東轉運使，進秘閣修撰。"
        }
      ]
    },
    {
      "office_id": "hixi4ufdmyh7",
      "text": "徽猷閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進徽猷閣待制。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十七·向子諲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙兩浙路為都轉運使，除戶部侍郎。"
