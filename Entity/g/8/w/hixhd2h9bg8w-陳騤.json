    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "kind": "試",
      "start": 1178,
      "end": 1178,
      "date_text": "淳熙五年",
      "sources": [
        {
          "title": "《宋史》卷三百九十三·陳騤傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳熙五年，試中書舍人兼侍講、同修國史。"
        }
      ]
    },
    {
      "office_id": "hixidx4p62vd",
      "text": "提舉太平興國宮",
      "sources": [
        {
          "title": "《宋史》卷三百九十三·陳騤傳",
          "source_bid": "d59f2gonq7sy",
          "details": "言者忌而攻之，上留章不下，授提舉太平興國宮。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百九十三·陳騤傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起知寧國府，改知太平州，加集英殿修撰。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptw",
      "text": "禮部尚書",
