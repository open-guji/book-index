  "subtype": "people",
  "primary_name": "劉從一",
  "dynasty": "唐",
  "dynasty_basis": "據正史本傳",
  "period": "sui-tang",
  "period_basis": "據 dynasty「唐」歸併",
  "title_or_office": "中書侍郎",
  "description": {
    "text": "劉祥道從孫劉令植之孫，擢進士宏詞第，為常袞、盧杞所厚。德宗居奉天時超拜刑部侍郎、同中書門下平章事，從幸梁州改中書侍郎；容身遠罪而已。貞元初以疾罷為戶部尚書，卒，贈太子太傅。",
    "sources": [
      {
        "name": "《新唐書·劉祥道傳附》",
        "details": "卷106"
      },
      {
        "name": "《舊唐書·劉從一傳》",
        "details": "卷125"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5v2mknb6",
      "text": "監察御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十五·劉從一傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "及袞為相，遷監察御史。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g2",
      "text": "吏部郎中",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十五·劉從一傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "建中末，普王之為元帥也，遷吏部郎中、兼御史中丞，為元帥判官。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gc",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十五·劉從一傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "德宗居奉天，拜刑部侍郎、平章事，從幸梁州。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十五·劉從一傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "明年六月，改中書侍郎、平章事。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g5",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十五·劉從一傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "無幾，以疾請告，至是，病甚辭位，章疏六上，乃許，除戶部尚書。"
        }
      ]
    },
    {
      "office_id": "hixia8oj66f7",
      "text": "太子太傅",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百二十五·劉從一傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋卒，年四十四，輟朝三日，贈太子太傅。"
        }
      ]
    }
  ],
