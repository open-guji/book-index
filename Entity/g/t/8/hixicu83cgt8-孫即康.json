  "description": {
    "text": "字安伯，析津（大興）人，遼啟聖軍節度使孫克構曾孫，大定十年進士。章宗時講究鹽法，歷御史中丞、參知政事，擬定廟諱避寫之制，進左丞；衛紹王即位進平章政事封崇國公，主鞫元妃李氏案；大安三年致仕，是歲薨。",
    "sources": [
      {
        "name": "《金史·孫即康傳》",
        "details": "卷99"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximde33x8u",
      "text": "戶部員外郎",
      "sources": [
        {
          "title": "《金史》卷九十九·孫即康傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "章宗即位，累遷戶部員外郎，講究鹽法利害，語在《食貨志》。"
        }
      ]
    },
    {
      "office_id": "hixia8ni0xs0",
      "text": "耀州刺史",
      "place_id": "hixicl8cp8j2",
      "sources": [
        {
          "title": "《金史》卷九十九·孫即康傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "除耀州刺史，入為吏部左司郎中。"
        }
      ]
    },
    {
      "office_id": "hixi5wud64g6",
      "text": "泰甯軍節度使",
      "sources": [
        {
          "title": "《金史》卷九十九·孫即康傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "頃之，遷泰甯軍節度使，改知延安府事。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9eru",
      "text": "參知政事",
      "start": 1203,
      "end": 1203,
      "date_text": "泰和三年",
