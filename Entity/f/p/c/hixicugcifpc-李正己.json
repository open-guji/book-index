  "description": {
    "text": "高麗人，本名懷玉。從侯希逸入青州，後逐希逸，代為平盧淄青節度使，賜今名；據淄、青等州，與田承嗣等相倚；建中初與田悅、梁崇義、李惟岳同叛，發疽死，年四十九。",
    "sources": [
      {
        "name": "《新唐書·列傳第一百三十八》",
        "details": "卷213"
      },
      {
        "name": "《舊唐書·列傳第七十四》",
        "details": "卷124"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfedch26",
      "text": "檢校尚書右僕射",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十四·李正己傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋加檢校尚書右僕射，封饒陽郡王。"
        }
      ],
      "kind": "檢校"
    },
    {
      "office_id": "hixia8nxy1hc",
      "text": "平章事",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十四·李正己傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "歷檢校司空、左僕射、兼御史大夫，加平章事、太子太保、司徒。"
        }
      ]
    },
    {
      "office_id": "hixia8nxy1hc",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《新唐書》卷二百一十三·李正己傳",
          "source_bid": "d59f2htqolj5",
          "details": "歷檢校司空，加同中書門下平章事，以司徒兼太子太保，封饒陽郡王。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gs",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《新唐書》卷二百一十三·李正己傳",
          "source_bid": "d59f2htqolj5",
          "details": "代宗召見，擢殿中丞，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hixia8pk06io",
      "text": "行軍司馬",
      "sources": [
        {
          "title": "《新唐書》卷二百一十三·李正己傳",
          "source_bid": "d59f2htqolj5",
          "details": "正己署為淄、青二州刺史，又為行軍司馬，濮、徐、兗、沂、海留後，進御史大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3er",
      "text": "御史大夫",
      "sources": [
        {
          "title": "《新唐書》卷二百一十三·李正己傳",
          "source_bid": "d59f2htqolj5",
          "details": "正己署為淄、青二州刺史，又為行軍司馬，濮、徐、兗、沂、海留後，進御史大夫。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gd",
      "text": "檢校工部尚書",
      "sources": [
        {
          "title": "《新唐書》卷二百一十三·李正己傳",
          "source_bid": "d59f2htqolj5",
          "details": "興元初，帝下詔罪己，納復歸命，授檢校工部尚書，復平盧帥節，賜鐵券，又同中書門下平章事，封隴西郡王。"
        }
      ],
      "kind": "檢校"
    },
    {
      "office_id": "hixia8oaqrr7",
      "text": "檢校司徒",
