  "description": {
    "text": "平盧節度使劉正臣之孫。事李師古，為李師道將，元和十四年回兵攻鄆，殺師道降朝廷，授義成軍節度使；穆宗時徙昭義軍，專擅；寶曆初嘔血卒，贈太尉。",
    "sources": [
      {
        "name": "《新唐書·列傳第一百三十九》",
        "details": "卷214"
      },
      {
        "name": "《舊唐書·列傳第一百十一》",
        "details": "卷161"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8pjdpfl",
      "text": "平盧軍節度使",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十一·劉悟傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "授平盧軍節度使，賜名正臣。"
        }
      ]
    },
    {
      "office_id": "hixia8oj66f7",
      "text": "太子太傅",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十一·劉悟傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "乃復以悟為澤潞節度，拜檢校司徒，兼太子太傅，依前平章事。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqiq",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百六十一·劉悟傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "寶歷元年九月病卒，贈太尉。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqiq",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷二百一十四·劉悟傳",
          "source_bid": "d59f2htqolj5",
          "details": "將易衣，嘔血數斗，卒，贈太尉。"
        }
      ]
    }
