          "source_bid": "d59f2ofs2u4h",
          "details": "尋授侍御史、迥紇糧料使，改檢校職方員外郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "晉州刺史",
      "place_id": "hixicabu3e1w",
      "sources": [
        {
