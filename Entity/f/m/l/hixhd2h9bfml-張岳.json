  "offices": [
    {
      "office_id": "hixia8oygt1d",
      "text": "行人",
      "start": 1516,
      "end": 1516,
      "date_text": "正德十一年",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "登正德十一年進士，授行人。"
        }
      ]
    },
    {
      "office_id": "hixia8pfmuwz",
      "text": "廉州知府",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "遷廉州知府。"
        }
      ]
    },
    {
      "office_id": "hixia8ou3hfn",
      "text": "參政",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "會嶽遷浙江提學副使，又遷參政，伯温馳奏留之，乃改廣東參政，分守海北。"
        }
      ]
    },
    {
      "office_id": "hixi5v60b75u",
      "text": "右副都御史",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "旋移撫江西，進右副都御史，總督兩廣軍務兼巡撫。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl89h",
      "text": "兵部右侍郎",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "討破廣東封川僮蘇公樂等，進兵部右侍郎。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl89m",
      "text": "刑部右侍郎",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "召爲刑部右侍郎，以御史徐南金言命留任。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirnd4",
      "text": "右都御史",
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "進右都御史。"
        }
      ]
    },
    {
      "office_id": "hixia8m8gagy",
      "text": "太子少保",
      "posthumous": true,
      "sources": [
        {
          "title": "《明史》卷二百·張岳傳",
          "source_bid": "d59f2mc8bta8",
          "details": "已，敘功，復右都御史，贈太子少保，諡襄惠。"
        }
      ]
    }
