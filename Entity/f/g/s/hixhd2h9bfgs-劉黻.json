  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "start": 1267,
      "end": 1267,
      "date_text": "咸淳三年",
      "sources": [
        {
          "title": "《宋史》卷四百〇五·劉黻傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸淳三年，拜監察御史，論內降恩澤曰：\n\n「治天下之要，莫先於謹命令，謹命令之要，莫先於窒內批。"
        }
      ]
    },
    {
      "office_id": "hixia8mqk1z7",
      "text": "正字",
      "sources": [
        {
          "title": "《宋史》卷四百〇五·劉黻傳",
          "source_bid": "d59f2gonq7sy",
          "details": "四年，改正字，言：「正學不明則義理日微，異端不息則鼓惑轉熾。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷四百〇五·劉黻傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會丁父憂去位，服除，授集英殿修撰，沿海制置、知慶元府事。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百〇五·劉黻傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年，召還，拜刑部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8nea39c",
      "text": "朝奉郎",
      "sources": [
        {
          "title": "《宋史》卷四百〇五·劉黻傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九年，改朝奉郎，試吏部尚書，兼工部尚書，兼中書舍人，兼修玉牒，兼侍讀。"
        }
