  "offices": [
    {
      "office_id": "hiximd4offw1",
      "text": "軍器監主簿",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋遷史館校勘，又遷軍器監主簿兼史館校勘。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "範既入相，召為太常博士，遷秘書郎。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb8",
      "text": "秘書郎",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "範既入相，召為太常博士，遷秘書郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "江西轉運判官",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改江西轉運判官，斯得具辭免，上奏曰：「臣劾奏趙善瀚等七人，未聞報可，固疑必有黨與營救，惑誤聖聽，今奉恩除，乃知中臣所料。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktft",
      "text": "禮部郎中",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加直秘閣、湖南轉運判官，改尚右郎官，未至，改禮部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8mqvaiq",
      "text": "司農卿",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "董槐入相，召為司農卿。"
        }
      ]
    },
    {
      "office_id": "hixia8oa4ao1",
      "text": "秘書監",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "度宗即位，召為秘書監，又論罷。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復遷祕書監，屢辭不許，擢起居舍人兼國史院編修官、實錄院檢討官兼侍講。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "大元軍下襄陽，斯得疏論言事，最為切要，帝嘉納，遷工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷四百零九·高斯得傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢翰林學士、知制誥兼侍讀，進端明殿學士、簽書樞密院事兼參知政事，同提舉編修《敕令》及《經武要略》。"
        }
      ]
    },
    {
