  "offices": [
    {
      "office_id": "hixia8mep1c2",
      "text": "轉運判官",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·包恢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼轉運判官，以侍御史周坦論罷。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu6",
      "text": "大理少卿",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·包恢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又四年，起為廣東轉運判官，權經略使，遷侍右郎官，尋為大理少卿，即日除直顯文閣、浙西提點刑獄。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知隆興府",
      "place_id": "hixicl85is1h",
      "sources": [
        {
          "title": "《宋史》卷四百二十一·包恢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進直龍圖閣、權發運，升祕閣修撰，知隆興府兼江西轉運。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "湖南轉運使",
      "sources": [
