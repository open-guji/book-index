  "description": {
    "sources": [
      {
        "name": "《清史稿》卷五十四〈地理志一〉",
        "details": "順天府「大城繁，難。府東南三百九十里。隸南路。西北：會同河自文安入，逕臺頭村，有行宮。大清河、辛張河並自文安入。子牙河自河間入，舊納古洋河，光緒中，改自獻之朱家口，故渠久湮。」"
      },
      {
        "name": "《元史》卷五十八〈地理志一〉",
        "details": "霸州「大城，（下。）。」"
      },
      {
        "name": "《明史》卷四十〈地理志一〉",
        "details": "順天府（霸州）「大城州東南。東北有黃汊河，源自交河，分流至縣境，入三角澱。」"
      },
      {
        "name": "《宋史》卷八十六〈地理志二〉",
        "details": "霸州「大城。上。」"
      },
      {
        "name": "《金史》卷二十四〈地理志上〉",
        "details": "霸州「大城。」"
      }
    ]
  },
