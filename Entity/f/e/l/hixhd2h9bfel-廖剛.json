  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "宣和初，自漳州司錄除國子錄，擢監察御史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu8",
      "text": "工部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁父憂，服闋，除工部員外郎，以母疾辭。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷起居舍人、權吏部侍郎兼侍講，除給事中。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "權戶部侍郎，尋遷刑部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "權戶部侍郎，尋遷刑部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8ojheyo",
      "text": "徽猷閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "求補外，除徽猷閣直學士、知漳州。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷三百七十四·廖剛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上讀之聳然，即召剛趣至闕，拜御史中丞。"
        }
      ]
    }
  ]
