  },
  "offices": [
    {
      "office_id": "hixia8mep1c2",
      "text": "潼川府路轉運判官",
      "place_id": "hixiclu1dr10",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，出知荊門軍，提舉湖南茶鹽，改潼川府路轉運判官，尋改成都府路計度轉運副使、提舉四川茶馬。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuh",
      "text": "太府少卿",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "朝臣薦其才，召赴行在，除太府少卿，總領四川財賦。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "孝宗即位，除戶部侍郎，充川陝宣諭使。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0r",
      "text": "直學士院",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄兼直學士院。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "之望首以守備不足恃為告，上亟罷都督府，以之望為淮西宣諭使，甫拜命，又擢右諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "金復犯邊，遂上和、戰二策，且言措置守禦之備，疏奏未達，拜參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既入，俄兼同知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6s",
      "text": "資政殿大學士",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·王之望傳",
          "source_bid": "d59f2gonq7sy",
          "details": "捕海賊王大老，捷聞，加資政殿大學士，移知溫州，尋復罷。"
        }
      ]
    }
  ]
}
