  "offices": [
    {
      "office_id": "hixia8mum51d",
      "text": "知翼城縣",
      "place_id": "hixicabu3dwk",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "及進士第，知翼城縣，通判絳州，為監察御史，轉殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "及進士第，知翼城縣，通判絳州，為監察御史，轉殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷天章閣待制、都轉運使，連進龍圖閣、樞密直學士、知秦州，改益州。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜同中書門下平章事、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixia8pdg743",
      "text": "昭文館大學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進昭文館大學士。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "忠武軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "介既貶，彥博亦罷為觀文殿大學士、知許州，改忠武軍節度使、知永興軍。"
        }
      ]
    },
    {
      "office_id": "hixia8nf7sw3",
      "text": "尚書左僕射",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又改鎮成德，遷尚書左僕射、判太原府。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋除侍中，徙鎮淮南、判永興軍，入為樞密使、劍南西川節度使。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxf",
      "text": "司徒",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋加司徒。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "start": 1080,
      "end": 1080,
      "date_text": "元豐三年",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元豐三年，拜太尉，復判河南。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu4",
      "text": "吏部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元祐初，為吏部員外郎，以直龍圖閣知同州。"
        }
      ]
    },
    {
      "office_id": "hixia8mf09vo",
      "text": "太僕卿",
      "sources": [
        {
          "title": "《宋史》卷三百一十三·文彥博傳",
          "source_bid": "d59f2gonq7sy",
          "details": "彥博再致仕，及甫知河陽，召為太僕卿，權工部侍郎，罷為集賢殿修撰、提舉明道宮。"
        }
      ]
