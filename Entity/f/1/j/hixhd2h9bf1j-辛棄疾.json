  "offices": [
    {
      "office_id": "hixia8n4lqf5",
      "text": "掌書記",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "耿京聚兵山東，稱天平節度使，節制山東、河北忠義軍馬，棄疾為掌書記，即勸京決策南向。"
        }
      ]
    },
    {
      "office_id": "hixia8o0r6dd",
      "text": "承務郎",
      "start": 1162,
      "end": 1162,
      "date_text": "紹興三十二年",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹興三十二年，京令棄疾奉表歸宋，高宗勞師建康，召見，嘉納之，授承務郎、天平節度掌書記，併以節使印告召京。"
        }
      ]
    },
    {
      "office_id": "hixi4udt505i",
      "text": "祕閣修撰",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "平劇盜賴文政有功，加祕閣修撰。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "湖北轉運副使",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷知隆興府兼江西安撫，以大理少卿召，出為湖北轉運副使，改湖南，尋知潭州兼湖南安撫。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知潭州",
      "place_id": "hixicl85u0ht",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷知隆興府兼江西安撫，以大理少卿召，出為湖北轉運副使，改湖南，尋知潭州兼湖南安撫。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu6",
      "text": "大理少卿",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召見，遷大理少卿，加集英殿修撰、知福州兼福建安撫使。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召見，遷大理少卿，加集英殿修撰、知福州兼福建安撫使。"
        }
      ]
    },
    {
      "office_id": "hixia8n8z20w",
      "text": "寶謨閣待制",
      "start": 1198,
      "end": 1198,
      "date_text": "四年",
      "basis": "承上文年號慶元",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "四年，寧宗召見，言鹽法，加寶謨閣待制、提舉佑神觀，奉朝請。"
        }
      ]
    },
    {
      "office_id": "hixia8n5uold",
      "text": "寶文閣待制",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進寶文閣待制，又進龍圖閣、知江陵府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "kind": "試",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "令赴行在奏事，試兵部侍郎，辭免。"
        }
      ]
    },
    {
      "office_id": "hixigfk2gsg0",
      "text": "樞密都承旨",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進樞密都承旨，未受命而卒。"
        }
      ]
    },
    {
      "office_id": "hixia8p7iosg",
      "text": "龍圖閣待制",
      "kind": "守",
      "sources": [
        {
          "title": "《宋史》卷四百零一·辛棄疾傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賜對衣、金帶，守龍圖閣待制致仕，特贈四官。"
        }
      ]
    },
    {
      "office_id": "hixia8n0uvwh",
      "text": "光祿大夫",
      "posthumous": true,
