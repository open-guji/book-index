      {
        "title": "《欽定四庫全書總目》卷五十二·《南渡錄》提要",
        "source_bid": "d59dh3vo9af4",
        "details": "此二書所載語並相似，舊本或題無名氏，或並題爲辛棄疾撰，蓋本出一手所僞託，故所載全非事實。"
      },
      {
        "title": "《欽定四庫全書總目》卷一百·《美芹十論》提要",
        "source_bid": "d59dh3vo9af4",
        "details": "舊本題宋辛棄疾撰。"
      },
      {
        "title": "《欽定四庫全書總目》卷一百二十七·《蕉窻雜錄》提要",
        "source_bid": "d59dh3vo9af4",
        "details": "舊本題曰宋稼軒居士撰。稼軒，辛棄疾號也。"
      },
      {
        "name": "《宋史·辛棄疾傳》",
        "details": "卷401，傳首：辛棄疾字幼安，齊之歷城人。"
