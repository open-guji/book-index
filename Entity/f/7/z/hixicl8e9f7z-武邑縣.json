      {
        "name": "《清史稿》卷五十四〈地理志一〉",
        "details": "冀州「武邑疲，難。州東北九十里。西：滏陽河自衡水入。又廢龍治河、老漳河。有水驛。」"
      },
      {
        "name": "《元史》卷五十八〈地理志一〉",
        "details": "冀州「武邑，（中。）。」"
      },
      {
        "name": "《明史》卷四十〈地理志一〉",
        "details": "真定府（冀州）「武邑州東北。西有洚水。西北有漳水。」"
      },
      {
        "name": "《金史》卷二十五〈地理志中〉",
        "details": "冀州「武邑有漳河、長蘆河。鎮一觀津，後廢。」"
      },
      {
        "name": "《宋史》卷八十六〈地理志二〉",
        "details": "冀州「武邑，上。」"
      }
    ]
