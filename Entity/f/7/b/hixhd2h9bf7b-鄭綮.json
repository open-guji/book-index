      "office_id": "hixi5v2m9es3",
      "text": "給事中",
      "sources": [
        {
          "title": "《新唐書》卷一百八十三·鄭綮傳",
          "source_bid": "d59f2htqolj5",
          "details": "王徽為御史大夫，以兵部郎中表知雜事，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixi5v2mknb9",
      "text": "國子祭酒",
      "sources": [
        {
          "title": "《新唐書》卷一百八十三·鄭綮傳",
          "source_bid": "d59f2htqolj5",
          "details": "召為右散騎常侍，往往條摘失政，眾讙傳之，宰相怒，改國子祭酒，議者不直，復還常侍。"
        }
      ]
    },
    {
      "office_id": "hixia8pa0l4x",
      "text": "太子少保",
      "sources": [
        {
          "title": "《新唐書》卷一百八十三·鄭綮傳",
          "source_bid": "d59f2htqolj5",
          "details": "自以不為人所瞻望，才三月，以疾乞骸，拜太子少保致仕，卒。"
        }
      ]
    }
