  "offices": [
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷四百〇一·劉宰傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，遷太常丞，郡守以朝命趣行，不得已勉就道，至吳門，拜疏徑歸。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg9",
      "text": "將作少監",
      "sources": [
        {
          "title": "《宋史》卷四百〇一·劉宰傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷將作少監，又以直敷文閣知寧國府，皆不拜。"
        }
      ]
    },
    {
      "office_id": "hixia8p6kz5s",
      "text": "直顯謨閣",
      "sources": [
        {
          "title": "《宋史》卷四百〇一·劉宰傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進直顯謨閣、主管玉局觀，帝猶冀宰一來也。"
        }
      ]
    }
  ]
