  "description": {
    "text": "本名臨喜，僕散忠義之子，尚韓國大長公主。歷刑部尚書、河南路統軍使、參知政事、尚書右丞，拜平章政事封濟國公；泰和五年宋人渝盟，以宣撫使總兵南伐，渡淮屢捷；七年二月薨於軍，諡武肅。",
    "sources": [
      {
        "name": "《金史·僕散揆傳》",
        "details": "卷93"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximde33x92",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《金史》卷九十三·僕散揆傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "尋起為濼州刺史，改蠡州，入為兵部侍郎、大理卿、刑部尚書。"
        }
      ]
    },
    {
      "office_id": "hixi5wud64g6",
      "text": "泰定軍節度使",
      "sources": [
        {
          "title": "《金史》卷九十三·僕散揆傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "章宗即位，出為泰定軍節度使，改知臨洮府事。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9eru",
      "text": "參知政事",
      "sources": [
        {
          "title": "《金史》卷九十三·僕散揆傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "既入，拜參知政事，改授中都路胡土愛割蠻世襲猛安。"
        }
      ]
    }
  ],
