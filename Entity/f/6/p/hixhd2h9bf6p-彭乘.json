  "offices": [
    {
      "office_id": "hixia8obohdu",
      "text": "館閣校勘",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，有薦其文行者，召試，為館閣校勘，固辭還家，後復除鳳州團練推官。"
        }
      ]
    },
    {
      "office_id": "hixia8mn4g00",
      "text": "天平軍節度推官",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "天禧初，用寇準薦，為館閣校勘，改天平軍節度推官。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu5",
      "text": "秘書省著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "預校正《南》、《北史》、《隋書》，改秘書省著作佐郎，遷本省丞、集賢校理。"
        }
      ]
    },
    {
      "office_id": "hixia8p4ebcx",
      "text": "知荊門軍",
      "place_id": "hixicl85is56",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "服除，知荊門軍，改太常博士。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "服除，知荊門軍，改太常博士。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "夔州路轉運使",
      "place_id": "hixiclu1dr0o",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，同判尚書刑部，出知安州，徙提點京西刑獄，改夔州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召修起居注，擢知制誥，累遷工部郎中，入翰林為學士，領吏部流內銓、三班院，為群牧使。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十八·彭乘傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召修起居注，擢知制誥，累遷工部郎中，入翰林為學士，領吏部流內銓、三班院，為群牧使。"
