  "description": {
    "sources": [
      {
        "title": "《欽定四庫全書總目》卷一百四十·《賈氏談錄》提要",
        "source_bid": "d59dh3vo9af4",
        "details": "宋張洎撰。"
      },
      {
        "name": "《宋史·張洎傳》",
        "details": "卷267，傳首：張洎，滁州全椒人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "李景長子弘冀卒，有司諡武宣，洎議以為世子之禮，但當問安視膳，不宜以「武」為稱，旋命改諡，擢監察御史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu8",
      "text": "工部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢工部員外郎、試知制誥；滿歲，為禮部員外郎、知制誥。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfp",
      "text": "禮部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢工部員外郎、試知制誥；滿歲，為禮部員外郎、知制誥。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷中書舍人、清輝殿學士，參預機密，恩寵第一。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuf",
      "text": "戶部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，使高麗，復命，改戶部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知相州",
      "place_id": "hixicl84waz2",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "是冬，又知相州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "令以本官知譯經院，遷兵部員外郎、禮、戶二部郎中。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "洎未幾選為太僕少卿、同知京朝官考課，拜右諫議大夫、判大理寺。"
        }
      ]
    },
    {
      "office_id": "hixia8newkcg",
      "text": "史館修撰",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又充史館修撰、判集賢院事。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "數月，擢拜中書舍人，充翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既而易簡罷，即以洎為給事中、參知政事，與寇準同列。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "後月餘，改刑部侍郎，罷知政事。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptv",
      "text": "刑部尚書",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百六十七·張洎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈刑部尚書，以其二子皆為京官。"
        }
      ]
    }
  ],
  "revision": "1.0.3",
  "revised_at": "2026-11-11"
}
