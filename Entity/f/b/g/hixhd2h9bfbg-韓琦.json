  "offices": [
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授將作監丞、通判淄州，入直集賢院、監左藏庫。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0z",
      "text": "右司諫",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歷開封府推官、三司度支判官，拜右司諫。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
