      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "權知制誥。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知秦州",
      "place_id": "hixicl857jgj",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "琦亦上章自劾，猶奪一官，知秦州，尋復之。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "方謀取橫山，規河南，而元昊稱臣，召為樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8p77g8w",
      "text": "安撫使",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼安撫使，進大學士，又加觀文殿學士。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk2",
      "text": "大學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼安撫使，進大學士，又加觀文殿學士。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十二·韓琦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼安撫使，進大學士，又加觀文殿學士。"
