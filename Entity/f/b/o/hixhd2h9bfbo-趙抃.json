  "offices": [
    {
      "office_id": "hixia8mn4g00",
      "text": "武安軍節度推官",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進士及第，為武安軍節度推官。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0z",
      "text": "右司諫",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為右司諫。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyw",
      "text": "度支副使",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為侍御史知雜事，改度支副使，進天章閣待制、河北都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為侍御史知雜事，改度支副使，進天章閣待制、河北都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加龍圖閣直學士、知成都，以寬為治。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "及謝，帝曰：「聞卿匹馬入蜀，以一琴一鶴自隨，為政簡易，亦稱是乎？」未幾，擢參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "奏入，懇乞去位，拜資政殿學士、知杭州，改青州，時京東旱蝗，青獨多麥，蝗來及境，遇風退飛，盡墮水死。"
        }
      ]
    },
    {
      "office_id": "hixia8n8nthf",
      "text": "太子少師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十六·趙抃傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太子少師，諡曰清獻。"
        }
      ]
    }
  ],
