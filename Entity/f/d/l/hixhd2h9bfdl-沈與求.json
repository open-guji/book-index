        "source_bid": "d59dh3vo9af4",
        "details": "宋沈與求撰。"
      },
      {
        "name": "《宋史·沈與求傳》",
        "details": "卷372，傳首：沈與求，字必先，湖州德清人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以御史張守薦，召對，除監察御史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上疏論執政，遷兵部員外郎，自劾以為言苟不當，不應得遷。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上乃行其言，除殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "宗尹罷，召還，再除侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8p77g8w",
      "text": "荊湖南路安撫使",
      "place_id": "hixiclu1dr14",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上時有所訓敕，每曰：「汝不識沈中丞邪？」移吏部尚書兼權翰林學士兼侍讀，遂出為荊湖南路安撫使、知潭州。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復以吏部尚書召，除參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七年，上在平江，召見，除同知樞密院事；從至建康，遷知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegoy",
      "text": "知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·沈與求傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七年，上在平江，召見，除同知樞密院事；從至建康，遷知樞密院事。"
