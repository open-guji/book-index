  },
  "offices": [
    {
      "office_id": "hixia8mg981v",
      "text": "宣德郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以省員罷，改宣德郎，擢為監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8mpmcch",
      "text": "起居郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除起居郎兼直學士院。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷御史中丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除禮部侍郎，不拜，上命呂頤浩至政事堂，諭以正人端士不宜輕去，守始受命。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九月，拜端明殿學士、同簽書樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "四年五月，除參知政事，守嘗薦汪伯彥，沈與求劾其短，以資政殿學士提舉洞霄宮。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知紹興府",
      "place_id": "hixicl857jia",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，知紹興府。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知平江府",
      "place_id": "hixicl857jik",
      "sources": [
        {
          "title": "《宋史》卷三百七十五·張守傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累請去郡，以提舉萬壽觀兼侍讀召還，甫兩月，復引病丐去，知平江府，力丐祠以歸。"
        }
      ]
    }
  ],
