  "offices": [
    {
      "office_id": "hixia8ots8w0",
      "text": "太學正",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "累遷太學正。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除太常博士，改提舉江東常平茶鹽。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "檜死，起知漢州，將出峽，召對，除吏部侍郎。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptu",
      "text": "吏部尚書",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除吏部尚書。"
        }
      ]
    },
    {
      "office_id": "hixia8n0uvwh",
      "text": "光祿大夫",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明年三月，拜光祿大夫、尚書左僕射。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6r",
      "text": "醴泉觀使",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "已又辭郡，丐外祠，除醴泉觀使。"
        }
      ]
    },
    {
      "office_id": "hixia8nf7sw3",
      "text": "尚書左僕射",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未出里門，拜尚書左僕射、同中書平章事兼樞密使，進封魯國公。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太師，諡「文恭」，擇日臨奠，子偉節固辭，乃止。"
        }
      ]
    },
    {
      "office_id": "hixia8p1wf0g",
      "text": "直秘閣",
      "sources": [
        {
          "title": "《宋史》卷三百八十四·陳康伯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二子：偉節，除直秘閣；安節，賜同進士出身，五辭不受，上手劄批諭，寄留省中以成其美，康伯薨，給還之。"
        }
      ]
    }
  ]
