    {
      "office_id": "hixielw78sg8",
      "text": "翰林待制",
      "sources": [
        {
          "title": "《元史》卷一百八十一·揭傒斯傳",
          "source_bid": "d59f2njivtog",
          "details": "元統初，詔對便殿，慰諭良久，命賜以諸王所服表裏各一，躬自辯識以授之，遷翰林待制，陞集賢學士，階中順大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8pd4ykj",
      "text": "翰林直學士",
      "sources": [
        {
          "title": "《元史》卷一百八十一·揭傒斯傳",
          "source_bid": "d59f2njivtog",
          "details": "既而天子親擢為奎章閣供奉學士，乃即日就道，未至，改翰林直學士，及開經筵，再陞侍講學士、同知經筵事，以對品進階中奉大夫。"
        }
      ]
    }
  ]
