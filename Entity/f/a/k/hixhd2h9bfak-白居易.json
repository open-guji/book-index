  "offices": [
    {
      "office_id": "hiximdfhd4ox",
      "text": "左拾遺",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "三年五月，拜左拾遺。"
        }
      ]
    },
    {
      "office_id": "hiximd4offvh",
      "text": "司門員外郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "其年冬，召還京師，拜司門員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8pdg741",
      "text": "朝散大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "明年，轉主客郎中、知制誥，加朝散大夫，始著緋。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "杭州刺史",
      "place_id": "hixicl8d0h3m",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "七月，除杭州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8o1ow00",
      "text": "太子賓客",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "三年，稱病東歸，求為分司官，尋除太子賓客。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "同州刺史",
      "declined": true,
      "place_id": "hixicl85iryp",
      "start": 836,
      "end": 836,
      "date_text": "開成元年",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "開成元年，除同州刺史，辭疾不拜。"
        }
      ]
    },
    {
      "office_id": "hixia8pg9c01",
      "text": "太子少傅",
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋授太子少傅，進封馮翊縣開國侯。"
        }
      ]
    },
    {
      "office_id": "hixikfedch26",
      "text": "尚書右僕射",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百六十六·白居易傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "大中元年卒，時年七十六，贈尚書右僕射。"
        }
      ]
    },
    {
      "office_id": "hiximdfhd4ox",
      "text": "左拾遺",
      "sources": [
        {
          "title": "《新唐書》卷一百一十九·白居易傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷左拾遺。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "忠州刺史",
      "place_id": "hixicl8att7p",
      "sources": [
        {
          "title": "《新唐書》卷一百一十九·白居易傳",
          "source_bid": "d59f2htqolj5",
          "details": "久之，徙忠州刺史。"
        }
      ]
    },
    {
      "office_id": "hiximd4offvh",
      "text": "司門員外郎",
      "sources": [
        {
          "title": "《新唐書》卷一百一十九·白居易傳",
          "source_bid": "d59f2htqolj5",
          "details": "入為司門員外郎，以主客郎中知制誥。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "杭州刺史",
      "place_id": "hixicl8d0h3m",
      "sources": [
        {
          "title": "《新唐書》卷一百一十九·白居易傳",
          "source_bid": "d59f2htqolj5",
          "details": "為杭州刺史，始築堤捍錢塘湖，鐘泄其水，溉田千頃。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gc",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百一十九·白居易傳",
          "source_bid": "d59f2htqolj5",
          "details": "文宗立，以秘書監召，遷刑部侍郎，封晉陽縣男。"
        }
      ]
    },
    {
      "office_id": "hixia8pg9c01",
      "text": "太子少傅",
      "sources": [
        {
          "title": "《新唐書》卷一百一十九·白居易傳",
          "source_bid": "d59f2htqolj5",
          "details": "開成初，起為同州刺史，不拜，改太子少傅，進馮翊縣侯。"
        }
      ]
    }
