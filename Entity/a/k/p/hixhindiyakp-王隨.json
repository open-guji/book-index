  "native_place_basis": "《宋史》卷311本傳著錄「河南人」",
  "description": {
    "text": "河南人。登進士甲科，為淮南轉運使貸民市種糧；權知開封府，仁宗為太子時兼右庶子；明道中為參知政事，拜門下侍郎、同中書門下平章事、昭文館大學士；為相一年無所建明，與陳堯佐等俱罷，判河陽卒，贈中書令。性喜佛。",
    "sources": [
      {
        "name": "《宋史·王隨傳》",
        "details": "卷311"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpuc",
      "text": "秘書省著作郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "登進士甲科，為將作監丞、通判同州，遷秘書省著作郎、直史館、判三司磨勘司。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "京西轉運副使",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為京西轉運副使，陛辭，且言曰：「臣父母家洛中，乃在所部，得奉湯藥，聖主之澤也。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "淮南轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷淮南轉運使，父憂，起復。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河東轉運使",
      "place_id": "hixiclu1dr0x",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙河東轉運使，三遷刑部員外郎兼侍御史知雜事。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢知制誥，以不善制辭，出知應天府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再加右諫議大夫、權知開封府。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復給事中，為龍圖閣直學士、知秦州。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入為御史中丞，同知禮部貢舉，遷尚書禮部侍郎、翰林侍讀學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加吏部侍郎、知樞密院事，為莊惠皇太后園陵監護使，拜門下侍郎、同中書門下平章事、昭文館大學士、監修國史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu9",
      "text": "門下侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加吏部侍郎、知樞密院事，為莊惠皇太后園陵監護使，拜門下侍郎、同中書門下平章事、昭文館大學士、監修國史。"
        }
      ]
    },
    {
      "office_id": "hixia8ojheyp",
      "text": "中書令",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十一·王隨傳",
          "source_bid": "d59f2gonq7sy",
          "details": "薨，贈中書令，諡章惠，後改文惠。"
        }
      ]
    }
  ]
