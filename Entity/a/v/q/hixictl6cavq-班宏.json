  "description": {
    "text": "衛州汲人。天寶中進士，為高適劍南判官；使成德卻李惟岳之賄；貞元中為戶部尚書，與竇參、張滂分掌財賦，卒年七十三，諡敬。",
    "sources": [
      {
        "name": "《新唐書·列傳第七十四》",
        "details": "卷149"
      },
      {
        "name": "《舊唐書·列傳第七十三》",
        "details": "卷123"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfedch23",
      "text": "大理司直",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十三·班宏傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "宏少舉進士，授右司禦胄曹，後為薛景先鳳翔掌書記，又為高適劍南觀察判官，累拜大理司直，攝監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8o6zx8i",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十三·班宏傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "大歷三年，遷起居舍人，尋兼理匭使，四遷至給事中。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gc",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十三·班宏傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "惟嶽厚賂宏，皆不受，還報合旨，遷刑部侍郎，兼京官考使。"
        }
      ]
    }
  ],
