  "description": {
    "text": "渭州隴西人。寶應中以褐衣上疏請儉葬泰、建二陵；為湖南觀察使，李泌薦之；貞元八年同平章事，輔政五年，卒年六十一，諡貞憲。",
    "sources": [
      {
        "name": "《新唐書·列傳第七十五》",
        "details": "卷150"
      },
      {
        "name": "《舊唐書·列傳第八十八》",
        "details": "卷138"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5v2mknb6",
      "text": "監察御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十八·趙憬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "累遷監察御史，隨牒籓府，歷殿中侍御史、太子舍人。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "潭州刺史",
      "place_id": "hixicl83nctz",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十八·趙憬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋授潭州刺史、兼御史中丞、湖南觀察使，仍賜金紫。"
        }
      ]
    },
    {
      "office_id": "hixi5v2m9es3",
      "text": "給事中",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十八·趙憬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "憬多學問，有辭辯，敷奏稱旨，上悅，拜給事中。"
        }
      ]
    },
    {
      "office_id": "hixikfedch21",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十八·趙憬傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "使還，遷尚書左丞，綱轄省務，清勤奉職。"
        }
      ]
    }
  ],
