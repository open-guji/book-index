  "description": {
    "text": "鐵勒渾部人，渾釋之之子。十一歲從軍立跳蕩功，安史亂中從郭子儀、李光弼；德宗奉天之難固守奉天，收復長安，為河中節度使；貞元三年平涼會盟脫身；十五年卒，年六十四，諡忠武。",
    "sources": [
      {
        "name": "《新唐書·列傳第八十》",
        "details": "卷155"
      },
      {
        "name": "《舊唐書·列傳第八十四》",
        "details": "卷134"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfed18mm",
      "text": "右驍衛將軍",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十四·渾瑊傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "賊將有李立節者，素稱驍勇，與瑊格鬥，臨陣斬之，遷右驍衛將軍。"
        }
      ]
    },
    {
      "office_id": "hixikfed18n3",
      "text": "開府儀同三司",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十四·渾瑊傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "朝義平，加開府儀同三司、太常卿，賜實封二百戶。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "邠州刺史",
      "place_id": "hixicl88bwuz",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十四·渾瑊傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十一年，領邠州刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiq",
      "text": "中書令",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十四·渾瑊傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十二年二月，加檢校司徒，兼中書令，諸使、副元帥如故。"
        }
      ]
    },
    {
      "office_id": "hixia8o1ow00",
      "text": "太子賓客",
      "sources": [
        {
          "title": "《新唐書》卷一百五十五·渾瑊傳",
          "source_bid": "d59f2htqolj5",
          "details": "虜復入，至奉天，瑊戰漠谷，有功，遷太子賓客，屯奉天。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "邠州刺史",
      "place_id": "hixicl88bwuz",
      "sources": [
        {
          "title": "《新唐書》卷一百五十五·渾瑊傳",
          "source_bid": "d59f2htqolj5",
          "details": "自是歲防長武城盛秋，領邠州刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiz",
      "text": "侍中",
      "kind": "兼",
      "sources": [
        {
          "title": "《新唐書》卷一百五十五·渾瑊傳",
          "source_bid": "d59f2htqolj5",
          "details": "泚平，論功，以瑊兼侍中，實封戶八百。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiq",
      "text": "中書令",
      "kind": "兼",
      "sources": [
        {
          "title": "《新唐書》卷一百五十五·渾瑊傳",
          "source_bid": "d59f2htqolj5",
          "details": "進檢校司徒，兼中書令。"
        }
      ]
    },
    {
      "office_id": "hixia8oo5z40",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百五十五·渾瑊傳",
          "source_bid": "d59f2htqolj5",
          "details": "群臣奉慰延英，贈太師，諡曰忠武。"
        }
      ]
    }
  ],
