  "description": {
    "text": "河中虞鄉人。明經及第，大曆中為送崇徽公主判官，折服回紇；貞元五年同平章事，後為宣武節度使，以寬厚安輯軍亂，視事八年卒，贈尚書右僕射。",
    "sources": [
      {
        "name": "《新唐書·列傳第七十六》",
        "details": "卷151"
      },
      {
        "name": "《舊唐書·列傳第九十五》",
        "details": "卷145"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5v2mknba",
      "text": "校書郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十五·董晉傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "至德初，肅宗自靈武幸彭原，晉上書謁見，授校書郎、翰林待制，再轉衛尉丞，出為汾州司馬。"
        }
      ]
    },
    {
      "office_id": "hixi5wrblts4",
      "text": "判官",
      "kind": "充",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十五·董晉傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "未幾，刺史崔圓改淮南節度，奏晉以本官攝殿中侍御史，充判官，尋歸臺，授本官，遷侍御史、主客員外郎、祠部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8olo2rk",
      "text": "侍御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百四十五·董晉傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "未幾，刺史崔圓改淮南節度，奏晉以本官攝殿中侍御史，充判官，尋歸臺，授本官，遷侍御史、主客員外郎、祠部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8ml90qo",
      "text": "太常卿",
      "sources": [
