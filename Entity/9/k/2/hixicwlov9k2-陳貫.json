  "title_or_office": "利州路轉運使",
  "description": {
    "text": "其先相州安陽人，家河陽。真宗識其名擢置高第，知衛、涇州嚴察吏治；為利州路轉運使出職田粟賑饑；上《形勢》《選將》《練兵論》三篇，著《兵略》。",
    "sources": [
      {
        "name": "《宋史·陳貫傳》",
        "details": "卷303"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nu76yr",
      "text": "秘書丞",
      "sources": [
        {
          "title": "《宋史》卷三百零三·陳貫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為臨安縣主簿，以秘書省著作佐郎為刑部詳覆官，改秘書丞，為審刑院詳議官，歷知衛州、涇州。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "利州路轉運使",
      "place_id": "hixiclu1dr0n",
      "sources": [
        {
          "title": "《宋史》卷三百零三·陳貫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢利州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河北轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百零三·陳貫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "領河北轉運使，請疏徐、鮑、曹、易四水，興屯田。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知相州",
      "place_id": "hixicl84waz2",
      "sources": [
        {
          "title": "《宋史》卷三百零三·陳貫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙河東，歷三司戶部、鹽鐵副使，以刑部郎中直昭文館，知相州。"
        }
      ]
    }
  ],
