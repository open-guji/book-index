      "text": "左騏驥副使",
      "sources": [
        {
          "title": "《宋史》卷三百二十三·范恪傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改左騏驥副使。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3ke",
      "text": "宮苑副使",
      "sources": [
        {
          "title": "《宋史》卷三百二十三·范恪傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改宮苑副使、環慶路兵馬都監，因特召見。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3ky",
