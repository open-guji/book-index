  "dates": {
    "death": 763,
    "basis": "據《新唐書》本傳"
  },
  "description": {
    "text": "邠州永壽人，來曜之子。天寶中以張鎬薦為潁川太守，安祿山反，屢破賊於潁川，號「來嚼鐵」；後為山南東道節度使，寶應初入朝為兵部尚書同平章事，為程元振所構，貶播州尉，賜死。",
    "sources": [
      {
        "name": "《新唐書·列傳第六十九》",
        "details": "卷144"
      },
      {
        "name": "《舊唐書·列傳第六十四》",
        "details": "卷114"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8pq8xdv",
      "text": "鴻臚卿",
      "start": 730,
      "end": 730,
      "date_text": "開元十八年",
      "sources": [
        {
          "title": "《舊唐書》卷一百一十四·來瑱傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "開元十八年，為鴻臚卿同正員、安西副都護、持節磧西副大使、四鎮節度使，後為右領軍大將軍、仗內五坊等使，名著西陲。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0si",
      "text": "太子太保",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百一十四·來瑱傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "寶應元年，以子貴，贈太子太保。"
        }
      ]
    },
    {
      "office_id": "hixia8pgvt35",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·來瑱傳",
          "source_bid": "d59f2htqolj5",
          "details": "天寶初，從四鎮任劇職，累遷殿中侍御史、伊西北庭行軍司馬。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g9",
      "text": "兵部尚書",
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·來瑱傳",
          "source_bid": "d59f2htqolj5",
          "details": "瑱因入朝謝罪，帝待之無疑，拜兵部尚書、同中書門下平章事，充山陵使。"
        }
      ]
    },
    {
      "office_id": "hixia8pk06io",
      "text": "行軍司馬",
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·來瑱傳",
          "source_bid": "d59f2htqolj5",
          "details": "瑱鎮陜州，引為判官，移襄州，又為行軍司馬，遇之厚。"
        }
      ]
    }
  ],
