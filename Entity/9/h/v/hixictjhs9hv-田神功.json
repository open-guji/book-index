  "primary_name": "田神功",
  "dynasty": "唐",
  "dynasty_basis": "據正史本傳",
  "period": "sui-tang",
  "period_basis": "據 dynasty「唐」歸併",
  "title_or_office": "汴宋節度使",
  "dates": {
    "death": 774,
    "basis": "據《新唐書》本傳"
  },
  "description": {
    "text": "冀州南宮人。天寶末為縣吏，從安史軍為平盧兵馬使後歸唐；助鄧景山討劉展，大掠揚州；後為汴宋節度使，大曆九年入朝卒，贈司徒。",
    "sources": [
      {
        "name": "《新唐書·列傳第六十九》",
        "details": "卷144"
      },
      {
        "name": "《舊唐書·列傳第七十四》",
        "details": "卷124"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8pq8xdv",
      "text": "鴻臚卿",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十四·田神功傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "上元元年，為平盧節度都知兵馬使，兼鴻臚卿，於鄭州破賊四千余眾，生擒逆賊大將四人，牛馬器械不可勝數。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gd",
      "text": "檢校工部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十四·田神功傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "以擒展功，累遷檢校工部尚書、兼御史大夫、汴宋等八州節度使。"
        }
      ],
      "kind": "檢校"
    },
    {
      "office_id": "hixia8oaqrr7",
      "text": "司徒",
      "posthumous": true,
      "sources": [
        {
          "title": "《舊唐書》卷一百二十四·田神功傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "上悼惜，為之徹樂，廢朝三日；贈司徒，賻絹一千匹、布五百端；特許百官吊喪，賜屏風茵褥於靈座，並賜千僧齋以追福，至德已來，將帥不兼三事者，哀榮無比。"
        }
      ]
    },
    {
      "office_id": "hixia8pjdpfl",
      "text": "淄青節度使",
      "place_id": "hiximxkt4c9s",
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·田神功傳",
          "source_bid": "d59f2htqolj5",
          "details": "俄而禽展送京師，遷淄青節度使。"
        }
      ]
    },
    {
      "office_id": "hixikfedch26",
      "text": "檢校尚書右僕射",
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·田神功傳",
          "source_bid": "d59f2htqolj5",
          "details": "大歷二年來朝，加檢校尚書右僕射，詔宰相百官送至省。"
        }
      ],
      "kind": "檢校"
    },
    {
      "office_id": "hixia8ntvyf7",
      "text": "太子太師",
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·田神功傳",
          "source_bid": "d59f2htqolj5",
          "details": "又判左僕射，知省事，加太子太師，還軍。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr7",
      "text": "司徒",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百四十四·田神功傳",
          "source_bid": "d59f2htqolj5",
          "details": "八年，自力入朝，卒，代宗為徹樂，贈司徒，詔其弟曹州刺史神玉知汴州留事，賻絹千匹、布五百端，百官吊喪，賜屏風茵褥，飯千桑門追福。"
        }
      ]
    }
  ],
