  "description": {
    "text": "陝州安邑人。從哥舒翰拔石堡城，從魯炅守鄧州；德宗時破吐蕃於蜀，為陳許節度使，討李希烈有功；貞元十五年卒，年七十四，贈司空。",
    "sources": [
      {
        "name": "《新唐書·列傳第七十二》",
        "details": "卷147"
      },
      {
        "name": "《舊唐書·列傳第七十二》",
        "details": "卷122"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfedcgzk",
      "text": "特進",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十二·曲環傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "大歷中領兵隴州，頻破吐蕃，加特進、太常卿。"
        }
      ]
    },
    {
      "office_id": "hixia8o1ow00",
      "text": "太子賓客",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十二·曲環傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "環大振功名而還，加太子賓客，賜以名馬。"
        }
      ]
    },
    {
      "office_id": "hixikfed18n3",
      "text": "開府儀同三司",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十二·曲環傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "與諸將討涇州叛將劉文喜，平之，加開府儀同三司、兼御史中丞，充邠、隴兩軍都知兵馬使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "陳州刺史",
      "kind": "兼",
      "place_id": "hixicl84wb1z",
      "sources": [
        {
          "title": "《舊唐書》卷一百二十二·曲環傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "環以功加檢校工部尚書，兼陳州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8o1ow00",
      "text": "太子賓客",
      "sources": [
        {
          "title": "《新唐書》卷一百四十七·曲環傳",
          "source_bid": "d59f2htqolj5",
          "details": "德宗初，虜寇劍南，詔環以邠、隴兵五千馳救，收七盤城、威武軍、維茂等州，虜破走，威名大振，加太子賓客，賜名馬。"
        }
      ]
    },
    {
      "office_id": "hixikfed18n3",
      "text": "開府儀同三司",
      "sources": [
        {
          "title": "《新唐書》卷一百四十七·曲環傳",
          "source_bid": "d59f2htqolj5",
          "details": "豫討涇州劉文喜，遷開府儀同三司，封晉昌郡王，邠隴兵馬使。"
        }
