  "description": {
    "text": "竇誕四世孫。學律令，嚴斷不撓；貞元五年以中書侍郎同平章事兼度支鹽鐵轉運使，專權任親，為陸贄等所論，貶郴州別駕，又貶驩州司馬，賜死邕州，年六十。",
    "sources": [
      {
        "name": "《新唐書·列傳第七十》",
        "details": "卷145"
      },
      {
        "name": "《舊唐書·列傳第八十六》",
        "details": "卷136"
      },
      {
        "title": "《陝西通志》卷64·人物",
        "source_bid": "d59f2n7golxd",
        "details": "竇參字時中刑部尚書誕四世孫學律令為人矜嚴悻直以䕃累為萬年尉同舎當夕直者聞親疾惶遽參為代之㑹失囚京兆按直簿劾其人參曰彼往參當坐乃貶江夏尉人皆義之進大理司直按江淮獄……"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5v2mknb6",
      "text": "監察御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十六·竇參傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "明年，除監察御史，奉使按湖南判官馬彜獄。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszd4",
      "text": "金部員外郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十六·竇參傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "參轉殿中侍御史，改金部員外郎、刑部郎中、侍御史、知雜事。"
        }
      ]
    },
    {
      "office_id": "hixia8o9t24k",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十六·竇參傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "無幾，遷御史中丞，不避權貴，理獄以嚴稱。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g6",
      "text": "戶部侍郎",
      "kind": "兼",
      "sources": [
        {
          "title": "《舊唐書》卷一百三十六·竇參傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋兼戶部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
