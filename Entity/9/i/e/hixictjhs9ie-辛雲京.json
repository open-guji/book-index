      "office_id": "hixikfed18n3",
      "text": "開府儀同三司",
      "sources": [
        {
          "title": "《新唐書》卷一百四十七·辛雲京傳",
          "source_bid": "d59f2htqolj5",
          "details": "錄多，授開府儀同三司，加代州都督、鎮北兵馬使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqiq",
      "text": "太尉",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百四十七·辛雲京傳",
          "source_bid": "d59f2htqolj5",
          "details": "卒，年五十五，代宗為發哀流涕，贈太尉，謚曰忠獻。"
        }
      ]
