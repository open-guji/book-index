  "description": {
    "text": "廬陵人。第進士，攝台州葬溺死者、築城；為侍御史抗疏論張堯佐、王守忠覬恩，解臺職；英宗時論歐陽修首建濮議，詔問所從來不肯對，出知黃州；熙寧三年以戶部侍郎致仕卒。幼時拾金釵還失主。",
    "sources": [
      {
        "name": "《宋史·彭思永傳》",
        "details": "卷320"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百二十·彭思永傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入為侍御史，論內降授官賞之弊，謂斜封非盛世所當有，仁宗深然之。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "湖北轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百二十·彭思永傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝怒，中丞郭勸、諫官吳奎為之請，乃以泛恩轉司封員外郎而解臺職，為湖北轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百二十·彭思永傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋為戶部副使，擢天章閣待制、河北都轉運使、知瀛州。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷三百二十·彭思永傳",
          "source_bid": "d59f2gonq7sy",
          "details": "治平中，召為御史中丞。"
        }
      ]
    }
  ],
