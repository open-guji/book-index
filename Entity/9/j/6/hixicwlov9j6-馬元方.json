  "native_place_basis": "《宋史》卷301本傳著錄「濮州鄄城人」",
  "title_or_office": "兵部侍郎",
  "description": {
    "text": "濮州鄄城人。父應圖沒於幽州之役，元方去髮為浮屠求父屍。淳化三年進士，請預貸庫錢令夏秋輸絹，下其法諸路；權三司使公事以煩苛罷，後以樞密直學士知幷州，留再任，官至兵部侍郎卒。",
    "sources": [
      {
        "name": "《宋史·馬元方傳》",
        "details": "卷301"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以勞，遷本寺丞，為御史臺推勘官，遷殿中丞。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知徐州，改太常博士、梓州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知鄆州",
      "place_id": "hixifx69t1qb",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "後知鄆州，量括牧地數千頃。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "京東轉運副使",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為京東轉運副使，遷轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為京東轉運副使，遷轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知應天府",
      "place_id": "hixicl84l2fi",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙滑州，為京西轉運使，知應天府，累遷太常少卿。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙滑州，為京西轉運使，知應天府，累遷太常少卿。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢右諫議大夫、權三司使公事，眾論不以為允。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進給事中、權知開封府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·馬元方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "官至兵部侍郎，卒。"
        }
      ]
    }
  ],
