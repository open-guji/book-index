  "title_or_office": "龍圖閣直學士",
  "description": {
    "text": "邛州依政人。少放蕩，兄綯教之書。元昊犯延州時攝守邠州發民治城，帝因詔他州悉治守備；為湖南轉運使諭蠻罷兵；權知開封府，以醉奏事及誤釋慈孝寺盜，詘知蘇州，未行卒。性嗜酒。",
    "sources": [
      {
        "name": "《宋史·李絢傳》",
        "details": "卷302"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷三百零二·李絢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢進士第，再授大理評事、通判邠州。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "京西轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百零二·李絢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還為太子中允、直集賢院，歷開封府推官、三司度支判官，為京西轉運使。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷三百零二·李絢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改太常丞，徙洪州。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "湖南轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百零二·李絢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "輔臣以絢對，遂除湖南轉運使。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百零二·李絢傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以右正言、知制誥奉使契丹，知審官院，遷龍圖閣直學士、起居舍人、權知開封府，治有能名。"
        }
      ]
    }
  ],
