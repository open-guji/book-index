  "description": {
    "text": "歙州新安人。父諤南唐秘書丞，歸宋。秉舉進士，景德初守滑州部丁夫鑿淩以防契丹南渡；歷工部、禮部侍郎，加樞密直學士，兩知幷州。",
    "sources": [
      {
        "name": "《宋史·張秉傳》",
        "details": "卷301"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximxfukl59",
      "text": "右贊善大夫",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "宋師南伐，與州將許昌裔叶議歸款，太祖召見，勞賜良厚，授右贊善大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "西川轉運副使",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國中，即除西川轉運副使。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷監察御史，深為宰相趙普所器，以弟之子妻之。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0z",
      "text": "右司諫",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，直昭文館，遷右司諫。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷工部郎中，依前知制誥。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知河南府",
      "place_id": "hixicl84l2i0",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁母憂，起復，知河南府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召歸闕，復判吏部銓，拜工部侍郎、同知審官院、通進銀臺司，糾察在京刑獄。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·張秉傳",
          "source_bid": "d59f2gonq7sy",
          "details": "出知永興軍府，會祀汾陰，為東京留守判官，轉禮部侍郎，加樞密直學士，復知幷州。"
        }
      ]
    }
  ],
