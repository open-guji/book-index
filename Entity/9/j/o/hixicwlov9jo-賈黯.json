  "description": {
    "text": "鄧州穰人。擢進士第一，為諫官首論韓琦、富弼、范仲淹可大用；濮議請以濮王為皇伯，數詣中書力爭，治平中大雨水，疏言執政阿諛致災；以翰林侍讀學士知陳州，未行卒，遺奏猶請濮王議，贈禮部侍郎。",
    "sources": [
      {
        "name": "《宋史·賈黯傳》",
        "details": "卷302"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8p3glq9",
      "text": "左正言",
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還為秘書省著作佐郎、直集賢院，遷左正言、判三司開拆司。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6u",
      "text": "左司諫",
      "start": 1052,
      "end": 1052,
      "date_text": "皇祐四年",
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "皇祐四年，同修起居注，徙判鹽鐵勾院，遷左司諫。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "服除，勾當三班院，為翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixia8m5bx1c",
      "text": "侍讀學士",
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以疾請郡，改侍讀學士、知鄧州。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "英宗即位，遷中書舍人。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl5n",
      "text": "群牧使",
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "受詔撰《仁宗實錄》，權知審刑院，為群牧使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "尚書禮部侍郎",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百〇二·賈黯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈尚書禮部侍郎。"
        }
      ]
    }
