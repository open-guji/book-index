  "title_or_office": "權三司使",
  "description": {
    "text": "汝州臨汝人。擢進士，擒李順餘黨謝才盛，權領施州募人入米償鹽以足軍食；守益州奏行交子務；總領修滑州決河；權知開封府。天聖末再使契丹，未行而卒。初附丁謂。朝臣回封祖母自瑊始。",
    "sources": [
      {
        "name": "《宋史·寇瑊傳》",
        "details": "卷301"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "就除大理寺丞、知開州，遷殿中丞、通判河南府。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以太常博士通判幷州，改監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿中侍御史，為開封府判官。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpub",
      "text": "開封府判官",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿中侍御史，為開封府判官。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyy",
      "text": "三司鹽鐵判官",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "就加侍御史，召為三司鹽鐵判官，逾月，出為河北轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河北轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "就加侍御史，召為三司鹽鐵判官，逾月，出為河北轉運使。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷工部郎中，上言：「契丹約和以來，河北減戍卒之半，而復刺土兵，其實益三分之一，而塞下軍儲不給。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙鄧州，坐失舉，降少府監、知金州，復右諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "河平，擢樞密直學士。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明年，復給事中、知秦州，又坐失舉奪一官。"
        }
      ]
    },
    {
      "office_id": "hixia8osjaps",
      "text": "知開封府",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百〇一·寇瑊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "權知開封府，戚里有毆妻至死，更赦事發者。"
        }
      ]
    }
  ],
