  "native_place_basis": "《宋史》卷301本傳著錄「河中河東人」",
  "title_or_office": "右諫議大夫",
  "description": {
    "text": "河中河東人。少師事种放，與魏野友善。為益州路轉運使時請置交子務以榷其出入，後寇瑊卒奏用其議；歷知河南府、開封府、益州，以右諫議大夫知延州，徙同州卒。",
    "sources": [
      {
        "name": "《宋史·薛田傳》",
        "details": "卷301"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改著作佐郎、知中江縣。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，拜監察御史，以母憂去。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿中侍御史、權三司度支判官，改侍御史、益州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷殿中侍御史、權三司度支判官，改侍御史、益州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8nggr2b",
      "text": "直昭文館",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "就除陝西轉運使，進直昭文館、知河南府，復入度支為副使。"
        }
      ]
    },
    {
      "office_id": "hixia8p7iosg",
      "text": "龍圖閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "使契丹還，擢龍圖閣待制、知天雄軍。"
        }
      ]
    },
    {
      "office_id": "hixia8osjaps",
      "text": "知開封府",
      "sources": [
        {
          "title": "《宋史》卷三百零一·薛田傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，擢知開封府，以樞密直學士知益州，累遷左司郎中。"
        }
      ]
    }
  ],
