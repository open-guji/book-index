      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mum51d",
      "text": "知蘭溪縣",
      "place_id": "hixicl857jjc",
      "sources": [
        {
          "title": "《宋史》卷四百〇八·汪綱傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋丁父喪，服除，知蘭溪縣，決擿如神。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷四百〇八·汪綱傳",
          "source_bid": "d59f2gonq7sy",
          "details": "理宗即位，詔為右文殿修撰，加集英殿修撰，復因任，又加寶謨閣待制。"
        }
      ]
    },
