        {
          "title": "《宋史》卷四百六十七·王中正傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂從王韶入熙河，治城壁守具，以功遷作坊使、嘉州團練使，擢內侍押班。"
        }
      ]
    },
    {
      "office_id": "hixigfk6ivi8",
      "text": "昭宣使",
      "sources": [
        {
