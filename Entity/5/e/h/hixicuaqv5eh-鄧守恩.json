  "description": {
    "text": "并州人。十歲事太宗，從王繼恩討蜀；監修玉清昭應宮、景靈宮，修河鈐轄；長七尺餘，以強果稱，天禧五年卒，年四十八，贈淄州防禦使。",
    "sources": [
      {
        "name": "《宋史·宦者傳·鄧守恩》",
        "details": "卷466"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3lg",
      "text": "內殿承制",
      "sources": [
        {
          "title": "《宋史》卷四百六十六·鄧守恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "宮成，遷內殿承制。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l7",
      "text": "西京作坊副使",
      "start": 1015,
      "end": 1015,
      "date_text": "八年",
      "basis": "承上文年號大中祥符",
      "sources": [
        {
          "title": "《宋史》卷四百六十六·鄧守恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年，預修大內，改西京作坊副使。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l8",
      "text": "東染院使",
      "start": 1016,
      "end": 1016,
      "date_text": "九年",
      "basis": "承上文年號大中祥符",
      "sources": [
        {
          "title": "《宋史》卷四百六十六·鄧守恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九年，營造皆畢，授東染院使，充會靈觀都監。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l2",
      "text": "崇儀使",
      "sources": [
        {
          "title": "《宋史》卷四百六十六·鄧守恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "天禧二年，掌軍頭引見司，又修祥源觀成，遷崇儀使。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l0",
      "text": "如京使",
      "sources": [
        {
          "title": "《宋史》卷四百六十六·鄧守恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "郊祀，召為行宮使，改如京使，復還本任。"
        }
      ]
    },
    {
      "office_id": "hixigfk17u9s",
      "text": "入內副都知",
      "sources": [
        {
          "title": "《宋史》卷四百六十六·鄧守恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "是秋，掌皇城、國信二司，整肅禁衛，遷入內副都知。"
        }
      ]
    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "淄州防禦使",
      "posthumous": true,
      "place_id": "hixicl84l2fb",
