  "description": {
    "text": "宗室，燕懿王八世孫。嘉定七年進士，中明法科；歷戶部、吏部尚書，論邊事深切，拜少傅卒，追封奉化郡王，諡清敏。",
    "sources": [
      {
        "name": "《宋史·趙與懽傳》",
        "details": "卷413"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "免喪，授大理評事。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30o",
      "text": "宗正丞",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，拜宗正寺簿，歷軍器監、司農寺丞，遷宗正丞兼權都官郎官，改倉部，權度支，以直寶章閣知安吉州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu3",
      "text": "宗正少卿",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼權檢正，遷宗正少卿兼權戶部侍郎，尋兼知臨安府、浙西安撫使，同詳定，剖決明暢，罪者咸服。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷戶部侍郎兼權兵部尚書，論邊事至為深切。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "力求納祿，授資政殿學士、提舉萬壽觀兼侍讀、監修國史、實錄院修撰。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "安德軍節度使",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋授安德軍節度使、開府儀同三司、萬壽觀使。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0x",
      "text": "少傅",
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜少傅，卒，遺表猶不忘規正。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "少師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百一十三·趙與懽傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝震悼輟朝，賻贈有加，詔有司治葬，贈少師，追封奉化郡王，諡「清敏」，累贈太師。"
        }
      ]
    },
