  "description": {
    "text": "台州寧海人。太學上舍兩優釋褐；度宗時拜右丞相兼樞密使，為賈似道所掣肘，屢辭歸，宋亡後卒。",
    "sources": [
      {
        "name": "《宋史·葉夢鼎傳》",
        "details": "卷414"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mqk1z7",
      "text": "秘書省正字",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "同番易湯巾召試館職，授秘書省正字。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb8",
      "text": "秘書郎",
      "start": 1245,
      "end": 1245,
      "date_text": "五年",
      "basis": "承上文年號淳祐",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年，遷秘書郎，轉對，言定國本，求哲輔，專閫帥，獎用介直。"
        }
      ]
    },
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "雷變上言，援唐康澄「五可畏」之說，遷著作佐郎。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p1",
      "text": "軍器少監",
      "start": 1246,
      "end": 1246,
      "date_text": "六年",
      "basis": "承上文年號淳祐",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "六年，拜軍器少監兼兵部郎官，轉對，言國計、邊事、國體三事。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktg6",
      "text": "司封員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "十一年，免喪，拜司封員外郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32c",
      "text": "崇政殿說書",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "考試集英殿，授崇政殿說書，進講《尚書》。"
        }
      ]
    },
    {
      "office_id": "hixia8mj2cxu",
      "text": "國子祭酒",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼國史編修、實錄檢討，遷國子祭酒。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "kind": "權",
      "start": 1255,
      "end": 1255,
      "date_text": "三年",
      "basis": "承上文年號寶祐",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，權禮部侍郎，仍兼祭酒，升兼同修國史、實錄院同修撰，尋兼侍講。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sg",
      "text": "侍講",
      "kind": "兼",
      "start": 1255,
      "end": 1255,
      "date_text": "三年",
      "basis": "承上文年號寶祐",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，權禮部侍郎，仍兼祭酒，升兼同修國史、實錄院同修撰，尋兼侍講。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知建寧府",
      "place_id": "hixicl85u0jk",
      "start": 1259,
      "end": 1259,
      "date_text": "開慶元年",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "開慶元年，復知建寧府，作橋樑，置驛舍，建大安關，決疑獄。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr4",
      "text": "太子詹事",
      "start": 1260,
      "end": 1260,
      "date_text": "景定元年",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景定元年，召為太子詹事，上疏以「法天」為言。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷吏部侍郎，賜寧海縣食邑。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "kind": "權",
      "start": 1261,
      "end": 1261,
      "date_text": "二年",
      "basis": "承上文年號景定",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，權兵部尚書兼權吏部尚書。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptu",
      "text": "吏部尚書",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷吏部尚書，五辭免，請祠，不允。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜端明殿學士、同簽書樞密院事，屢辭不許。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "start": 1264,
      "end": 1264,
      "date_text": "五年",
      "basis": "承上文年號景定",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年，三辭，不許，進同知樞密院事、權參知政事。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "start": 1267,
      "end": 1267,
      "date_text": "咸淳三年",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸淳三年，再召為參知政事，加食邑，六辭，不許。"
        }
      ]
    },
    {
      "office_id": "hixia8mode6b",
      "text": "特進",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "詔著作佐郎盧鉞與台州守項公采趣行，拜特進、右丞相兼樞密使，累辭，不許，乃與似道分任。"
        }
      ]
    },
    {
      "office_id": "hiximd7hkbuo",
      "text": "少保",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進少保。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年，引杜衍致仕單車宵遁故事累辭，乃授觀文殿學士、判福州、福建安撫大使，進封信國公，不拜；充醴泉觀使，又不拜。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0x",
      "text": "少傅",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九年，授少傅、右丞相兼樞密使，引疾力辭，宰、掾、郎、曹遝至趣行，扶病至嵊縣，請辭不獲，乞還山林。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "少師",
      "sources": [
        {
          "title": "《宋史》卷四百一十四·葉夢鼎傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，益王即位於閩，召為少師、太乙宮使。"
        }
      ]
    }
  ],
