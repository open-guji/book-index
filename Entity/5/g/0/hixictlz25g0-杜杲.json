  "description": {
    "text": "邵武人。以父任入官，長於折獄；端平、嘉熙間守安豐、廬州，屢敗蒙古兵，進刑部尚書，晚專意理學，善行草。",
    "sources": [
      {
        "name": "《宋史·杜杲傳》",
        "details": "卷412"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o5qz2b",
      "text": "知濠州",
      "place_id": "hixicl85irzh",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·杜杲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "奉崇道祠，再知濠州，未行，改安豐。"
        }
      ]
    },
    {
      "office_id": "hixigfk90ruo",
      "text": "將作監",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·杜杲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢將作監，御書慰諭之。"
        }
      ]
    },
    {
      "office_id": "hixia8mlvhts",
      "text": "太府卿",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·杜杲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "詔以安撫兼廬州，進太府卿、淮西制置副使兼轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8m69mo5",
      "text": "華文閣學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·杜杲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄擢華文閣學士、沿江制置使、知建康府、行宮留守，節制安慶、和、無爲三郡。"
        }
      ]
    },
    {
      "office_id": "hixia8mvjuo3",
      "text": "敷文閣學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十二·杜杲傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進敷文閣學士，遷刑部尚書，引見，帝加獎勞。"
        }
      ]
    }
  ],
