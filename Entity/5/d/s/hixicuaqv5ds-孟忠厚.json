  "title_or_office": "常德軍承宣使、信安郡王",
  "dates": {
    "death": 1157,
    "basis": "據《宋史》本傳紀年"
  },
  "description": {
    "text": "隆祐太后（哲宗孟后）之兄。靖康中金人圍城，太后出居其家得免北遷；高宗時改授武秩，太后大祥後封信安郡王，雖與秦檜有姻親而不附之，紹興二十七年卒，贈太保。",
    "sources": [
      {
        "name": "《宋史·外戚傳·孟忠厚》",
        "details": "卷465"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaw4ktg9",
      "text": "將作少監",
      "sources": [
        {
          "title": "《宋史》卷四百六十五·孟忠厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "宣和中，官至將作少監。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知海州",
      "place_id": "hixicabu3dym",
      "start": 1126,
      "end": 1126,
      "date_text": "靖康元年",
      "sources": [
        {
          "title": "《宋史》卷四百六十五·孟忠厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "靖康元年，知海州，召權衛尉卿。"
        }
      ]
    },
    {
      "office_id": "hixia8ma0h6o",
      "text": "顯謨閣直學士",
      "sources": [
        {
          "title": "《宋史》卷四百六十五·孟忠厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝幸揚州，除顯謨閣直學士，臺諫交章論列，帝以太后故，難之。"
        }
      ]
    },
    {
      "office_id": "hiximd7hkbuo",
      "text": "少保",
      "sources": [
        {
          "title": "《宋史》卷四百六十五·孟忠厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既而帝以太后攢會稽，乃命忠厚判紹興府兼修奉攢宮事，加少保。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "保寧軍節度使",
      "sources": [
        {
          "title": "《宋史》卷四百六十五·孟忠厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "檜死，召還行在，授保寧軍節度使、判平江府，再改判紹興府，過闕入見，復詔充萬壽觀使，提舉祕書省。"
        }
      ]
    },
    {
      "office_id": "hixia8p0ngu8",
      "text": "太保",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百六十五·孟忠厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二十七年，卒，贈太保。"
        }
      ]
    }
  ],
