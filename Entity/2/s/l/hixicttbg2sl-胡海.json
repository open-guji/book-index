        {
          "title": "《明史》卷一百三十·胡海傳",
          "source_bid": "d59f2mc8bta8",
          "details": "嘗入土豪赤塘王總管營，自拔來歸，授百戶。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8ar",
      "text": "指揮使",
      "sources": [
        {
          "title": "《明史》卷一百三十·胡海傳",
          "source_bid": "d59f2mc8bta8",
          "details": "復從大軍克荊、澧、衡、潭，擢寶慶衛指揮僉事，遷指揮使，命鎮益陽。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8an",
      "text": "都督僉事",
      "sources": [
        {
          "title": "《明史》卷一百三十·胡海傳",
          "source_bid": "d59f2mc8bta8",
          "details": "武岡、靖州、五開諸苗蠻先後作亂，悉捕誅首亂而撫其餘眾，遷都督僉事。"
        }
