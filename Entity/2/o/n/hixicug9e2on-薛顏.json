  "description": {
    "text": "河中萬泉人。舉《三禮》中第，為丁謂所薦任峽路轉運使，復夔州故城；治豪姓「沒命社」；以光祿卿分司西京，卒於家。",
    "sources": [
      {
        "name": "《宋史·薛顏傳》",
        "details": "卷299"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "代還引見，太宗顧問之，對稱旨，改將作監丞、監華州酒稅。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl58",
      "text": "太子左贊善大夫",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，改太子左贊善大夫、知雲安軍，徙渝、閬二州，擢三司鹽鐵判官，河北計置糧草。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyy",
      "text": "三司鹽鐵判官",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，改太子左贊善大夫、知雲安軍，徙渝、閬二州，擢三司鹽鐵判官，河北計置糧草。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgj",
      "text": "金部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賊平，遷金部員外郎，改河東轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河東轉運使",
      "place_id": "hixiclu1dr0x",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賊平，遷金部員外郎，改河東轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpue",
      "text": "光祿少卿",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歷知河陽、杭徐州，累遷光祿少卿，以少府監知江寧府。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·薛顏傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷給事中。"
        }
      ]
    }
  ],
