  "description": {
    "text": "孔子四十五代孫，孔勖之子。舉進士，為寧州推官時以笏擊碎真武殿中之蛇；明道二年權御史中丞，郭皇后之廢率諫官伏閤力爭；後出知諸州，大寒上道，至韋城發病卒。",
    "sources": [
      {
        "name": "《宋史·孔道輔傳》",
        "details": "卷297"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8oa4ao1",
      "text": "秘書監",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "後為御史臺推直官，累遷秘書監、分司南京，管勾祖廟，以尚書工部侍郎致仕。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cf",
      "text": "大理寺丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷大理寺丞、知仙源縣，主孔子祠事。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷太常博士。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "左正言",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "章獻太后臨朝，召為左正言。"
        }
      ]
    },
    {
      "office_id": "hixia8pmi2v6",
      "text": "直史館",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，為直史館、判三司理欠憑由司。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "尚書兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還判流內銓，遷尚書兵部員外郎，復出知徐、許二州，徙應天府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "start": 1033,
      "end": 1033,
      "date_text": "明道二年",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明道二年，召為右諫議大夫、權御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "頃之，徙徐州，又徙兗州，進龍圖閣直學士，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "頃之，徙徐州，又徙兗州，進龍圖閣直學士，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·孔道輔傳",
          "source_bid": "d59f2gonq7sy",
          "details": "在兗三年，復入為御史中丞。"
        }
      ]
    }
