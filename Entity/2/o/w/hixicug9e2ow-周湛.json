  "description": {
    "text": "鄧州穰人。進士甲科，通判戎州時刻古方書教民用醫；提點廣南東路刑獄，搜還被略賣為奴婢者二千六百人；奏罷鄧州美陽堰歲役，為鹽鐵判官整理三司帳籍。",
    "sources": [
      {
        "name": "《宋史·周湛傳》",
        "details": "卷300"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpu5",
      "text": "秘書省著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷三百·周湛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "中身言書判，改秘書省著作佐郎、通判戎州。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "江南西路轉運使",
      "place_id": "hixiclu1dr0u",
      "sources": [
        {
          "title": "《宋史》卷三百·周湛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為江南西路轉運使，州縣簿領案牘，淆混無紀次，且多亡失，民訴訟無所質，至久不能決。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "夔州路轉運使",
      "place_id": "hixiclu1dr0o",
      "sources": [
        {
          "title": "《宋史》卷三百·周湛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還為戶部判官，又為夔州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百·周湛傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜右諫議大夫。"
        }
      ]
    }
