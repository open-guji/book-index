  "description": {
    "text": "南劍沙縣人。進士及第，為巴州推官時攝州事禦蜀寇；主廣寧監歲贏鑄錢三十萬緡；歷諸路轉運使、江淮制置發運使、三司副使，以右諫議大夫知并州。",
    "sources": [
      {
        "name": "《宋史·張若谷傳》",
        "details": "卷299"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·張若谷傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入為三司度支、鹽鐵副使，累遷右諫議大夫、知并州。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·張若谷傳",
          "source_bid": "d59f2gonq7sy",
          "details": "提舉諸司庫務，權判大理寺，進樞密直學士，歷知澶州、成德軍、揚州、江寧府，入知審官院，糾察在京刑獄，知通進銀臺司、應天府。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr6",
      "text": "龍圖閣學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·張若谷傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改龍圖閣學士，徙杭州。"
        }
      ]
    },
    {
      "office_id": "hixia8os826b",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·張若谷傳",
          "source_bid": "d59f2gonq7sy",
          "details": "權判吏部流內銓、知洪州，累官至尚書左丞致仕。"
        }
      ]
    }
