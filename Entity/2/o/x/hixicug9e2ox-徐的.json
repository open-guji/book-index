  "description": {
    "text": "建州建安人。擢進士，為欽州推官，請徙州治於瀕水並督築城；歷知吳縣、通判常州等，擢廣南西路提點刑獄，討安化州蠻，卒於桂陽。",
    "sources": [
      {
        "name": "《宋史·徐的傳》",
        "details": "卷300"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mnfojl",
      "text": "荊湖北路轉運使",
      "place_id": "hixiclu1dr13",
      "sources": [
        {
          "title": "《宋史》卷三百·徐的傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改知舒州，徙荊湖北路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百·徐的傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會青州改遣裨將傅永吉追殺入曆陽，的與賞，遷工部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8nggr2b",
      "text": "直昭文館",
      "sources": [
        {
          "title": "《宋史》卷三百·徐的傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復治泰州西溪河，發積鹽，加直昭文館。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyw",
      "text": "度支副使",
      "sources": [
        {
          "title": "《宋史》卷三百·徐的傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除度支副使、荊湖南路安撫使，至桂陽，降者復眾。"
        }
      ]
    }
