  "native_place": "鄆州須城",
  "native_place_basis": "《宋史》卷297本傳著錄「鄆州須城人」",
  "title_or_office": "御史中丞",
  "description": {
    "text": "鄆州須城人。舉進士，通判萊州時辨霍亮冤獄；擢殿中侍御史，論錢惟演覬望相位等；歷天章閣待制、知延州，元昊將山遇來歸時處置失宜；後權御史中丞，以職方員外郎知單州卒。",
    "sources": [
      {
        "name": "《宋史·郭勸傳》",
        "details": "卷297"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士，授寧化軍判官，累遷太常博士、通判密州。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "月餘，復為侍御史、判三司鹽鐵勾院。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0v",
      "text": "工部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，兼侍御史知雜事、權判流內銓，遷工部郎中、度支副使，拜天章閣待制、知延州。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，兼侍御史知雜事、權判流內銓，遷工部郎中、度支副使，拜天章閣待制、知延州。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知鳳翔府",
      "place_id": "hixicl857jgn",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁母憂，起復，知鳳翔府，尋復待制。"
        }
      ]
    },
    {
      "office_id": "hixi4udstrlv",
      "text": "待制",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁母憂，起復，知鳳翔府，尋復待制。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfn",
      "text": "兵部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召權戶部副使，以龍圖閣直學士知滑州，再遷兵部郎中，徙滄州，又徙成德軍。"
        }
      ]
    },
    {
      "office_id": "hixia8m5bx1c",
      "text": "翰林侍讀學士",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，召為翰林侍讀學士，復判流內銓，改左諫議大夫、權御史中丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，召為翰林侍讀學士，復判流內銓，改左諫議大夫、權御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷二百九十七·郭勸傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷給事中，辭不受，而請贈其祖萊陽令寧，遂以為尚書祠部員外郎。"
        }
      ]
    }
  ],
