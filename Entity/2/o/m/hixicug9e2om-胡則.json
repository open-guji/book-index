  "description": {
    "text": "婺州永康人。進士起家，為索湘部送靈夏芻糧，建議百日之備；歷河北都轉運使，以給事中權三司使，通京東西、陝西鹽法；後知杭州，以兵部侍郎致仕；無廉名。",
    "sources": [
      {
        "name": "《宋史·胡則傳》",
        "details": "卷299"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpuf",
      "text": "尚書戶部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改江、淮制置發運使，累遷尚書戶部員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyw",
      "text": "三司度支副使",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗幸亳還，擢三司度支副使。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktft",
      "text": "禮部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "至是，謂罷政事，出則為京西轉運使，遷禮部郎中。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "廣西路轉運使",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "坐是，徙廣西路轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8mm6qde",
      "text": "發運使",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為發運使，累遷太常少卿。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為發運使，累遷太常少卿。"
        }
      ]
    },
    {
      "office_id": "hixia8n81ce8",
      "text": "諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未行，復諫議大夫、知永興軍，徙河北都轉運使，以給事中權三司使，通京東西、陝西鹽法，人便之。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3k",
      "text": "河北都轉運使",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未行，復諫議大夫、知永興軍，徙河北都轉運使，以給事中權三司使，通京東西、陝西鹽法，人便之。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾月，授工部侍郎、集賢院學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百九十九·胡則傳",
          "source_bid": "d59f2gonq7sy",
          "details": "劉隨上疏言：「則奸邪貪濫聞天下，比命知池州，不肯行，今以罪去，驟加美職，何以風勸在位？」後徙杭州，再遷兵部侍郎致仕，卒。"
        }
      ]
    }
  ],
