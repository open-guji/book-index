  "description": {
    "text": "懷遠人，字伯仁。勇力絕人，善射，自稱將十萬眾橫行天下，軍中號常十萬。從太祖破陳友諒、張士誠，副徐達北伐克大都；封鄂國公，洪武二年北征還至柳河川暴卒，追封開平王，諡忠武。",
    "sources": [
      {
        "name": "《明史·常遇春傳》",
        "details": "卷125"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximxu3qpsf",
      "text": "行省參知政事",
      "sources": [
        {
          "title": "《明史》卷一百二十五·常遇春傳",
          "source_bid": "d59f2mc8bta8",
          "details": "太祖追友諒于江州，命遇春留守，用法嚴，軍民肅然無敢犯，進行省參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8m8gagy",
      "text": "太子少保",
      "kind": "兼",
      "sources": [
        {
          "title": "《明史》卷一百二十五·常遇春傳",
          "source_bid": "d59f2mc8bta8",
          "details": "既行，以遇春兼太子少保，從下山東諸郡，取汴梁，進攻河南。"
        }
      ]
    }
