  "dynasty_basis": "據正史本傳",
  "period": "song",
  "period_basis": "據 dynasty「北宋」歸併",
  "title_or_office": "太子中允",
  "description": {
    "text": "以父任得官。熙寧初上書言青苗法不行宜斬韓琦等，王安石喜之，賜進士出身；鄧綰薦為御史；後反劾王安石，殿上讀疏，貶潮州別駕，改監廣州軍資庫，徙吉州酒稅卒。",
    "sources": [
      {
        "name": "《宋史·王安石傳》",
        "details": "卷327，附王安石傳"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百二十七·王安石傳",
          "source_bid": "d59f2gonq7sy",
          "details": "數月，召為翰林學士兼侍講。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百二十七·王安石傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年二月，拜參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷三百二十七·王安石傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年十二月，拜同中書門下平章事。"
        }
      ]
    },
    {
      "office_id": "hixia8nf7sw3",
      "text": "尚書左僕射",
      "sources": [
        {
          "title": "《宋史》卷三百二十七·王安石傳",
          "source_bid": "d59f2gonq7sy",
          "details": "《三經義》成，加尚書左僕射兼門下侍郎，以子雱為龍圖閣直學士。"
        }
      ]
    },
    {
      "office_id": "hixi5wrbltsg",
      "text": "太傅",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百二十七·王安石傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元祐元年，卒，年六十八，贈太傅。"
        }
      ]
    }
  ],
