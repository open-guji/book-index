  "native_place": "祥符",
  "native_place_basis": "《萬姓統譜》卷65著錄「祥符人」（字號佐證）",
  "dynasty": "北宋",
  "dynasty_basis": "據正史本傳",
  "period": "song",
  "period_basis": "據 dynasty「北宋」歸併",
  "title_or_office": "鄜延路副都總管",
  "description": {
    "text": "開封祥符人。進士及第，以寇準薦知瀘州；為監察御史敢言；元昊寇延州，與石元孫戰於三川口，黃德和引兵先潰，力戰被執；德和誣平降賊，龐籍按得其實，德和腰斬，贈朔方軍節度使兼侍中。",
    "sources": [
      {
        "name": "《宋史·劉平傳》",
        "details": "卷325"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進士及第，補無錫尉，擊賊殺五人，擢大理評事。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p5",
      "text": "殿中丞",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以寇準薦，為殿中丞、知瀘州，夷人懲前敗，不敢擾邊。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，除三司鹽鐵判官、河北安撫，改殿中侍御史、陝西轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8of43d0",
      "text": "忻州團練使",
      "place_id": "hixicabu3dx0",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "居四年，遷忻州團練使、知成德軍。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知同州",
      "place_id": "hixicl857jez",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋坐被酒破鎖入甲仗庫，為轉運使蘇耆所劾，落管軍，知同州。"
        }
      ]
    },
    {
      "office_id": "hixigfk3ei2o",
      "text": "步軍都虞候",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上疏自列，召入問狀，復為步軍都虞候、知澶州。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "邕州觀察使",
      "place_id": "hixicl86596v",
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會元昊反，遷邕州觀察使，為鄜延路副總管兼鄜延、環慶路同安撫使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "朔方軍節度使",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百二十五·劉平傳",
          "source_bid": "d59f2gonq7sy",
          "details": "而延州吏民亦詣闕訴平戰沒狀，遂贈朔方軍節度使兼侍中，諡壯武，賜信陵坊第，封其妻趙氏為南陽郡太夫人，子孫及諸弟皆優遷，未官者錄之。"
        }
      ]
    }
  ],
