  "description": {
    "text": "開封人，初隸諸班。開古渭州路為前鋒，斬首九百餘級；為并代州鈐轄管勾麟府軍馬事，夏人侵屈野河西地，與武戡等夜出巡邊，至斷道堰遇伏，力戰眾潰，被執。",
    "sources": [
      {
        "name": "《宋史·郭恩傳》",
        "details": "卷326"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3lg",
      "text": "內殿承制",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·郭恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "初隸諸班，出為左侍禁、閤門祗候，歷延州西路都巡檢、環州肅遠砦主，累遷內殿承制、秦鳳路兵馬都監。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3l3",
      "text": "崇儀副使",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·郭恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "開古渭州路，為前鋒，斬首九百餘級，擢崇儀副使。"
        }
      ]
    },
    {
      "office_id": "hiximda1c3ku",
      "text": "六宅副使",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·郭恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "會掌烏族叛，又率兵攻討，斬首八十五級，遷六宅副使。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "同州觀察使",
      "posthumous": true,
      "place_id": "hixicl857jez",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·郭恩傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈同州觀察使，封其妻為京兆郡君，錄其子弟有差，給舊俸三年。"
        }
      ]
    }
  ],
