  "title_or_office": "四方館使",
  "description": {
    "text": "其先西河人，家河陽。進士起家，天聖初上治河十策，與張君平並為修河都監；知鳳州招撫階州屬戶復沙灘砦；寶元元年元昊將山遇來歸言其反狀，渭以元昊猶稱臣拒之，坐貶，後再降右監門衛將軍卒。",
    "sources": [
      {
        "name": "《宋史·李渭傳》",
        "details": "卷326"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·李渭傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進士起家，為臨潁縣主簿，累官至太常博士。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eo",
      "text": "惠州刺史",
      "place_id": "hixicl86596a",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·李渭傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙益利路兵馬鈐轄，領惠州刺史，遷東八作使，擢西上閤門使。"
        }
      ]
    },
    {
      "office_id": "hixigfk59xc0",
      "text": "四方館使",
      "sources": [
        {
          "title": "《宋史》卷三百二十六·李渭傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙鄜延路，再遷四方館使。"
        }
      ]
    }
  ],
