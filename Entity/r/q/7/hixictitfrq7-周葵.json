          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除監察御史，徙殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8p1wf0g",
      "text": "直秘閣",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復直秘閣，起知湖州，移平江府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "過闕，權禮部侍郎，尋兼國子祭酒。"
        }
      ]
    },
    {
      "office_id": "hixia8mj2cxu",
      "text": "國子祭酒",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "過闕，權禮部侍郎，尋兼國子祭酒。"
        }
      ]
    },
    {
      "office_id": "hixia8mcidj4",
      "text": "直龍圖閣",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起知撫州，引疾，改提舉興國宮，加直龍圖閣、知太平州。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進集英殿修撰、敷文閣待制、知婺州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·周葵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "孝宗即位，除兵部侍郎兼侍講，改同知貢舉兼權戶部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
