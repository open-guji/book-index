  "description": {
    "text": "臨江軍人。紹興十八年進士，拒秦檜囑託；淳熙中參知政事、權知樞密院，紹熙四年卒，年七十七，諡正肅。",
    "sources": [
      {
        "name": "《宋史·蕭燧傳》",
        "details": "卷385"
      },
      {
        "title": "《浙江通志》卷162",
        "source_bid": "d59f2n6dz6ki",
        "details": "蕭燧：宋史本傳字照鄰臨江軍人紹興十八年擢進士高第累遷刑部侍郎出知嚴州嚴地狹財匱"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mpmcch",
      "text": "起居郎",
      "start": 1175,
      "end": 1175,
      "date_text": "淳熙二年",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳熙二年，累遷至國子司業兼權起居舍人，進起居郎。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6u",
      "text": "左司諫",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "先是，察官闕，朝論多屬燧，以未歷縣，遂除左司諫。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢右諫議大夫，入謝，上曰：「卿議論鯁切，不求名譽，糾正姦邪，不恤仇怨。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "徙刑部侍郎，不拜，固請補外。"
        }
      ]
    },
    {
      "office_id": "hixia8ojsni8",
      "text": "敷文閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上方靳職名，非功不予，詔燧治郡有勞，除敷文閣待制，移知婺州。"
        }
      ]
    },
    {
      "office_id": "hixia8mj2cxu",
      "text": "國子祭酒",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除吏部右選侍郎，旋兼國子祭酒。"
        }
      ]
    },
    {
      "office_id": "hixigfk2gsg0",
      "text": "樞密都承旨",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九年，為樞密都承旨。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sg",
      "text": "侍講",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼侍講，升侍讀。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "高宗山陵，充按行使，除參知政事，尋充永思陵禮儀使，權監修國史日曆。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·蕭燧傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以年及自陳，上留之，不可，除資政殿學士，與郡。"
        }
      ]
    }
  ],
