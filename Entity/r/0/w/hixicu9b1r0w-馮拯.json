  "description": {
    "text": "河陽人。為趙普所奇，舉進士；淳化中與尹黃裳等伏閤請立許王元僖，貶知端州；真宗時歷參知政事、樞密使，仁宗初拜相，卒贈太師、中書令。",
    "sources": [
      {
        "name": "《宋史·馮拯傳》",
        "details": "卷285"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaw4ktga",
      "text": "比部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，進比部員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgc",
      "text": "祠部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢祠部郎中、樞密直學士，權判吏部流內銓。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德中，為參知政事，再遷兵部侍郎。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景德中，為參知政事，再遷兵部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8os826b",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "禮成，進尚書左丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptt",
      "text": "工部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從祀汾陰，為儀仗使，遷工部尚書。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptv",
      "text": "刑部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復以疾求罷，拜刑部尚書、知河南府，聽以府事委官屬。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七年，除御史中丞，又以疾辭，除戶部尚書、知陳州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpud",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "七年，除御史中丞，又以疾辭，除戶部尚書、知陳州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "”再知河南府，遷兵部尚書，入判尚書都省，以吏部尚書、檢校太傅、同中書門下平章事充樞密使。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "其冬，拜右僕射兼中書侍郎、太子少傅、同平章事、集賢殿大學士，進左僕射。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "武勝軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五上表願罷相，拜武勝軍節度使、檢校太尉兼侍中、判河南府。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十五·馮拯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既卒，贈太師、中書令，諡文懿。"
        }
      ]
    }
  ],
