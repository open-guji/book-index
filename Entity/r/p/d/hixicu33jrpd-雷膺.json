  "description": {
    "text": "渾源人，金監察御史淵子。太宗時中儒籍試選，史天澤辟為萬戶府掌書記；中統二年王鶚、王磐薦為翰林修撰；歷陝西西蜀四川按察司參議、轉運司諮議；年六十二致仕，至元二十九年徵拜集賢學士。大德元年六月卒于京師，年七十三，追封馮翊郡公，諡文穆。",
    "sources": [
      {
        "name": "《元史·雷膺傳》",
        "details": "卷170"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximd4offw6",
      "text": "國史院編修官",
      "kind": "兼",
      "start": 1261,
      "end": 1261,
      "date_text": "中統二年",
      "sources": [
        {
          "title": "《元史》卷一百七十·雷膺傳",
          "source_bid": "d59f2njivtog",
          "details": "中統二年，翰林承旨王鶚、王磐，薦膺為翰林修撰、同知制誥，兼國史院編修官。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknx6",
      "text": "奉議大夫",
      "start": 1274,
      "end": 1274,
      "date_text": "十一年",
      "basis": "承上文年號至元",
      "sources": [
        {
          "title": "《元史》卷一百七十·雷膺傳",
          "source_bid": "d59f2njivtog",
          "details": "十一年，加奉議大夫，僉河東山西道提刑按察司事，以稱職聞。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknx4",
      "text": "朝列大夫",
      "sources": [
        {
          "title": "《元史》卷一百七十·雷膺傳",
          "source_bid": "d59f2njivtog",
          "details": "十四年，進朝列大夫、山南湖北道提刑按察副使。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknz7",
      "text": "行臺侍御史",
      "sources": [
        {
          "title": "《元史》卷一百七十·雷膺傳",
          "source_bid": "d59f2njivtog",
          "details": "二十年，遷行臺侍御史，奉母之官，分司湖廣、江西，奏劾按察使二人及行省官吏之不法者。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknwz",
      "text": "中議大夫",
      "sources": [
        {
          "title": "《元史》卷一百七十·雷膺傳",
          "source_bid": "d59f2njivtog",
          "details": "明年，起復，授中議大夫、江南浙西道提刑按察使。"
        }
      ]
    },
    {
      "office_id": "hiximwvsknws",
      "text": "通奉大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《元史》卷一百七十·雷膺傳",
          "source_bid": "d59f2njivtog",
          "details": "贈通奉大夫、河南江北等處行中書省參知政事、護軍，追封馮翊郡公，諡文穆。"
        }
      ]
