  "description": {
    "text": "淄州鄒平人。十三歲詣京師訟父冤；舉進士，真宗時知制誥、東京留守判官，初置糾察刑獄司即命起；官至樞密副使，卒贈禮部尚書。",
    "sources": [
      {
        "name": "《宋史·周起傳》",
        "details": "卷288"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·周起傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉進士，授將作監丞、通判齊州。"
        }
      ]
    },
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·周起傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢著作佐郎、直史館，累遷戶部、度支判官。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgj",
      "text": "金部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·周起傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進金部員外郎、判集賢院。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·周起傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢樞密直學士、權知開封府。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·周起傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜給事中、同知樞密院事。"
        }
      ]
    },
    {
