  "description": {
    "text": "其先洛陽人，家萊州膠水。大中祥符八年進士第一，狀元給騶自齊始；仁宗初劾錢惟演，歷翰林學士、參知政事，與王曾同罷，出知潁州卒，贈兵部尚書。",
    "sources": [
      {
        "name": "《宋史·蔡齊傳》",
        "details": "卷286"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除將作監丞、通判袞州，徙濰州。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以起居舍人知制誥，入為翰林學士，加侍讀學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以親老，改密州，徙應天府，召為右諫議大夫、御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr6",
      "text": "龍圖閣學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復為龍圖閣學士、權三司使。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜樞密副使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜禮部侍郎、參知政事。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十六·蔡齊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋出知潁州，卒，年五十二，贈兵部尚書，諡曰文忠。"
        }
      ]
    }
