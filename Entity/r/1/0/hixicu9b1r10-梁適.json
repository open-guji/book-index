  "description": {
    "text": "東平人，翰林學士梁顥之子。以父蔭授秘書省正字，後更舉進士；仁宗時歷官至拜相，後罷，以太子太保致仕，進太傅。",
    "sources": [
      {
        "name": "《宋史·梁適傳》",
        "details": "卷285"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8p4ebcx",
      "text": "知淮陽軍",
      "place_id": "hixicl84l2fg",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "更舉進士，知淮陽軍，又奏減京東預買□百三十萬。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進知制誥、權發遣開封府。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷樞密直學士、知延州。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入知審刑院，擢樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進同中書門下平章事、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6n",
      "text": "園陵使",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "將以適為園陵使，適言國朝以來無此制，由是浸與陳執中不合。"
        }
      ]
    },
    {
      "office_id": "hixia8nc3fgj",
      "text": "觀文殿大學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復加觀文殿大學士、知秦州。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "定國軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "夏人盜耕屈野河西田累年，朝廷欲正封，以適為定國軍節度使、知并州，至則悉復侵地六百里。"
        }
      ]
    },
    {
      "office_id": "hixia8nc3fgj",
      "text": "觀文殿大學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，知河陽，領忠武、昭德二鎮、檢校太師，復為觀文殿大學士，以太子太保致仕，進太傅。"
        }
      ]
    },
    {
      "office_id": "hixi5wrbltsg",
      "text": "太傅",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·梁適傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，知河陽，領忠武、昭德二鎮、檢校太師，復為觀文殿大學士，以太子太保致仕，進太傅。"
        }
      ]
    }
  ],
