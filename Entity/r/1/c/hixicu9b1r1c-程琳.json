  "description": {
    "text": "永寧軍博野人。舉服勤辭學科，館伴契丹使辯屈其詞；權三司使，歲饑盡發太倉陳粟六十萬斛貸民；歷權知開封府、參知政事，判大名府，換鎮安軍節度使卒，贈中書令。",
    "sources": [
      {
        "name": "《宋史·程琳傳》",
        "details": "卷288"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpu5",
      "text": "秘書省著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改秘書省著作佐郎、知壽陽縣，監左藏庫，召試，直集賢院。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改太常博士、權三司戶部判官，契丹館伴使。"
        }
      ]
    },
    {
      "office_id": "hixia8o4i0w0",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改樞密直學士、知益州。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷工部侍郎、龍圖閣學士，復為御史中丞。"
        }
      ]
    },
    {
      "office_id": "hixia8m9p8n6",
      "text": "三司使",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改三司使，出納尤謹，禁中有所取，輒奏罷之。"
        }
      ]
    },
    {
      "office_id": "hixia8os826b",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷吏部侍郎，遂參知政事，遷尚書左丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "頃之，為戶部侍郎，尋復吏部、知天雄軍。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptt",
      "text": "工部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·程琳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷工部尚書，加大學士、河北安撫使。"
        }
      ]
    },
    {
