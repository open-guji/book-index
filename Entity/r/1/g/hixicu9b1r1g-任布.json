  "title_or_office": "樞密副使",
  "description": {
    "text": "河南人，後唐宰相任圜四世孫。進士及第，嘗上疏請飭邊備；仁宗時官至樞密副使，歸洛作「五知堂」，卒贈太子太傅。",
    "sources": [
      {
        "name": "《宋史·任布傳》",
        "details": "卷288"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mnfojl",
      "text": "梓州路轉運使",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲餘，判三司開拆司，出為梓州路轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgc",
      "text": "祠部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷祠部郎中、權戶部判官，擢江、淮制置發運使。"
        }
      ]
    },
    {
      "office_id": "hixia8pmi2v6",
      "text": "直史館",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，加直史館、知荊南。"
        }
      ]
    },
    {
      "office_id": "hiximd8tbmyv",
      "text": "鹽鐵副使",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "為鹽鐵副使，命管伴契丹使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歷兵部、刑部郎中，拜右諫議大夫、知真定府。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷給事中、集賢院學士、知許州。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，為龍圖閣直學士，徙澶州。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復徙真定，又徙河南府，未至，召為樞密副使。"
        }
      ]
    },
    {
      "office_id": "hixia8m5ye4i",
      "text": "太子少保",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改蔡州，授太子少保致仕，進少傅。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0x",
      "text": "少傅",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改蔡州，授太子少保致仕，進少傅。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "少師",
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賜一子進士出身，遷少師。"
        }
      ]
    },
    {
      "office_id": "hixia8nk7lkz",
      "text": "太子太傅",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十八·任布傳",
          "source_bid": "d59f2gonq7sy",
          "details": "卒，贈太子太傅，諡恭惠。"
        }
      ]
    }
  ],
