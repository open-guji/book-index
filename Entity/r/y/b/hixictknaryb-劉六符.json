  "primary_name": "劉六符",
  "dynasty": "遼",
  "dynasty_basis": "據正史本傳",
  "period": "liao-jin-yuan",
  "period_basis": "據 dynasty「遼」歸併",
  "title_or_office": "三司使、漢人行宮副部署",
  "description": {
    "text": "劉慎行之子，第進士，有志操能文。重熙十一年與蕭特末使宋索關南十縣地，又與耶律仁先使宋，迫宋於歲幣稱「貢」；為三司使。道宗即位，議大冊禮宜行於中京，從之，尋以疾卒。",
    "sources": [
      {
        "name": "《遼史·劉六符傳》",
        "details": "卷86"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximwzcv764",
      "text": "彰武軍節度使",
      "sources": [
        {
          "title": "《遼史》卷八十六·劉六符傳",
          "source_bid": "d59f2gosq0ht",
          "details": "為都統，伐高麗，以失軍期下吏，議貴乃免，出為彰武軍節度使。"
        }
      ]
    },
    {
      "office_id": "hiximwzcv75z",
      "text": "樞密直學士",
      "sources": [
        {
          "title": "《遼史》卷八十六·劉六符傳",
          "source_bid": "d59f2gosq0ht",
          "details": "還，拜樞密直學士。"
        }
      ]
    },
    {
      "office_id": "hiximwzcv75y",
      "text": "政事舍人",
      "sources": [
        {
          "title": "《遼史》卷八十六·劉六符傳",
          "source_bid": "d59f2gosq0ht",
          "details": "重熙初，遷政事舍人，擢翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixia8nx0buq",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《遼史》卷八十六·劉六符傳",
          "source_bid": "d59f2gosq0ht",
          "details": "重熙初，遷政事舍人，擢翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixia8mfbif6",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《遼史》卷八十六·劉六符傳",
          "source_bid": "d59f2gosq0ht",
          "details": "六符還，加同中書門下平章事。"
        }
      ]
    },
    {
      "office_id": "hiximwzcv764",
      "text": "長寧軍節度使",
      "sources": [
        {
          "title": "《遼史》卷八十六·劉六符傳",
          "source_bid": "d59f2gosq0ht",
          "details": "六符與參知政事杜防有隙，防以六符嘗受宋賂，白其事，出為長寧軍節度使，俄召為三司使。"
        }
      ]
    },
