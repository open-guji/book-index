  "title_or_office": "京湖制置使",
  "description": {
    "text": "衡山人，從張栻學。淳熙八年進士；嘉定中任京湖制置使，帥孟宗政、扈再興禦金十年，使朝廷無北顧之憂，卒，諡忠肅。子趙范、趙葵。",
    "sources": [
      {
        "name": "《宋史·趙方傳》",
        "details": "卷403"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mum51d",
      "text": "知青陽縣",
      "place_id": "hixicl85is0m",
      "sources": [
        {
          "title": "《宋史》卷四百零三·趙方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知青陽縣，告其守史彌遠曰：「催科不擾，是催科中撫字；刑罰無差，是刑罰中教化。"
        }
      ]
    },
    {
      "office_id": "hixia8p1wf0g",
      "text": "直秘閣",
      "sources": [
        {
          "title": "《宋史》卷四百零三·趙方傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以金部員外郎召，尋加直秘閣，改湖北轉運判官兼知鄂州。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "湖北轉運判官",
      "sources": [
