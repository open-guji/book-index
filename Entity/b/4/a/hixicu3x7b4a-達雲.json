      "office_id": "hixic9fkl8b3",
      "text": "守備",
      "sources": [
        {
          "title": "《明史》卷二百三十九·達雲傳",
          "source_bid": "d59f2mc8bta8",
          "details": "擢守備，進肅州遊擊將軍。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl8am",
      "text": "都督同知",
      "sources": [
        {
          "title": "《明史》卷二百三十九·達雲傳",
          "source_bid": "d59f2mc8bta8",
          "details": "雲擢都督同知，廕本衞世指揮使。"
        }
      ]
    },
    {
      "office_id": "hixia8m6kv7k",
      "text": "太子太保",
      "posthumous": true,
