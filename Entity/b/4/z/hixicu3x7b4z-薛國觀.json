  "description": {
    "text": "韓城人，萬曆四十七年進士。天啟中為給事中附魏忠賢劾東林；崇禎十一年入閣，次年為首輔，以納賄被劾削籍，十四年賜死。",
    "sources": [
      {
        "name": "《明史·薛國觀傳》",
        "details": "卷253"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixic9fkl8a0",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《明史》卷二百五十三·薛國觀傳",
          "source_bid": "d59f2mc8bta8",
          "details": "遭母憂，服闋，起禮科都給事中，遷太常少卿。"
        }
      ]
    },
    {
      "office_id": "hixi4ui6glxk",
      "text": "左僉都御史",
      "sources": [
        {
          "title": "《明史》卷二百五十三·薛國觀傳",
          "source_bid": "d59f2mc8bta8",
          "details": "九年，擢左僉都御史。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl89c",
      "text": "禮部左侍郎",
      "sources": [
        {
          "title": "《明史》卷二百五十三·薛國觀傳",
          "source_bid": "d59f2mc8bta8",
          "details": "明年八月，拜禮部左侍郎兼東閣大學士，入參機務。"
        }
      ]
    },
    {
      "office_id": "hixic9fkl89b",
      "text": "禮部尚書",
      "sources": [
        {
          "title": "《明史》卷二百五十三·薛國觀傳",
          "source_bid": "d59f2mc8bta8",
          "details": "十一年六月，進禮部尚書。"
        }
      ]
    },
    {
      "office_id": "hixia8m6kv7k",
      "text": "太子太保",
      "sources": [
        {
          "title": "《明史》卷二百五十三·薛國觀傳",
          "source_bid": "d59f2mc8bta8",
          "details": "敘剿寇功，加太子太保、戶部尚書，進文淵閣；敘城守功，加少保、吏部尚書，進武英殿。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sn",
