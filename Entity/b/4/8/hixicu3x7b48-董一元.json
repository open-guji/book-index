  },
  "offices": [
    {
      "office_id": "hixic9fkl8b0",
      "text": "副總兵",
      "sources": [
        {
          "title": "《明史》卷二百三十九·董一元傳",
          "source_bid": "d59f2mc8bta8",
          "details": "再進二級，遷副總兵，駐防古北口。"
        }
      ]
    },
    {
      "office_id": "hixia8m6kv7k",
      "text": "太子太保",
      "sources": [
        {
          "title": "《明史》卷二百三十九·董一元傳",
          "source_bid": "d59f2mc8bta8",
          "details": "捷聞，帝大喜，祭告郊廟，宣捷行賞，進一元左都督，加太子太保，廕本衞世指揮使。"
        }
      ]
    }
