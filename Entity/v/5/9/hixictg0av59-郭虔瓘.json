        "details": "卷103"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfed18mm",
      "text": "右驍衛將軍",
      "sources": [
        {
          "title": "《舊唐書》卷一百零三·郭虔瓘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "開元初，累遷右驍衛將軍，兼北庭都護。"
        }
      ]
    },
    {
      "office_id": "hixikfedch0a",
      "text": "冠軍大將軍",
      "sources": [
        {
          "title": "《舊唐書》卷一百零三·郭虔瓘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "虔瓘以破賊之功，拜冠軍大將軍，行右驍衛大將軍。"
        }
      ]
    },
    {
      "office_id": "hixikfed18mn",
      "text": "右威衛大將軍",
      "sources": [
        {
          "title": "《舊唐書》卷一百零三·郭虔瓘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "尋遷右威衛大將軍，以疾卒。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "涼州刺史",
      "place_id": "hixicl8d0gzx",
      "sources": [
        {
          "title": "《新唐書》卷一百三十三·郭虔瓘傳",
          "source_bid": "d59f2htqolj5",
          "details": "既而虔瓘果不見虜，還，遷涼州刺史、河西節度大使，進右威衛大將軍。"
        }
      ]
    },
