      },
      {
        "name": "《舊唐書·列傳第五十五》",
        "details": "卷105"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixikfedcgzn",
      "text": "銀青光祿大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百〇五·楊慎矜傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "擢拜太府卿，加銀青光祿大夫，進封弘農郡公。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g5",
      "text": "戶部尚書",
      "sources": [
        {
          "title": "《舊唐書》卷一百〇五·楊慎矜傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "年九十餘，授戶部尚書致仕。"
        }
      ]
    },
    {
      "office_id": "hixikfed18lw",
      "text": "太子舍人",
      "sources": [
        {
          "title": "《舊唐書》卷一百〇五·楊慎矜傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "慎餘先為司農丞，除太子舍人，監京倉。"
        }
      ]
    },
    {
      "office_id": "hixia8olo2rk",
      "text": "侍御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百〇五·楊慎矜傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "二十六年服闋，累遷侍御史，仍知太府出納。"
        }
      ]
    },
    {
      "office_id": "hixikfed18g6",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百〇五·楊慎矜傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "五載，慎矜遷戶部侍郎，中丞、使如故。"
        }
      ]
    }
