      "sources": [
        {
          "title": "《金史》卷一百〇二·完顏弼傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "梁聚寬遙授泰定軍節度副使，加宣武將軍。"
        }
      ]
    }
