  "description": {
    "text": "王同晈從子，十一歲擢童子科。開元初為考功員外郎，取士精核；歷紫微侍郎、懷州刺史、尚書左丞，固辭宰相而推韓休；天寶二年卒，贈荊州大都督，諡文。",
    "sources": [
      {
        "name": "《新唐書·列傳第五十四》",
        "details": "卷129"
      },
      {
        "name": "《舊唐書·列傳第五十》",
        "details": "卷100"
      },
      {
        "title": "《御定全唐詩》卷111",
        "source_bid": "d59f2n69x3ia",
        "details": "王丘字仲山相州安陽人舉制科中第自偃師主簿擢監察御史開元初遷紫微舍人吏部侍郎其奨用如孫逖張晉明王泠然皆一時茂秀蕭嵩引與當國丘固辭盛推韓休休秉政薦為御史大夫終禮部尚……"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8p5c0zk",
      "text": "奉禮郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "弱冠，又應制舉，拜奉禮郎。"
        }
      ]
    },
    {
      "office_id": "hixi5v2mknb6",
      "text": "監察御史",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "長安中，自偃師主簿擢第，拜監察御史。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszcz",
      "text": "考功員外郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "開元初，累遷考功員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8pdg741",
      "text": "朝散大夫",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "三遷紫微舍人，以知制誥之勤，加朝散大夫，再轉吏部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gf",
      "text": "黃門侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十一年，拜黃門侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "懷州刺史",
      "place_id": "hixicl880ohp",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "於是以丘爲懷州刺史，又以中書侍郎崔沔等數人皆爲山東諸州刺史。"
        }
      ]
    },
    {
      "office_id": "hixikfedch21",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《舊唐書》卷一百·王丘傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "俄又分知吏部選事，入爲尚書左丞，丁父憂去職，服闋，拜右散騎常侍，仍知制誥。"
        }
      ]
    },
    {
      "office_id": "hixia8p5c0zk",
      "text": "奉禮郎",
      "sources": [
        {
          "title": "《新唐書》卷一百二十九·王丘傳",
          "source_bid": "d59f2htqolj5",
          "details": "及冠，舉制科中第，授奉禮郎。"
        }
      ]
    },
    {
      "office_id": "hiximx0vszcz",
      "text": "考功員外郎",
      "sources": [
        {
          "title": "《新唐書》卷一百二十九·王丘傳",
          "source_bid": "d59f2htqolj5",
          "details": "開元初，遷考功員外郎。"
        }
      ]
    },
    {
      "office_id": "hixikfed18gf",
      "text": "黃門侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百二十九·王丘傳",
          "source_bid": "d59f2htqolj5",
          "details": "久之，為黃門侍郎。"
        }
      ]
    },
    {
      "office_id": "hixikfedch21",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《新唐書》卷一百二十九·王丘傳",
          "source_bid": "d59f2htqolj5",
          "details": "入知吏部選，改尚書左丞，以父喪解。"
        }
      ]
    },
    {
      "office_id": "hixia8o1ow00",
      "text": "太子賓客",
      "sources": [
        {
          "title": "《新唐書》卷一百二十九·王丘傳",
          "source_bid": "d59f2htqolj5",
          "details": "丘訥於言，所白奏帝多不喜，改太子賓客，襲父封。"
        }
      ]
    }
  ],
