  "description": {
    "text": "吉州龍泉人，第進士。鄭雍、顧臨薦為監察御史；哲宗親政請增諫官，主河東流；為殿中侍御史，論元祐棄四砦；遷中書舍人，報聘遼使蕭德崇；坐導河東流議知和州；徽宗時曾布用為工部侍郎，知太原府，拜刑部尚書、知開封府、翰林學士；入黨籍，政和初卒。",
    "sources": [
      {
        "name": "《宋史·郭知章傳》",
        "details": "卷355"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8o5qz2b",
      "text": "知海州",
      "place_id": "hixicabu3dym",
      "sources": [
        {
          "title": "《宋史》卷三百五十五·郭知章傳",
          "source_bid": "d59f2gonq7sy",
          "details": "黃履薦為御史，以憂不克拜，知海州、濮州，提點梓州路刑獄。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷三百五十五·郭知章傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復以鄭雍、顧臨薦，為監察御史。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6u",
      "text": "左司諫",
