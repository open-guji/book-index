  "offices": [
    {
      "office_id": "hixia8mn4g00",
      "text": "集慶軍節度推官",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改集慶軍節度推官，始還姓，更其名。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cf",
      "text": "大理寺丞",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "監泰州西溪鹽稅，遷大理寺丞，徙監楚州糧料院，母喪去官。"
        }
      ]
    },
    {
      "office_id": "hixia8m6kv7l",
      "text": "秘閣校理",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "服除，以殊薦，為秘閣校理。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0z",
      "text": "右司諫",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太后崩，召為右司諫。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu4",
      "text": "吏部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜尚書禮部員外郎、天章閣待制，召還，判國子監，遷吏部員外郎、權知開封府。"
        }
      ]
    },
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元昊反，召為天章閣待制、知永興軍，改陝西都轉運使。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3k",
      "text": "陝西都轉運使",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "元昊反，召為天章閣待制、知永興軍，改陝西都轉運使。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfo",
      "text": "戶部郎中",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "延州諸砦多失守，仲淹自請行，遷戶部郎中兼知延州。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "命為陝西宣撫使，未行，復除參知政事。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以疾請鄧州，進給事中。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋徙杭州，再遷戶部侍郎，徙青州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百一十四·范仲淹傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈兵部尚書，諡文正。"
        }
      ]
    }
  ],
