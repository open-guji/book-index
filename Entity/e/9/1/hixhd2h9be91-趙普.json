  "offices": [
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "start": 962,
      "end": 962,
      "date_text": "建隆三年",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "建隆三年，拜樞密使、檢校太保。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu9",
      "text": "門下侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "乾德二年，范質等三相同日罷，以普為門下侍郎、平章事、集賢殿大學士。"
        }
      ]
    },
    {
      "office_id": "hixia8oupyio",
      "text": "監修國史",
      "kind": "兼",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "是日，普兼監修國史。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年春，加右僕射、昭文館大學士。"
        }
      ]
    },
    {
      "office_id": "hixia8m5ye4i",
      "text": "太子少保",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國初入朝，改太子少保，遷太子太保。"
        }
      ]
    },
    {
      "office_id": "hixia8np7e9s",
      "text": "太子太保",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國初入朝，改太子少保，遷太子太保。"
        }
      ]
    },
    {
      "office_id": "hixia8obzpxf",
      "text": "司徒",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄拜司徒兼侍中，封梁國公。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜太師，封魏國公，給宰相奉料，令養疾，俟損日赴闕，仍遣其弟宗正少卿安易齎詔書賜之。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl54",
      "text": "尚書令",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百五十六·趙普傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈尚書令，追封真定王，賜諡忠獻，上撰神道碑銘，親八分書以賜之。"
        }
      ]
    }
