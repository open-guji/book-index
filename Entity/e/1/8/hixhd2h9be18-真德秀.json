  "offices": [
    {
      "office_id": "hixia8ots8w0",
      "text": "太學正",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "繼試，中博學宏詞科，入閩帥幕，召為太學正，嘉定元年遷博士。"
        }
      ]
    },
    {
      "office_id": "hixia8mqk1z7",
      "text": "秘書省正字",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召試學士院，改秘書省正字兼檢討玉牒。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9c7",
      "text": "校書郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二年，遷校書郎。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb8",
      "text": "秘書郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，遷秘書郎。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p1",
      "text": "軍器少監",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年，遷軍器少監，升權直。"
        }
      ]
    },
    {
      "office_id": "hixia8no9on4",
      "text": "起居舍人",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "六年，遷起居舍人，奏：「權姦擅政十有四年，朱熹、彭龜年以抗論逐，呂祖儉、周端朝以上書斥，當時近臣猶有爭之者。"
        }
      ]
    },
    {
      "office_id": "hixi4udt505i",
      "text": "秘閣修撰",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂力請去，出為秘閣修撰、江東轉運副使。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "理宗即位，召為中書舍人，尋擢禮部侍郎、直學士院。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "理宗即位，召為中書舍人，尋擢禮部侍郎、直學士院。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "上欣然嘉納，改翰林學士、知制誥，時政多所論建。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，知貢舉，已得疾，拜參知政事，同編修敕令、《經武要略》。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三乞祠祿，上不得已，進資政殿學士、提舉萬壽觀兼侍讀，辭。"
        }
      ]
    },
    {
      "office_id": "hixia8pooqo2",
      "text": "銀青光祿大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百三十七·真德秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遺表聞，上震悼，輟視朝，贈銀青光祿大夫。"
        }
      ]
    }
  ]
}
