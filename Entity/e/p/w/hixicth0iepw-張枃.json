  "primary_name": "張枃",
  "alt_names": [
    {
      "name": "定叟",
      "type": "字"
    }
  ],
  "dynasty": "南宋",
  "dynasty_basis": "據正史本傳",
  "period": "song",
  "period_basis": "據 dynasty「南宋」歸併",
  "title_or_office": "兩浙轉運判官",
  "description": {
    "text": "張浚次子、張栻弟。以父恩補官，歷知袁州、衢州，督浙西荒政，孝宗稱之，官至直徽猷閣。",
    "sources": [
      {
        "name": "《宋史·張浚傳》",
        "details": "卷361"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8n08etf",
      "text": "樞密院編修官",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "聞高宗即位，馳赴南京，除樞密院編修官，改虞部郎，擢殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3l",
      "text": "殿中侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "聞高宗即位，馳赴南京，除樞密院編修官，改虞部郎，擢殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8n3o0sg",
      "text": "侍御史",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷侍御史。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咈宰相意，除集英殿修撰、知興元府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未行，擢禮部侍郎，高宗召諭曰：「卿知無不言，言無不盡，朕將有為，正如欲一飛沖天而無羽翼，卿勉留輔朕。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegoy",
      "text": "知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "入見，高宗手詔辨浚前誣，除知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "尚書右僕射",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "五年，除尚書右僕射、同中書門下平章事兼知樞密院事，都督諸路軍馬，趙鼎除左僕射。"
        }
      ]
    },
    {
      "office_id": "hixia8mjdlhc",
      "text": "金紫光祿大夫",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，加金紫光祿大夫。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6s",
      "text": "資政殿大學士",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，除資政殿大學士、知福州兼福建安撫大使。"
        }
      ]
    },
    {
      "office_id": "hixia8nc3fgj",
      "text": "觀文殿大學士",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "二十五年，復觀文殿大學士、判洪州。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "start": 1163,
      "end": 1163,
      "date_text": "隆興元年",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "隆興元年，除樞密使，都督建康、鎮江府、江州、池州、江陰軍軍馬。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "少師",
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "浚留平江，凡八章乞致仕，除少師、保信軍節度、判福州。"
        }
      ]
    },
    {
      "office_id": "hixia8p0ngu8",
      "text": "太保",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百六十一·張浚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "訃聞，孝宗震悼，輟視朝，贈太保，後加贈太師，諡忠獻。"
        }
      ]
    }
  ],
