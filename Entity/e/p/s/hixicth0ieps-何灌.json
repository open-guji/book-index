  "native_place": "開封祥符",
  "native_place_basis": "《宋史》卷357本傳著錄「開封祥符人」",
  "dates": {
    "death": 1127,
    "basis": "據《宋史》本傳紀年"
  },
  "description": {
    "text": "開封祥符人。武選登第，久戍河東、西邊，以善射名；靖康初金兵圍汴京，背城拒戰三日，創重沒於陣，年六十二。",
    "sources": [
      {
        "name": "《宋史·何灌傳》",
        "details": "卷357"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8p4ebcx",
      "text": "知寧化軍",
      "place_id": "hixicl84wb1m",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知寧化軍、豐州，徙熙河都監，見童貫不拜，貫憾焉。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl5u",
      "text": "西上閤門使",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "提點河東刑獄，遷西上閤門使、領威州刺史、知滄州。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知岷州",
      "place_id": "hixicl857jhu",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，知岷州，引邈川水溉閒田千頃，湟人號廣利渠。"
        }
      ]
    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "吉州防禦使",
      "place_id": "hixicl85is29",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "童貫用兵西邊，灌取古骨龍馬進武軍，加吉州防禦使，改知蘭州。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "同州觀察使",
      "place_id": "hixicl857jez",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從平方臘，獲賊帥呂師囊，遷同州觀察使、浙東都鈐轄，改浙西。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6h",
      "text": "寧武軍承宣使",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "童貫北征，檄統制兵馬，涿、易平，以知易州，遷寧武軍承宣使、燕山路副都總管，又加龍、神衛都指揮使。"
        }
      ]
    },
    {
      "office_id": "hixigfk3ei2o",
      "text": "步軍都虞候",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷步軍都虞候。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "武泰軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百五十七·何灌傳",
          "source_bid": "d59f2gonq7sy",
          "details": "不從，明日，又命灌行，辭以軍不堪戰，強之，拜武泰軍節度使、河東河北制置副使。"
        }
      ]
    }
  ],
