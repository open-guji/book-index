  "offices": [
    {
      "office_id": "hixia8o5qz2b",
      "text": "知澧州",
      "place_id": "hixicl85is4d",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知澧州，未上，薛叔似宣撫京湖，辟主管機宜文字。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "湖南轉運判官",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋提舉湖北常平，權知鄂州兼湖廣總領，改提點刑獄，遷湖南轉運判官。"
        }
      ]
    },
    {
      "office_id": "hixia8p1wf0g",
      "text": "直祕閣",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷直祕閣、知潭州、湖南安撫。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu6",
      "text": "大理少卿",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷大理少卿，又權戶部侍郎，以寶謨閣待制知成都。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷大理少卿，又權戶部侍郎，以寶謨閣待制知成都。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "理宗即位，擢兵部侍郎兼國史院同修撰。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "禮部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋兼侍讀，俄遷禮部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8nfj1fn",
      "text": "寶謨閣直學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加寶謨閣直學士，提舉佑神觀兼侍讀。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授兵部尚書，力辭不拜。"
        }
      ]
    },
    {
      "office_id": "hixia8pctq0w",
      "text": "寶章閣學士",
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改寶章閣學士、知常德府，陛辭，言下情未通，橫斂未革。"
        }
      ]
    },
    {
      "office_id": "hixia8p2iw3m",
      "text": "宣奉大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百一十·曹彥約傳",
          "source_bid": "d59f2gonq7sy",
          "details": "提舉崇福宮，卒，以華文閣學士轉通議大夫致仕，贈宣奉大夫。"
        }
      ]
    }
  ]
