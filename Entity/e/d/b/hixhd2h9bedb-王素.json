  "offices": [
    {
      "office_id": "hixia8mx41dv",
      "text": "天章閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百二十·王素傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賜素銀緋，擢天章閣待制、淮南都轉運按察使。"
        }
      ]
    },
    {
      "office_id": "hixi4ugstvk0",
      "text": "龍圖閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百二十·王素傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俄悉還其故，遷龍圖閣直學士。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知渭州",
      "place_id": "hixicl857jh9",
      "sources": [
        {
          "title": "《宋史》卷三百二十·王素傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召拜端明殿學士，復知渭州，於是三鎮、涇原蕃夷故老皆歡賀，比至，敵解去。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "青州觀察使",
      "place_id": "hixicl84l2e5",
      "sources": [
        {
          "title": "《宋史》卷三百二十·王素傳",
          "source_bid": "d59f2gonq7sy",
          "details": "換澶州觀察使、知成德軍，改青州觀察使。"
        }
      ]
    }
  ]
