  "description": {
    "text": "熙州人，後徙環州。應募擊夏有功，從劉延慶平方臘；建炎初任御營使司都統制，三年苗傅、劉正彥兵變被殺，諡襄愍。",
    "sources": [
      {
        "name": "《宋史·王淵傳》",
        "details": "卷369"
      },
      {
        "title": "《甘肅通志》卷34·人物",
        "source_bid": "d59fynscyghu",
        "details": "王淵字幾道熙州人善騎射應募擊夏國屢有戰功累遷熙河蘭湟路部將權知鞏州寧逺砦西羌入犯淵大破之宣和中劉延慶討方臘以淵為先鋒賊勢張甚淵逆擊平之授閤門宣贊舍人高宗即位以淵……"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixidx4p62vg",
      "text": "閤門宣贊舍人",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·王淵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授閤門宣贊舍人、權京畿提舉保甲兼權提點刑獄公事。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6z",
      "text": "拱衛大夫",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·王淵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又從楊惟忠、辛興宗破群盜高托山等，遷拱衛大夫、寧州觀察使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6h",
      "text": "保大軍承宣使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·王淵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝如揚州，授龍、神衛四廂都指揮使，尋改捧日、天武四廂都指揮使，進保大軍承宣使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "嚮德軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·王淵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷嚮德軍節度使。"
        }
      ]
    },
    {
      "office_id": "hixi4udstrly",
      "text": "簽書樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·王淵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋自平江赴行在，拜簽書樞密院事，仍兼都統制。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr5",
      "text": "開府儀同三司",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百六十九·王淵傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈開府儀同三司，累加少保，官其子孫八人。"
        }
      ]
    },
