  "description": {
    "text": "綏德軍青澗人，初名世輔。陷金後率眾南歸，賜名顯忠；隆興元年與邵宏淵北伐，克靈璧、宿州，敗於符離。淳熙四年卒，年六十九，諡忠襄。",
    "sources": [
      {
        "name": "《宋史·李顯忠傳》",
        "details": "卷367"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximxfukl6d",
      "text": "指揮使",
      "sources": [
        {
          "title": "《宋史》卷三百六十七·李顯忠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "從行使臣崔臯等六百餘人列拜庭下，玠又撫之，犒以銀絹，詣行府受告敕、金帶，除指揮使、承宣使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "保信軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百六十七·李顯忠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太后至臨安，顯忠入覲，加保信軍節度使、浙東副總管。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "sources": [
        {
          "title": "《宋史》卷三百六十七·李顯忠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授顯忠淮西制置使、京畿等處招討使，擢太尉、寧國軍節度使、主管侍衛馬軍司公事，赴行在。"
        }
      ]
    },
    {
      "office_id": "hixia8nnn7k2",
      "text": "防禦使",
      "sources": [
        {
          "title": "《宋史》卷三百六十七·李顯忠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "乾道改元，乃還會稽，復防禦使，觀察使、浙東副總管，賜銀三萬兩，絹三萬匹，綿一萬兩。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "sources": [
        {
          "title": "《宋史》卷三百六十七·李顯忠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復太尉。"
        }
      ]
    },
    {
      "office_id": "hixia8nlgjr5",
      "text": "開府儀同三司",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百六十七·李顯忠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈開府儀同三司，諡「忠襄」。"
        }
      ]
    }
