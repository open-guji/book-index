  "description": {
    "text": "鳳翔府成紀人。起於弓箭手，南渡後為中興大將，平苗劉、破劉猊於藕塘；紹興十一年附和議罷兵柄，任樞密使，二十四年卒，年六十九，追封循王。",
    "sources": [
      {
        "name": "《宋史·張俊傳》",
        "details": "卷369"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnn7k2",
      "text": "貴州防禦使",
      "place_id": "hixicl86597q",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·張俊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進桂州團練使，尋加貴州防禦使。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "徐州觀察使",
      "place_id": "hixicl84l2fx",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·張俊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進徐州觀察使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "鎮西軍節度使",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·張俊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "世忠、俊、光世入城，見於內殿，帝嘉勞久之，拜鎮西軍節度使、御前右軍都統制，尋為浙東制置使。"
        }
      ]
    },
    {
      "office_id": "hixia8nptvcw",
      "text": "太尉",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·張俊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜太尉。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0x",
      "text": "少傅",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·張俊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "賜俊「安民靖難功臣」，拜少傅。"
        }
      ]
    },
    {
      "office_id": "hixia8n7evb4",
      "text": "少師",
      "sources": [
        {
          "title": "《宋史》卷三百六十九·張俊傳",
          "source_bid": "d59f2gonq7sy",
          "details": "俊引軍還壽春，進少師，封濟國公。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
