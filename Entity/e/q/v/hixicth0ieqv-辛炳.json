  "description": {
    "text": "福州侯官人。元符三年進士，任監察御史時劾蔡京直達綱之弊，貶官；紹興初除御史中丞，力言和議不可恃，未幾卒，貧無以葬。",
    "sources": [
      {
        "name": "《宋史·辛炳傳》",
        "details": "卷372"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "start": 1100,
      "end": 1100,
      "date_text": "元符三年",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·辛炳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "登元符三年進士第，累官至監察御史兼權殿中侍御史。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·辛炳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "靖康初，召為兵部員外郎。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl56",
      "text": "左司員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·辛炳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "高宗即位，除左司員外郎，辭；未幾，起直龍圖閣、知潭州。"
        }
      ]
    },
    {
      "office_id": "hixia8ma0h6o",
      "text": "顯謨閣直學士",
      "sources": [
        {
          "title": "《宋史》卷三百七十二·辛炳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以疾請外，除顯謨閣直學士、知漳州，未赴而卒。"
        }
      ]
    },
    {
      "office_id": "hixia8m5bx1g",
      "text": "通議大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百七十二·辛炳傳",
          "source_bid": "d59f2gonq7sy",
          "details": "詔：炳任中執法，操行清修，今其云亡，貧無以葬，賜銀帛賻其家，贈通議大夫。"
        }
      ]
    }
