          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "登進士第，應舉登乙第，拜校書郎。"
        }
      ]
    },
    {
      "office_id": "hiximdfhd4oz",
      "text": "右拾遺",
      "sources": [
        {
          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "玄宗在東宮，舉天下文藻之士，親加策問，九齡對策高第，遷右拾遺。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj8",
      "text": "中書舍人",
      "start": 723,
      "end": 723,
      "date_text": "十一年",
      "basis": "承上文年號開元",
      "sources": [
        {
          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "十一年，拜中書舍人。"
        }
      ]
    },
    {
      "office_id": "hixikfed18he",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "無幾，說果為融所劾，罷知政事，九齡亦改太常少卿，尋出為冀暫刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "再遷中書侍郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiq",
      "text": "中書令",
      "sources": [
        {
          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "明年，遷中書令，兼修國史。"
        }
      ]
    },
    {
      "office_id": "hixikfedcgzm",
      "text": "金紫光祿大夫",
      "sources": [
        {
          "title": "《舊唐書》卷九十九·張九齡傳",
          "source_bid": "d59f2ofs2u4h",
          "details": "二十三年，加金紫光祿大夫，累封始興縣伯。"
        }
      ]
    },
    {
      "office_id": "hiximdfhd4ox",
      "text": "左拾遺",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "擢進士，始調校書郎，以道侔伊呂科策高第，為左拾遺。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj8",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷中書舍人內供奉，封曲江男，進中書舍人。"
        }
      ]
    },
    {
      "office_id": "hixikfed18he",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "俄為融等痛詆，幾不免，九齡亦改太常少卿，出為冀州刺史。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj0",
      "text": "冀州刺史",
      "place_id": "hixicl899mh3",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "俄為融等痛詆，幾不免，九齡亦改太常少卿，出為冀州刺史。"
        }
      ]
    },
    {
      "office_id": "hixia8pv8q2o",
      "text": "秘書少監",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "說卒，天子思其言，召為秘書少監、集賢院學士，知院事。"
        }
      ]
    },
    {
      "office_id": "hixikfed18ge",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷工部侍郎，知制誥。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj5",
      "text": "中書侍郎",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "遷中書侍郎，以母喪解，毀不勝哀，有紫芝產坐側，白鳩、白雀巢家樹。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuiq",
      "text": "中書令",
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
          "details": "明年，遷中書令。"
        }
      ]
    },
    {
      "office_id": "hixia8oaqrr7",
      "text": "司徒",
      "posthumous": true,
      "sources": [
        {
          "title": "《新唐書》卷一百二十六·張九齡傳",
          "source_bid": "d59f2htqolj5",
