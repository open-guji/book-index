  "description": {
    "text": "博州高平人。紹興三十一年金人渝盟，結豪傑起兵河北，眾至數萬，後率眾南歸；歷知州、殿前指揮使，卒年六十一。",
    "sources": [
      {
        "name": "《宋史·王友直傳》",
        "details": "卷370"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnn7k2",
      "text": "復州防禦使",
      "place_id": "hixicl85is43",
      "sources": [
        {
          "title": "《宋史》卷三百七十·王友直傳",
          "source_bid": "d59f2gonq7sy",
          "details": "友直恥前功不遂，自陳，改復州防禦使，以忠義軍統制隸鎮江都統司。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl65",
      "text": "殿前副都指揮使",
      "start": 1172,
      "end": 1172,
      "date_text": "八年",
      "basis": "承上文年號乾道",
      "sources": [
        {
          "title": "《宋史》卷三百七十·王友直傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年，轉承宣使，旋除殿前副都指揮使。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "奉國軍節度使",
      "start": 1174,
      "end": 1174,
      "date_text": "淳熙元年",
      "sources": [
        {
          "title": "《宋史》卷三百七十·王友直傳",
          "source_bid": "d59f2gonq7sy",
          "details": "淳熙元年，授奉國軍節度使。"
        }
      ]
    },
    {
      "office_id": "hixia8mv8m4h",
      "text": "宜州觀察使",
      "place_id": "hixifx69t1qc",
      "sources": [
        {
          "title": "《宋史》卷三百七十·王友直傳",
          "source_bid": "d59f2gonq7sy",
          "details": "晚節宴安，軍政稍失律，授宜州觀察使。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6h",
      "text": "武寧軍承宣使",
      "sources": [
        {
          "title": "《宋史》卷三百七十·王友直傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以郊祀恩內徙，三奉祠，復武寧軍承宣使。"
        }
      ]
    },
