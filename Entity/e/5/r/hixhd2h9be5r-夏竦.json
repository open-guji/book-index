      },
      {
        "title": "《欽定四庫全書總目》卷一百五十二·《文莊集》提要",
        "source_bid": "d59dh3vo9af4",
        "details": "宋夏竦撰。"
      },
      {
        "title": "《欽定四庫全書總目》卷四十四·《韻經》提要",
        "source_bid": "d59dh3vo9af4",
        "details": "舊本題梁吳興沈約撰類，宋會稽夏竦集古，明宏農楊愼轉注，江夏郭正域校。"
      },
      {
        "name": "《宋史·夏竦傳》",
        "details": "卷283，傳首：夏竦，字子喬，江州德安人。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximda1c3l2",
      "text": "崇儀使",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "契丹內寇，承皓繇間道發兵，夜與契丹遇，力戰死之，贈崇儀使，錄竦為潤州丹陽縣主簿。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfm",
      "text": "光祿寺丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "舉賢良方正，擢光祿寺丞、通判台州。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召直集賢院，為國史編修官、判三司都磨勘司，累遷右正言。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktft",
      "text": "禮部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "景靈宮成，遷禮部郎中。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfo",
      "text": "戶部郎中",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷戶部郎中，徙壽、安、洪三州。"
        }
      ]
    },
    {
      "office_id": "hixia8n81ce8",
      "text": "諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷諫議大夫，為樞密副使、修國史，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixia8p2u4n4",
      "text": "樞密副使",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷諫議大夫，為樞密副使、修國史，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷諫議大夫，為樞密副使、修國史，遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改參知政事、祥源觀使。"
        }
      ]
    },
    {
      "office_id": "hixia8os826b",
      "text": "尚書左丞",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "史成，進兵部，尋進尚書左丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptv",
      "text": "刑部尚書",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，罷安撫，遷刑部尚書、徙應天府。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "奉寧軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "趙元昊反，拜奉寧軍節度使、知永興軍，聽便宜行事。"
        }
      ]
    },
    {
      "office_id": "hixia8n81cec",
      "text": "樞密使",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "慶曆中，召為樞密使。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "歲中，加資政殿學士。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "明年，拜同中書門下平章事、判大名府。"
        }
      ]
    },
    {
      "office_id": "hixia8oxj3eq",
      "text": "武寧軍節度使",
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "饗明堂，徙武寧軍節度使，進鄭國公，錫賚與輔臣等。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十三·夏竦傳",
          "source_bid": "d59f2gonq7sy",
          "details": "贈太師、中書令。"
        }
      ]
    }
  ]
}
