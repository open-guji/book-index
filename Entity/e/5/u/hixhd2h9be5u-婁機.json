  "offices": [
    {
      "office_id": "hixi5uk9g0sl",
      "text": "太常博士",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷宗正寺主簿，為太常博士、秘書郎，請續編《中興館閣書目》，又請寬恤淮、浙被旱州縣。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷太常丞，仍兼資善。"
        }
      ]
    },
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢監察御史，講未退而除命頒，太子戀戀幾不忍舍，機亦為之感涕。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進太常少卿兼權中書舍人，詔遣宣諭荊、襄，機昌言曰：「使往慰安人情則可，必欲開邊啟釁，有死而已，不能從也。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "侂胄誅，召為吏部侍郎兼太子左庶子，還朝，言：「至公始可以服天下，權臣以私意橫生，敗國殄民，今當行以至公。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷給事中。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷禮部尚書兼給事中，擢同知樞密院事兼太子賓客，進參知政事。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷禮部尚書兼給事中，擢同知樞密院事兼太子賓客，進參知政事。"
        }
      ]
    },
    {
      "office_id": "hiximxfukl6j",
      "text": "禮儀使",
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九月祀明堂，為禮儀使。"
        }
      ]
    },
    {
      "office_id": "hixia8mjdlhc",
      "text": "金紫光祿大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷四百一十·婁機傳",
          "source_bid": "d59f2gonq7sy",
          "details": "提舉洞霄宮以歸，遂卒，贈金紫光祿大夫，加贈特進。"
        }
      ]
    }
  ],
