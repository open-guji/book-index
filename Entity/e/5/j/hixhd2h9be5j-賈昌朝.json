        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再遷殿中丞，曆知宜興、東明縣。"
        }
      ]
    },
    {
      "office_id": "hixia8now5qa",
      "text": "直集賢院",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "誦說明白，帝多所質問，昌朝請記錄以進，賜名《邇英延義記注》，加直集賢院。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32g",
      "text": "知制誥",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢知制誥、權判吏部流內銓兼侍講。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "”\n\n進龍圖閣直學士、權知開封府，遷右諫議大夫、權御史中丞兼判國子監。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "start": 1043,
      "end": 1043,
      "date_text": "慶曆三年",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "慶曆三年，拜參知政事。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "”\n\n以工部侍郎充樞密使，尋拜同中書門下平章事、集賢殿大學士，仍兼樞密使。"
        }
      ]
    },
    {
      "office_id": "hixia8pdg743",
      "text": "昭文館大學士",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "居兩月，拜昭文館大學士，監修國史。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "尚書右僕射",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "過闕入覲，留為祥源觀使，拜尚書右僕射、觀文殿大學士、判尚書都省，朝會班中書門下，視其儀物。"
        }
      ]
    },
    {
      "office_id": "hixia8nl5b7k",
      "text": "同中書門下平章事",
      "sources": [
        {
          "title": "《宋史》卷二百八十五·賈昌朝傳",
          "source_bid": "d59f2gonq7sy",
          "details": "固辭僕射、侍中，改同中書門下平章事。"
        }
      ]
    },
    {
