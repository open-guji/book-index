    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷四百四十二·石延年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "用薦者通判乾寧軍，徙永靜軍，爲大理評事、館閣校勘，歷光祿、大理寺丞，上書章獻太后，請還政天子。"
        }
      ]
    },
    {
      "office_id": "hixia8m6kv7l",
      "text": "祕閣校理",
      "sources": [
        {
