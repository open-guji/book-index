  "offices": [
    {
      "office_id": "hixia8n7evb8",
      "text": "秘書郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "真宗即位，復為秘書郎。"
        }
      ]
    },
    {
      "office_id": "hixia8nu76yr",
      "text": "秘書丞",
      "start": 1000,
      "end": 1000,
      "date_text": "咸平三年",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "咸平三年，屢上疏言事，召試學士院，遷秘書丞、知閬州。"
        }
      ]
    },
    {
      "office_id": "hixia8p7iosg",
      "text": "龍圖閣待制",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，遷右正言，充龍圖閣待制，賜金紫。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpug",
      "text": "刑部員外郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "加刑部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2u32n",
      "text": "集賢殿修撰",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "禮成，進秩工部郎中，加集賢殿修撰。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfn",
      "text": "兵部郎中",
      "start": 1010,
      "end": 1010,
      "date_text": "三年",
      "basis": "承上文年號大中祥符",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "三年，改兵部郎中、龍圖閣直學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷右諫議大夫兼秘書監，詔就賜食廳編次《太宗御集》，賜勳上柱國。"
        }
      ]
    },
    {
      "office_id": "hixi4udsij2k",
      "text": "學士",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "六年，召入翰林，充學士兼龍圖閣學士，同修國史。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "又與謂同知禮儀院，禮成，加給事中。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "國史成，遷工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "九年，拜刑部侍郎、參知政事，判禮儀院，充會靈觀使。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進兵部侍郎，表求罷奉，不許。"
        }
      ]
    },
    {
      "office_id": "hixiby3db30q",
      "text": "右僕射",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷二百八十七·陳彭年傳",
          "source_bid": "d59f2gonq7sy",
          "details": "廢朝，贈右僕射，諡曰文僖，錄子佺期大理寺丞，孫彥先太常寺奉禮郎。"
        }
      ]
    }
