  "offices": [
    {
      "office_id": "hixia8p1wf0g",
      "text": "直秘閣",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹興間，通判明州，加直秘閣，累遷右文殿修撰，仕外服有聲。"
        }
      ]
    },
    {
      "office_id": "hixidx4p62vb",
      "text": "右文殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹興間，通判明州，加直秘閣，累遷右文殿修撰，仕外服有聲。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知臨安府",
      "place_id": "hixicl857jhy",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "高宗材之，知臨安府。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu1",
      "text": "戶部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "御史中丞汪澈論版曹闕官，當遴選，權戶部侍郎兼樞密都承旨。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遂除吏部侍郎，再往淮上，驛疏言：「遣使、發兵當並行，使以盡其禮，兵以防其變，不必待金書至而後遣使。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "兼戶部尚書，俄拜端明殿學士、簽書樞密院事兼權參知政事。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9g0si",
      "text": "參知政事",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "除參知政事兼權知樞密院事。"
        }
      ]
    },
    {
      "office_id": "hixi4ugtrl6s",
      "text": "資政殿大學士",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "鄧王立為太子，端禮引嫌，除資政殿大學士、提舉德壽宮兼侍讀，改提舉洞霄宮。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "起知寧國府，移紹興，進觀文殿學士。"
        }
      ]
    },
    {
      "office_id": "hixia8pooqo2",
      "text": "銀青光祿大夫",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百八十五·錢端禮傳",
          "source_bid": "d59f2gonq7sy",
          "details": "薨，贈銀青光祿大夫，後諡「忠肅」。"
        }
      ]
    }
  ],
