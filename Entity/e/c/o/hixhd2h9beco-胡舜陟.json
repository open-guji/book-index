    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "start": 1109,
      "end": 1109,
      "date_text": "大觀三年",
      "sources": [
        {
          "title": "《宋史》卷三百七十八·胡舜陟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "登大觀三年進士第，歷州縣官，為監察御史。"
        }
      ]
    },
    {
      "office_id": "hixia8mwssu9",
      "text": "集英殿修撰",
      "sources": [
        {
          "title": "《宋史》卷三百七十八·胡舜陟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "言者論其嘗事偽廷，除集英殿修撰、知廬州。"
        }
      ]
    },
    {
      "office_id": "hixi4ufdmyh7",
      "text": "徽猷閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百七十八·胡舜陟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝壯其言，擢徽猷閣待制，充淮西制置使。"
        }
      ]
    },
    {
      "office_id": "hixia8omx0xu",
      "text": "淮西制置使",
      "kind": "充",
      "sources": [
        {
          "title": "《宋史》卷三百七十八·胡舜陟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝壯其言，擢徽猷閣待制，充淮西制置使。"
        }
      ]
    },
    {
      "office_id": "hixi4ufdmyh7",
      "text": "徽猷閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百七十八·胡舜陟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，改知臨安府，復為徽猷閣待制，充京畿數路宣撫使。"
        }
      ]
    },
    {
      "office_id": "hixia8p77g8w",
      "text": "淮西安撫使",
      "sources": [
        {
          "title": "《宋史》卷三百七十八·胡舜陟傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋罷，遷廬、壽鎮撫使，改淮西安撫使。"
