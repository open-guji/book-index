  "offices": [
    {
      "office_id": "hixia8mqk1z7",
      "text": "祕書省正字",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "簽書建康軍節度判官廳公事，授祕書省正字。"
        }
      ]
    },
    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷祕書郎，尋遷著作佐郎、知徽州。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知衢州",
      "place_id": "hixicl857jkc",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "丁父憂，服除，知衢州。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "福建轉運判官",
      "kind": "兼",
      "place_id": "hixiclu1dr11",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝親政，以直徽猷閣知建寧府，明年，兼福建轉運判官。"
        }
      ]
    },
    {
      "office_id": "hixia8opexaa",
      "text": "祕書少監",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷祕書少監。"
        }
      ]
    },
    {
      "office_id": "hixia8mpmcch",
      "text": "起居郎",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "授起居郎兼中書舍人。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "start": 1237,
      "end": 1237,
      "date_text": "嘉熙元年",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "嘉熙元年，遷中書舍人。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "翼日，權吏部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知婺州",
      "declined": true,
      "place_id": "hixicl857jj4",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改知嘉興府，知婺州，皆辭不拜。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptx",
      "text": "吏部侍郎",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷吏部侍郎兼國子祭酒，日召諸生叩其問學理義講習之益。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu0",
      "text": "兵部尚書",
      "kind": "權",
      "sources": [
        {
          "title": "《宋史》卷四百零五·袁甫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "權兵部尚書，暫兼吏部尚書，卒，贈通奉大夫，諡「正肅」。"
        }
      ]
    },
    {
      "office_id": "hixi4u82hwjm",
      "text": "吏部侍郞",
      "sources": [
        {
