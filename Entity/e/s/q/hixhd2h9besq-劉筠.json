  "offices": [
    {
      "office_id": "hixia8p3glq9",
      "text": "左正言",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "及《冊府元龜》成，進左正言、直史館、修起居注。"
        }
      ]
    },
    {
      "office_id": "hixia8newkcg",
      "text": "史館修撰",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷左司諫、知制誥，加史館修撰，出知鄧州，徙陳州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuj",
      "text": "尚書兵部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "還，糾察在京刑獄，知貢舉，遷尚書兵部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復請鄧州，未行，進翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixi5kwirncz",
      "text": "給事中",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷給事中，復召為翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷給事中，復召為翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixia8odv56o",
      "text": "御史中丞",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾月，拜御史中丞。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpts",
      "text": "尚書禮部侍郎",
      "start": 1024,
      "end": 1024,
      "date_text": "天聖二年",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "天聖二年貢舉，數以疾告，進尚書禮部侍郎、樞密直學士、知潁州。"
        }
      ]
    },
    {
      "office_id": "hixidx4p62vm",
      "text": "知貢舉",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，復知貢舉，進翰林學士承旨兼龍圖閣直學士、同修國史、判尚書都省。"
        }
      ]
    },
    {
      "office_id": "hixia8orll36",
      "text": "翰林學士承旨",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召還，復知貢舉，進翰林學士承旨兼龍圖閣直學士、同修國史、判尚書都省。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知廬州",
      "place_id": "hixicl85iryx",
      "sources": [
        {
          "title": "《宋史》卷三百零五·劉筠傳",
          "source_bid": "d59f2gonq7sy",
          "details": "再知廬州，營塚墓，作棺，自為銘刻之。"
        }
      ]
    }
  ]
