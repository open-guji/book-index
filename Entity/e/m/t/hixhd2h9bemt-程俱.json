    {
      "office_id": "hixia8op3oqo",
      "text": "著作佐郎",
      "sources": [
        {
          "title": "《宋史》卷四百四十五·程俱傳",
          "source_bid": "d59f2gonq7sy",
          "details": "近臣以譔述薦，遷著作佐郎。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷四百四十五·程俱傳",
          "source_bid": "d59f2gonq7sy",
          "details": "建炎中，為太常少卿、知秀州。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "sources": [
        {
          "title": "《宋史》卷四百四十五·程俱傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢中書舍人兼侍講。"
        }
      ]
    },
    {
      "office_id": "hixi4ufdmyh7",
      "text": "徽猷閣待制",
      "sources": [
        {
          "title": "《宋史》卷四百四十五·程俱傳",
          "source_bid": "d59f2gonq7sy",
