      },
      {
        "name": "《宋史·趙汝愚傳》",
        "details": "卷392，傳首：趙汝愚，字子直，漢恭憲王元佐七世孫，居饒之餘干縣。"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8mqk1z7",
      "text": "祕書省正字",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢進士第一，簽書寧國軍節度判官，召試館職，除祕書省正字。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9c7",
      "text": "校書郎",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "孝宗方銳意恢復，始見，即陳自治之策，孝宗稱善，遷校書郎。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "江西轉運判官",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷著作郎、知信州，易台州，除江西轉運判官，入爲吏部郎兼太子侍講。"
        }
      ]
    },
    {
      "office_id": "hixia8opexaa",
      "text": "祕書少監",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷祕書少監兼權給事中。"
        }
      ]
    },
    {
      "office_id": "hixia8mvjuo3",
      "text": "敷文閣學士",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進敷文閣學士，知福州。"
        }
      ]
    },
    {
      "office_id": "hixia8o5qz2b",
      "text": "知福州",
      "place_id": "hixicl85u0j6",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "進敷文閣學士，知福州。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptu",
      "text": "吏部尚書",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "紹熙二年，召爲吏部尚書。"
        }
      ]
    },
    {
      "office_id": "hixia8ot5rsw",
      "text": "同知樞密院事",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "汝愚除同知樞密院事，義端言祖宗之法，宗室不爲執政，詆汝愚植黨沽名，疏上，不納。"
        }
      ]
    },
    {
      "office_id": "hixia8nhegoy",
      "text": "知樞密院事",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，遷知樞密院事，辭不拜，有旨趣受告。"
        }
      ]
    },
    {
      "office_id": "hixia8mode6b",
      "text": "特進",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "留正至，汝愚乞免兼職，乃除特進、右丞相。"
        }
      ]
    },
    {
      "office_id": "hixia8n0uvwh",
      "text": "光祿大夫",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "侂胄因而間之，出正判建康，命汝愚爲光祿大夫、右丞相。"
        }
      ]
    },
    {
      "office_id": "hixia8okqd4y",
      "text": "觀文殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "汝愚出浙江亭待罪，遂罷右相，除觀文殿學士、知福州。"
        }
      ]
    },
    {
      "office_id": "hixia8o5fqio",
      "text": "資政殿學士",
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "汝愚既歿，黨禁寖解，旋復資政殿學士、太中大夫，已而贈少保。"
        }
      ]
    },
    {
      "office_id": "hixi5uql00sj",
      "text": "太師",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百九十二·趙汝愚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "侂胄誅，盡復元官，賜諡「忠定」，贈太師，追封沂國公。"
        }
      ]
    }
  ]
}
