  "offices": [
    {
      "office_id": "hixia8o5qz2b",
      "text": "知宿州",
      "place_id": "hixicl857jl6",
      "sources": [
        {
          "title": "《宋史》卷三百四十五·劉安世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "知宿州，押伴夏使，使者多所要請，執禮不遜，且欲服毬文金帶入見，航皆折正之。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpum",
      "text": "左諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百四十五·劉安世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷起居舍人兼左司諫，進左諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixi5vx2iuj9",
      "text": "中書舍人",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷三百四十五·劉安世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "不報，遂請外，改中書舍人，辭不就。"
        }
      ]
    },
    {
      "office_id": "hixia8n5uold",
      "text": "寶文閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百四十五·劉安世傳",
          "source_bid": "d59f2gonq7sy",
          "details": "以集賢殿修撰提舉崇福宮，才六月，召為寶文閣待制、樞密都承旨。"
        }
      ]
    },
    {
      "office_id": "hixi4udstrlv",
      "text": "待制",
      "start": 1124,
      "end": 1124,
      "date_text": "宣和六年",
      "sources": [
