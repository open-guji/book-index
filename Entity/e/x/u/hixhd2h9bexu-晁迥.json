  "offices": [
    {
      "office_id": "hixia8ndcdmp",
      "text": "大理評事",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "迥舉進士，為大理評事，歷知岳州錄事參軍，改將作監丞，稍遷殿中丞。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfk",
      "text": "將作監丞",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "迥舉進士，為大理評事，歷知岳州錄事參軍，改將作監丞，稍遷殿中丞。"
        }
      ]
    },
    {
      "office_id": "hixidhu1xe0t",
      "text": "太常丞",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "復將作丞，監徐、婺二州稅，遷太常丞。"
        }
      ]
    },
    {
      "office_id": "hixia8onji0z",
      "text": "右司諫",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召試，除右司諫、知制誥，判尚書刑部。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝北征，雍王元份留守京師，加右諫議大夫，為判官，進翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixi5wrblts1",
      "text": "判官",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝北征，雍王元份留守京師，加右諫議大夫，為判官，進翰林學士。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9ca",
      "text": "翰林學士",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "帝北征，雍王元份留守京師，加右諫議大夫，為判官，進翰林學士。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptz",
      "text": "尚書工部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "封泰山，祀汾陰，同太常詳定儀注，累遷尚書工部侍郎。"
        }
      ]
    },
    {
      "office_id": "hixia8newkcg",
      "text": "史館修撰",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "使契丹，還，奏《北庭記》，加史館修撰、知通進銀臺司。"
        }
      ]
    },
    {
      "office_id": "hixicdy788p3",
      "text": "刑部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "史成，擢刑部侍郎，進承旨。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpty",
      "text": "兵部侍郎",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷兵部侍郎，請分司西京，特拜工部尚書、集賢院學士、判西京留司御史臺。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptw",
      "text": "禮部尚書",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "仁宗即位，遷禮部尚書。"
        }
      ]
    },
    {
      "office_id": "hixia8owwmbm",
      "text": "太子少傅",
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "既罷，所以寵賚者甚厚，進太子少傅。"
        }
      ]
    },
    {
      "office_id": "hixia8np7e9s",
      "text": "太子太保",
      "posthumous": true,
      "sources": [
        {
          "title": "《宋史》卷三百零五·晁迥傳",
          "source_bid": "d59f2gonq7sy",
          "details": "罷朝一日，贈太子太保，諡文元。"
        }
