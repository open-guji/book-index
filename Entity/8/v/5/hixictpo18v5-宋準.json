  "offices": [
    {
      "office_id": "hiximaqdxpuk",
      "text": "祕書省校書郎",
      "sources": [
        {
          "title": "《宋史》卷四百四十·宋準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太祖怒，召準覆試於便殿，見準形神偉茂，程試敏速，甚嘉之，以為宜首冠俊造，由是復擢準甲科，即授祕書省校書郎、直史館。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cc",
      "text": "著作郎",
      "start": 979,
      "end": 979,
      "date_text": "太平興國四年",
      "sources": [
        {
          "title": "《宋史》卷四百四十·宋準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "太平興國四年，遷著作郎、通判梓州，轉左拾遺。"
        }
      ]
    },
    {
      "office_id": "hixia8mnfojl",
      "text": "河北轉運使",
      "start": 983,
      "end": 983,
      "date_text": "八年",
      "basis": "承上文年號太平興國",
      "sources": [
        {
          "title": "《宋史》卷四百四十·宋準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "八年，同知貢舉，出為河北轉運使，歲餘，以本官知制誥。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktfu",
      "text": "主客員外郎",
      "sources": [
        {
          "title": "《宋史》卷四百四十·宋準傳",
          "source_bid": "d59f2gonq7sy",
          "details": "雍熙中，加主客員外郎，復預知貢舉，俄判大理寺。"
        }
      ]
    },
    {
      "office_id": "hiximaw4ktgt",
      "text": "金部郎中",
