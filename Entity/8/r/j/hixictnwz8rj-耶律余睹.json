    },
    {
      "office_id": "hixigfjypxxc",
      "text": "元帥右都監",
      "start": 1125,
      "end": 1125,
      "date_text": "天會三年",
      "sources": [
        {
          "title": "《金史》卷一百三十三·耶律余睹傳",
          "source_bid": "d59f2gpg4t8g",
          "details": "天會三年，大舉伐宋，余睹為元帥右都監，宋兵四萬救太原，余睹、屋里海逆擊於汾河北，擒其帥郝仲連、張關索，統制馬忠，殺萬餘人。"
        }
