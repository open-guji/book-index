  "description": {
    "text": "越州餘姚人。紹定五年進士，任吳縣主簿時焚毀妖人「水仙太保」祠；歷提舉常平，與丁大全議不合去國，後起知婺州卒。",
    "sources": [
      {
        "name": "《宋史·孫子秀傳》",
        "details": "卷424"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximxfukl5l",
      "text": "大宗正丞",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·孫子秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "未幾，遷大宗正丞，遷金部郎官。"
        }
      ]
    },
    {
      "office_id": "hixigfk90ruo",
      "text": "將作監",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·孫子秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷將作監、淮東總領，辭。"
        }
      ]
    },
    {
      "office_id": "hixia8pozz7m",
      "text": "湖南轉運副使",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·孫子秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "尋遷湖南轉運副使，以迎養非便辭，移浙西提點刑獄。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu2",
      "text": "太常少卿",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·孫子秀傳",
          "source_bid": "d59f2gonq7sy",
          "details": "度宗即位，進太常少卿兼右司，尋兼知臨安府，以言罷。"
        }
      ]
    }
  ],
