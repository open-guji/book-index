        {
          "title": "《宋史》卷四百二十五·趙景緯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召為史館檢閱，辭，不許；乞換待次教授，不許；乞岳祠，又不許；乞致仕，不報。"
        }
      ]
    },
    {
      "office_id": "hixi5uk9r9cc",
      "text": "著作郎",
      "sources": [
        {
          "title": "《宋史》卷四百二十五·趙景緯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷著作郎，辭，不許。"
        }
      ]
    },
    {
      "office_id": "hixia8p1wf0g",
      "text": "直祕閣",
      "sources": [
        {
