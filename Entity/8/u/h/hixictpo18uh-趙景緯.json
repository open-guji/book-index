          "source_bid": "d59f2gonq7sy",
          "details": "史成，兩乞外祠，進直祕閣，與在外宮觀，辭職名，不許。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpuh",
      "text": "太府少卿",
      "sources": [
        {
          "title": "《宋史》卷四百二十五·趙景緯傳",
          "source_bid": "d59f2gonq7sy",
          "details": "拜太府少卿，兼職仍舊，再辭，不許。"
        }
      ]
    },
