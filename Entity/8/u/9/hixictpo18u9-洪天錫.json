  "description": {
    "text": "泉州晉江人。寶慶二年進士；寶祐中任監察御史，劾董宋臣、盧允升等宦官，不得行而去，召為刑部尚書不起，卒諡文毅。",
    "sources": [
      {
        "name": "《宋史·洪天錫傳》",
        "details": "卷424"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hixia8nnyg3m",
      "text": "監察御史",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·洪天錫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "擢諸司糧料院，拜監察御史兼說書。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpu6",
      "text": "大理少卿",
      "declined": true,
      "sources": [
        {
          "title": "《宋史》卷四百二十四·洪天錫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "改大理少卿，再遷太常，皆不拜。"
        }
      ]
    },
    {
      "office_id": "hixia8mep1c2",
      "text": "廣東轉運判官",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·洪天錫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "直寶謨閣，遷廣東轉運判官，決疑獄，劾貪吏，治財賦，皆有法。"
        }
      ]
    },
    {
      "office_id": "hixia8oa4ao1",
      "text": "祕書監",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·洪天錫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召爲祕書監兼侍講，以聵辭，升祕閣修撰、福建轉運副使，又辭。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxptv",
      "text": "刑部尚書",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·洪天錫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "召爲刑部尚書，詔憲守之臣趣行無虛日，不起。"
        }
      ]
    },
    {
      "office_id": "hixia8pm6ubm",
      "text": "端明殿學士",
      "sources": [
        {
          "title": "《宋史》卷四百二十四·洪天錫傳",
          "source_bid": "d59f2gonq7sy",
          "details": "逾年，進華文閣直學士，仍舊宮觀，尋致仕，加端明殿學士，轉一官。"
        }
      ]
