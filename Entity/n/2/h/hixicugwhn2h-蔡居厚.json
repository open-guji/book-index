  "period_basis": "據 dynasty「北宋」歸併",
  "title_or_office": "戶部侍郎、徽猷閣待制",
  "description": {
    "text": "蔡延禧之子，進士。大觀初為右正言、右諫議大夫，論東南兵政七弊；以為宋喬年父子所用出知秦州，後歷知滄、陳、齊州及應天、河南尹，未赴青州而卒。",
    "sources": [
      {
        "name": "《宋史·蔡居厚傳》",
        "details": "卷356"
      }
    ]
  },
  "offices": [
    {
      "office_id": "hiximaqdxpu4",
      "text": "吏部員外郎",
      "sources": [
        {
          "title": "《宋史》卷三百五十六·蔡居厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "居厚第進士，累官吏部員外郎。"
        }
      ]
    },
    {
      "office_id": "hixia8p3glq9",
      "text": "右正言",
      "sources": [
        {
          "title": "《宋史》卷三百五十六·蔡居厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "大觀初，拜右正言，奏疏曰：「神宗造立法度，曠古絕儗，雖符、祐之黨力起相軋，而終不能搖者，出於人心理義之所在也。"
        }
      ]
    },
    {
      "office_id": "hiximaqdxpun",
      "text": "右諫議大夫",
      "sources": [
        {
          "title": "《宋史》卷三百五十六·蔡居厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "遷起居郎，進右諫議大夫。"
        }
      ]
    },
    {
      "office_id": "hixi4ufdmyh7",
      "text": "徽猷閣待制",
      "sources": [
        {
          "title": "《宋史》卷三百五十六·蔡居厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "蔡京再相，起知滄、陳、齊三州，加徽猷閣待制，為應天、河南尹。"
        }
      ]
    },
    {
      "office_id": "hixia8mg981t",
      "text": "知東平府",
      "place_id": "hixicl84l2g7",
      "sources": [
        {
          "title": "《宋史》卷三百五十六·蔡居厚傳",
          "source_bid": "d59f2gonq7sy",
          "details": "久之，知東平府。"
        }
      ]
    }
  ],
