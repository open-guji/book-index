  "description": {
    "sources": [
      {
        "name": "《晉書》卷十四〈地理志上〉",
        "details": "趙國「平鄉。」"
      },
      {
        "name": "《漢書》卷二十八下〈地理志下〉",
        "details": "廣平國「平鄉。」"
      },
      {
        "name": "《隋書》卷三十〈地理志中〉",
        "details": "襄國郡「平鄉。」"
      },
      {
        "name": "《新唐書》卷三十九〈地理志三〉",
        "details": "邢州「平鄉，上。武德元年置封州，四年州廢，來屬。」"
      },
      {
        "name": "《後漢書》志第二十〈郡國二〉",
        "details": "鉅鹿郡「平鄉。」"
      },
      {
        "name": "《明史》卷四十〈地理志一〉",
        "details": "順德府「平鄉府東少南。西南有漳河，西有沙河，又有洺河。東有滏陽河。萬曆三十年，漳挾滏陽河北出，會於沙、洺名諸河，而漳水之舊流益亂。」"
      },
      {
        "name": "《清史稿》卷五十四〈地理志一〉",
        "details": "順德府「平鄉疲，難。府東八十里。東：滏陽河自雞澤入。西：劉壘河自南和入。縣驛一。」"
      },
      {
        "name": "《元史》卷五十八〈地理志一〉",
        "details": "順德路「平鄉，（中。）。」"
      },
      {
        "name": "《金史》卷二十五〈地理志中〉",
        "details": "邢州「平鄉　鎮一道武。」"
      },
      {
        "name": "《宋史》卷八十六〈地理志二〉",
        "details": "信德府「平鄉，上。熙寧六年，省平鄉縣為鎮入鉅鹿。元祐元年復。」"
      }
    ]
  },
