  "indexed_by": [
    {
      "source": "欽定四庫全書總目",
      "source_bid": "d59dh3vo9af4",
      "title_info": "《鶴林玉露》·十六卷",
      "summary": "宋羅大經撰。大經，字景綸，廬陵人。事跡無考。惟所記「竹谷老人畏説」一條，有「同年歐陽景顏」語，知嘗登第。又「髙登忤秦檜」一條，有「爲容州法曹掾」語，知嘗官嶺南耳。其書體例在詩話、語録之間，詳於議論而略於考證。所引多朱子、張栻、眞德秀、魏了翁、楊萬里語，而又兼推陸九淵。極稱歐陽修、蘇軾之文，而又謂司馬光《資治通鑑》且爲虚費精力，何況呂祖謙《文鑒》。既引張栻之説謂詞科不可習，又引眞德秀之説謂詞科當習。大抵本文章之士而兼慕道學之名，故毎持兩端，不能歸一。然要其大旨，固不謬於聖賢也。陳耀文《學林就正》譏其載馮京《偸狗賦》，乃捃摭滕元發事，偽託於京，今檢《侯鯖録》所載滕賦，信然。蓋是書多因事抒論，不甚以記事爲主，偶據傳聞，不復考核，其疎漏固不足異耳。",
      "edition": "兩江總督采進本"
    }
  ],
